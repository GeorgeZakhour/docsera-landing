---
import qrcode from 'qrcode-generator';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { APK_URL, WEB_APP_URL } from '../config/links';

// The desktop QR is drawn at build time, so it needs no script in the
// browser. It points back at this page: the phone that scans it then shows
// its own store badge. `s=qr_site` tags those visits apart from the rest.
const qr = qrcode(0, 'M');
qr.addData('https://docsera.app/download?s=qr_site');
qr.make();
const qrSvg = qr.createSvgTag({ scalable: true, margin: 0 });
---

<Layout
	title="حمّل دوكسيرا — App Store و Google Play"
	description="حمّل تطبيق دوكسيرا مجاناً من App Store أو Google Play، أو استخدمه من المتصفح دون تثبيت. مواعيد، مراسلات، وملف طبي في مكان واحد."
	path="/download"
	appBar={false}
>
	<Navbar />
	<main class="dl-page">
		<section class="dl-hero">
			<div class="container">
				<div class="dl-head">
					<h1 class="dl-title">حمّل دوكسيرا</h1>
					<p class="dl-sub">مجاناً على آيفون وأندرويد.</p>
				</div>

				<div class="dl-dock" data-dl-dock>
					<div class="dl-dock-stores">
						<StoreBadges size="lg" />
					</div>
					<div class="dl-dock-qr" aria-hidden="true">
						<div class="dl-qr" set:html={qrSvg} />
						<p>أو وجّه كاميرا هاتفك<br />إلى الرمز</p>
					</div>
				</div>
			</div>
		</section>

		<section class="dl-alt">
			<div class="container">
				<h2 class="dl-h2">طرق أخرى</h2>

				<div class="dl-alt-list">
					<article class="dl-row">
						<div class="dl-row-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
						</div>
						<div class="dl-row-text">
							<h3>ملف التثبيت المباشر لأندرويد</h3>
							<p>لهواتف أندرويد التي لا يتوفر عليها Google&nbsp;Play.</p>
							<details class="dl-steps">
								<summary>طريقة التثبيت</summary>
								<ol>
									<li>اضغط «تحميل الملف» وانتظر اكتمال التنزيل.</li>
									<li>افتح الملف من شريط الإشعارات أو من مجلد التنزيلات.</li>
									<li>إذا طُلب منك، فعّل «السماح بالتثبيت من هذا المصدر».</li>
									<li>اضغط «تثبيت»، ثم افتح دوكسيرا.</li>
								</ol>
							</details>
						</div>
						<a href={APK_URL} class="dl-row-btn" download data-apk-link>تحميل الملف</a>
					</article>

					<article class="dl-row">
						<div class="dl-row-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
						</div>
						<div class="dl-row-text">
							<h3>تطبيق الويب</h3>
							<p>يعمل من المتصفح على أي جهاز، دون تثبيت.</p>
						</div>
						<a href={WEB_APP_URL} class="dl-row-btn">افتح تطبيق الويب</a>
					</article>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	import { attributionSource, fireBeacon, trackStoreTaps } from '../scripts/reach';

	const source = attributionSource();
	fireBeacon('download_page_viewed', 'acquisition', 'ds_beacon_download', { source });
	trackStoreTaps(document, 'download');

	document.querySelector('[data-apk-link]')?.addEventListener('click', () => {
		fireBeacon('store_link_clicked', 'acquisition', null, {
			store: 'apk', surface: 'download', source,
		});
	});
</script>

<style>
	.dl-page { overflow-x: hidden; }

	.dl-hero {
		padding: 150px 0 70px;
		background: radial-gradient(circle at 50% 0%, #F0FDFD 0%, #FAFAFA 60%);
		text-align: center;
	}
	.dl-title {
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		font-weight: 900;
		line-height: 1.15;
		color: var(--c-text);
		letter-spacing: -0.5px;
		margin-bottom: 12px;
	}
	.dl-sub {
		color: var(--c-text-muted);
		font-size: 1.2rem;
		margin: 0;
	}

	/* The dock: one calm white plate holding the two store badges, with a
	   scannable code beside them on screens that are not a phone. */
	.dl-dock {
		display: inline-flex;
		align-items: center;
		gap: 44px;
		margin-top: 44px;
		padding: 36px 44px;
		background: #fff;
		border-radius: 28px;
		border: 1px solid rgba(0, 144, 146, 0.10);
		box-shadow: 0 30px 70px -30px rgba(0, 116, 116, 0.28);
	}
	.dl-dock-qr {
		display: flex;
		align-items: center;
		gap: 18px;
		padding-inline-start: 44px;
		border-inline-start: 1px solid rgba(0, 0, 0, 0.08);
		text-align: start;
	}
	.dl-qr {
		width: 108px; height: 108px;
		flex-shrink: 0;
	}
	.dl-qr :global(svg) { display: block; width: 100%; height: 100%; }
	.dl-dock-qr p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--c-text-muted);
		font-weight: 600;
	}

	/* A phone is the thing being pointed at — no code to scan there. The
	   store that matches the phone comes first. */
	:global(html[data-os='ios']) .dl-dock-qr,
	:global(html[data-os='android']) .dl-dock-qr { display: none; }
	:global(html[data-os='android']) .dl-dock :global([data-store='android']) { order: -1; }

	/* Other ways */
	.dl-alt { padding: 70px 0 100px; background: #fff; }
	.dl-h2 {
		text-align: center;
		font-size: clamp(1.4rem, 3vw, 1.8rem);
		font-weight: 800;
		color: var(--c-text);
		margin-bottom: 32px;
	}
	.dl-alt-list {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.dl-row {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 20px;
		padding: 24px 26px;
		background: #F9FBFB;
		border: 1px solid rgba(0, 144, 146, 0.10);
		border-radius: 20px;
	}
	.dl-row-icon {
		width: 52px; height: 52px;
		border-radius: 14px;
		background: rgba(0, 144, 146, 0.10);
		color: var(--c-main);
		display: grid;
		place-items: center;
		align-self: start;
	}
	.dl-row-icon svg { width: 26px; height: 26px; }
	.dl-row-text h3 { font-size: 1.15rem; font-weight: 800; color: var(--c-text); margin-bottom: 4px; }
	.dl-row-text p { margin: 0; font-size: 0.98rem; line-height: 1.6; color: var(--c-text-muted); }
	.dl-row-btn {
		background: #fff;
		color: var(--c-main);
		border: 1.5px solid var(--c-main);
		font-weight: 700;
		font-size: 0.98rem;
		text-decoration: none;
		padding: 11px 22px;
		border-radius: 100px;
		white-space: nowrap;
		transition: background 0.2s, color 0.2s;
	}
	.dl-row-btn:hover { background: var(--c-main); color: #fff; }
	.dl-row-btn:focus-visible { outline: 3px solid var(--c-main); outline-offset: 3px; }

	.dl-steps { margin-top: 10px; }
	.dl-steps summary {
		cursor: pointer;
		color: var(--c-main);
		font-weight: 700;
		font-size: 0.95rem;
		width: fit-content;
	}
	.dl-steps summary:focus-visible { outline: 3px solid var(--c-main); outline-offset: 3px; border-radius: 4px; }
	.dl-steps ol {
		margin: 12px 0 0;
		padding-inline-start: 22px;
		color: var(--c-text);
		font-size: 0.98rem;
		line-height: 1.9;
	}

	@media (max-width: 768px) {
		.dl-hero { padding: 120px 0 50px; }
		.dl-dock {
			display: flex;
			flex-direction: column;
			gap: 28px;
			margin-top: 34px;
			padding: 30px 22px;
		}
		.dl-dock-qr {
			padding-inline-start: 0;
			border-inline-start: 0;
			padding-top: 26px;
			border-top: 1px solid rgba(0, 0, 0, 0.08);
		}
		.dl-alt { padding: 50px 0 70px; }
		.dl-row {
			grid-template-columns: auto 1fr;
			padding: 22px 20px;
			gap: 16px;
		}
		.dl-row-btn {
			grid-column: 1 / -1;
			text-align: center;
			padding: 13px 22px;
		}
	}
</style>
