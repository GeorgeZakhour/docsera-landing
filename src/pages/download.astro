---
// /download — the page behind every ad (97% of its visitors in Nov 2026 came
// from Meta ads, in two themes: «الملف» and «روتيني»). The hero finishes the
// story the ad started: `?s=` containing "file" shows the medical-file story,
// "routine" the routine story, anything else the general one. One big store
// badge for the visitor's phone, the trust line, then the four features in
// the founder's order (الملف ← روتيني ← الحجز ← المشاركة مع الطبيب).
//
// Every phone screen is the real 1.1.0 app rendered with fake data
// (DocSera test/store_shots); nothing is redrawn. The papers, the
// notifications and the code card are drawn here, with the app's own strings
// (lib/l10n/app_ar.arb: routine_notif_*, routine_action_*, fileAccess*).
//
// Weight: the first view needs only this HTML, the CSS, Cairo and one screen
// (≈45 KB). The 3D mark (src/scripts/flower3d.ts) loads after the page, on
// capable devices only; reduced-motion visitors get a still page.
import qrcode from 'qrcode-generator';
import Layout from '../layouts/Layout.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { APK_URL, WEB_APP_URL } from '../config/links';

const qr = qrcode(0, 'M');
qr.addData('https://docsera.app/download?s=qr_site');
qr.make();
const qrSvg = qr.createSvgTag({ scalable: true, margin: 0 });

const TRUST = 'بياناتك الطبية محفوظة على خوادمنا داخل سوريا، ومشفّرة.';

const HERO = {
	file: {
		title: 'ملفك الطبي كله، على هاتفك',
		sub: 'تقاريرك وتحاليلك وصور الأشعة مرتّبة في مكان واحد، بدل كيس الأوراق.',
		screen: 'health',
	},
	routine: {
		title: 'روتيني يذكّرك بأدويتك',
		sub: 'تذكير في وقت كل جرعة حتى دون إنترنت، ولأدوية أهلك أيضاً.',
		screen: 'routine',
	},
	general: {
		title: 'صحتك كلها في تطبيق واحد',
		sub: 'احجز مواعيدك، ونظّم ملفك الطبي، وتذكّر أدويتك.',
		screen: 'home',
	},
} as const;

const PAPERS = [
	{ label: 'تحليل دم شامل', kind: 'lines' },
	{ label: 'صورة أشعة الصدر', kind: 'xray' },
	{ label: 'تقرير المتابعة', kind: 'lines' },
	{ label: 'وصفة', kind: 'rx' },
	{ label: 'بطاقة التأمين', kind: 'card' },
];

const FEATURES = [
	{ id: 'file', title: 'ملفك الطبي', text: 'تقاريرك ووثائقك وأدويتك وقياساتك في مكان واحد.', screen: 'health' },
	{ id: 'routine', title: 'روتيني', text: 'تذكير بكل جرعة، وسجلّ للضغط والسكر، ولأهلك أيضاً.', screen: 'routine' },
	{ id: 'booking', title: 'حجز سريع', text: 'أقرب المواعيد المتاحة أمامك، والحجز بلمسات.', screen: 'results' },
	{ id: 'share', title: 'برمز منك', text: 'لا يطّلع طبيب على ملفك إلا برمز تعطيه له، وتسحبه متى شئت.', screen: 'share' },
];

// «جدار الشاشات»: real 1.1.0 screens with fake data (DocSera test/goldens +
// test/store_shots, every doctor / partner name checked absent from prod). Five
// columns on a wide screen, three on a phone; each track is doubled so the loop
// has no seam. Loaded only when the visitor gets near the section.
const WALL = [
	['reports', 'vaccines', 'messages', 'booking'],
	['medications', 'offers', 'doctor', 'family'],
	['vitals', 'search', 'appointments', 'surgeries'],
	['allergies', 'notifications', 'wallet', 'relatives'],
	['documents', 'chronic', 'vouchers', 'confirmed'],
];

// Never a closed list: each row ends in «وأكثر».
const MORE = [
	['الأقارب', 'الرسائل', 'الوصفات', 'التحاليل', 'صور الأشعة', 'اللقاحات', 'الحساسيات', 'العمليات', 'الأمراض المزمنة', 'التاريخ العائلي', 'نمط الحياة'],
	['تذكير الفحوصات', 'أداة الشاشة الرئيسية', 'الأطباء المفضلون', 'تأجيل المواعيد', 'إضافة إلى التقويم', 'العروض والقسائم', 'النقاط والمكافآت', 'الدخول بالبصمة', 'الآيباد والويب', 'العربية والإنجليزية'],
];

const src = (name: string, w: 320 | 640) => `/images/app110/${name}-${w}.webp`;
---

<Layout
	title="حمّل دوكسيرا — App Store و Google Play"
	description="حمّل تطبيق دوكسيرا مجاناً: ملفك الطبي، وتذكير أدويتك، وحجز مواعيدك في تطبيق واحد."
	path="/download"
	appBar={false}
>
	<!-- Which story? Decided before the hero is painted, like data-os. The
	     ?theme= / ?os= overrides exist for previews and are ignored on the
	     live domain. -->
	<script is:inline>
		(function () {
			var d = document.documentElement, q = new URLSearchParams(location.search);
			var s = (q.get('s') || '').toLowerCase();
			var live = /(^|\.)docsera\.app$/.test(location.hostname);
			var t = s.indexOf('routine') >= 0 ? 'routine' : s.indexOf('file') >= 0 ? 'file' : 'general';
			if (!live && /^(file|routine|general)$/.test(q.get('theme') || '')) t = q.get('theme');
			d.setAttribute('data-theme', t);
			if (!live && /^(ios|android|desktop)$/.test(q.get('os') || '')) d.setAttribute('data-os', q.get('os'));
		})();
	</script>

	<header class="x-top">
		<a href="/" class="x-logo" aria-label="DocSera"><img src="/images/docsera_main.svg" alt="DocSera" width="132" height="21" /></a>
	</header>

	<main class="x">
		<section class="x-hero">
			<div class="x-wrap">
				<div class="x-copy">
					<span class="x-eyebrow">مجاناً على آيفون وأندرويد</span>
					{Object.entries(HERO).map(([k, h]) => (
						<div class="x-variant" data-for={k}>
							<h1 class="x-title">{h.title}</h1>
							<p class="x-sub">{h.sub}</p>
						</div>
					))}
					<div class="x-cta" data-hero-cta>
						<StoreBadges adaptive size="lg" align="start" centerOnMobile medium="download" />
						<div class="x-qr" aria-hidden="true">
							<div class="x-qr-code" set:html={qrSvg} />
							<p>وجّه كاميرا هاتفك<br />إلى الرمز</p>
						</div>
					</div>
					<p class="x-trust">
						<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2.6" fill="currentColor" /><path d="M8.2 10.5V8a3.8 3.8 0 0 1 7.6 0v2.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
						{TRUST}
					</p>
				</div>

				<div class="x-stage" data-stage>
					<div class="x-sky" aria-hidden="true"></div>
					<div class="x-gem" aria-hidden="true">
						<img class="x-mark" src="/images/DocSera-shape-main.svg" alt="" width="300" height="289" />
						<canvas class="x-flower" data-flower></canvas>
					</div>

					<div class="x-papers" aria-hidden="true">
						{PAPERS.map((p, i) => (
							<div class={`x-paper x-p${i} x-${p.kind}`}>
								<div class="x-paper-art"></div>
								<span>{p.label}</span>
							</div>
						))}
					</div>

					<div class="x-phone">
						<div class="x-screen">
							{Object.entries(HERO).map(([k, h]) => (
								<img class="x-variant x-shot" data-for={k} src={src(h.screen, 640)}
									srcset={`${src(h.screen, 320)} 320w, ${src(h.screen, 640)} 640w`}
									sizes="(max-width: 768px) 230px, 290px" alt="" loading="lazy" decoding="async" width="640" height="1387" />
							))}
						</div>
					</div>

					<div class="x-notes" aria-hidden="true">
						<div class="x-note" data-note="0">
							<div class="x-note-head"><img src="/apple-touch-icon.png" alt="" width="18" height="18" /><b>DocSera</b><i>8:00 ص</i></div>
							<p class="x-note-title">حان موعد <bdi>Metformin</bdi></p>
							<div class="x-note-actions"><span class="x-act x-act-main">أخذته ✓</span><span class="x-act">بعد 10 دقائق</span></div>
						</div>
						<div class="x-note" data-note="1">
							<div class="x-note-head"><img src="/apple-touch-icon.png" alt="" width="18" height="18" /><b>DocSera</b><i>2:00 م</i></div>
							<p class="x-note-title">حان موعد دواء سميرة</p>
							<div class="x-note-actions"><span class="x-act x-act-main">أخذها ✓</span><span class="x-act">بعد 10 دقائق</span></div>
						</div>
						<div class="x-note" data-note="2">
							<div class="x-note-head"><img src="/apple-touch-icon.png" alt="" width="18" height="18" /><b>DocSera</b><i>9:00 م</i></div>
							<p class="x-note-title">علبة <bdi>Omega 3</bdi> على وشك النفاد</p>
							<p class="x-note-body">بقي 5</p>
							<div class="x-note-actions"><span class="x-act x-act-main">عبّأتها</span><span class="x-act">ذكّرني غداً</span></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="x-feats">
			<div class="x-wrap-narrow">
				<header class="x-sec-head">
					<h2>كل ما يخص صحتك، في تطبيق واحد</h2>
					<span class="x-best">الأبرز</span>
				</header>
				<div class="x-grid">
					{FEATURES.map((f, i) => (
						<article class="x-feat" data-reveal style={`--i:${i}`}>
							<div class="x-feat-art">
								{f.id === 'share' ? (
									<div class="x-mini">
										<img src="/images/app110/share-390.webp" alt="" loading="lazy" decoding="async" width="390" height="844" />
										<div class="x-code" aria-hidden="true">
											<small>رمز الاطّلاع</small>
											<div class="x-code-digits"><span>4</span><span>8</span><span>2</span><span>7</span><span>1</span><span>5</span></div>
										</div>
									</div>
								) : (
									<div class="x-mini"><img src={src(f.screen, 320)} srcset={`${src(f.screen, 320)} 320w, ${src(f.screen, 640)} 640w`}
										sizes="150px" alt="" loading="lazy" decoding="async" width="320" height="694" /></div>
								)}
							</div>
							<h3>{f.title}</h3>
							<p>{f.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="x-wall" data-wall>
			<div class="x-wall-scene" aria-hidden="true">
				<div class="x-wall-tilt">
					{WALL.map((col, c) => (
						<div class="x-col" style={`--d:${64 + c * 9}s`}>
							<div class="x-track">
								{[...col, ...col].map((n) => (
									<div class="x-wall-shot"><img data-src={`/images/app110/wall/${n}.webp`} alt="" width="260" height="563" decoding="async" /></div>
								))}
							</div>
						</div>
					))}
				</div>
			</div>
			<button class="x-wall-toggle" type="button" data-wall-toggle aria-pressed="false" aria-label="إيقاف الحركة" title="إيقاف الحركة">
				<svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.3" fill="currentColor" /><rect x="13.5" y="5" width="4" height="14" rx="1.3" fill="currentColor" /></svg>
				<svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8a.8.8 0 0 0 1.2.7l10-6.4a.8.8 0 0 0 0-1.4l-10-6.4a.8.8 0 0 0-1.2.7z" fill="currentColor" /></svg>
			</button>
			<div class="x-wall-body">
				<h2>وهذا جزء مما ستجده داخل التطبيق</h2>
				<div class="x-strips">
					{MORE.map((row, r) => (
						<div class={`x-strip x-strip-${r}`}>
							<div class="x-strip-track">
								{[0, 1].map((copy) => (
									<ul class="x-chips" aria-hidden={copy === 1 ? 'true' : undefined}>
										{row.map((t) => <li>{t}</li>)}
										<li class="x-chip-more">وأكثر</li>
									</ul>
								))}
							</div>
						</div>
					))}
				</div>
				<div class="x-again">
					<StoreBadges adaptive size="lg" medium="download" />
					<p class="x-trust x-trust-c">{TRUST}</p>
				</div>
			</div>
		</section>

		<section class="x-more">
			<div class="x-wrap-narrow">
				<a class="x-row x-row-apk" href={APK_URL} download data-apk-link>
					<span class="x-row-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
					<span class="x-row-tx"><b>ملف التثبيت المباشر لأندرويد</b><small>لهواتف أندرويد التي لا يتوفر عليها Google&nbsp;Play.</small></span>
				</a>
				<a class="x-row" href={WEB_APP_URL}>
					<span class="x-row-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span>
					<span class="x-row-tx"><b>تطبيق الويب</b><small>يعمل من المتصفح على أي جهاز، دون تثبيت.</small></span>
				</a>
				<details class="x-steps">
					<summary>طريقة تثبيت ملف أندرويد</summary>
					<ol>
						<li>اضغط «ملف التثبيت المباشر» وانتظر اكتمال التنزيل.</li>
						<li>افتح الملف من شريط الإشعارات أو من مجلد التنزيلات.</li>
						<li>إذا طُلب منك، فعّل «السماح بالتثبيت من هذا المصدر».</li>
						<li>اضغط «تثبيت»، ثم افتح دوكسيرا.</li>
					</ol>
				</details>
			</div>
		</section>
	</main>

	<footer class="x-foot">
		<a href="/">DocSera</a><a href="/privacy-policy/">سياسة الخصوصية</a><a href="/terms-of-service/">شروط الاستخدام</a><a href="/help">المساعدة</a>
	</footer>

	<div class="x-sticky" data-sticky aria-hidden="true">
		<StoreBadges adaptive size="md" medium="download" />
	</div>
</Layout>

<script>
	import { attributionSource, fireBeacon } from '../scripts/reach';
	import { PLAY_PACKAGE } from '../config/links';

	const root = document.documentElement;
	const theme = root.getAttribute('data-theme') || 'general';
	const source = attributionSource();
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Inside Instagram / Facebook on Android, a play.google.com link can stay in
	// the in-app browser and show Play's web page. An intent: link opens the
	// Play app itself, with the same install referrer; Chrome-based in-app
	// browsers fall back to the web page when Play is missing.
	const ua = navigator.userAgent;
	const inApp = /Android/i.test(ua) && /Instagram|FBAN|FBAV|FB_IAB/.test(ua);
	if (inApp) {
		document.querySelectorAll<HTMLAnchorElement>('a[data-play-link]').forEach((a) => {
			const web = a.href;
			const ref = new URL(web).searchParams.get('referrer') || '';
			a.href = 'intent://details?id=' + PLAY_PACKAGE + (ref ? '&referrer=' + encodeURIComponent(ref) : '') +
				'#Intent;scheme=market;package=com.android.vending;S.browser_fallback_url=' + encodeURIComponent(web) + ';end';
			a.dataset.link = 'intent';
		});
	}

	fireBeacon('download_page_viewed', 'acquisition', 'ds_beacon_download', { source, theme });
	document.querySelectorAll<HTMLAnchorElement>('a[data-store]').forEach((a) => {
		a.addEventListener('click', () => {
			fireBeacon('store_link_clicked', 'acquisition', null, {
				store: a.dataset.store || '', surface: 'download', source, theme,
				link: a.dataset.link || 'web',
				place: a.closest('[data-sticky]') ? 'sticky' : a.closest('[data-hero-cta]') ? 'hero' : 'page',
			});
		});
	});
	document.querySelector('[data-apk-link]')?.addEventListener('click', () => {
		fireBeacon('store_link_clicked', 'acquisition', null, { store: 'apk', surface: 'download', source, theme });
	});

	// The story plays once the hero is on screen.
	const stage = document.querySelector<HTMLElement>('[data-stage]');
	if (stage) {
		if (reduce) {
			stage.classList.add('done', 'still');
		} else {
			requestAnimationFrame(() => stage.classList.add('play'));
			if (theme === 'routine') {
				let n = 0;
				const step = () => {
					stage.dataset.phase = String(n % 3);
					stage.classList.remove('tap');
					setTimeout(() => stage.classList.add('tap'), 1500);
					n++;
				};
				setTimeout(() => { step(); setInterval(step, 3400); }, 700);
			}
		}
	}

	// The 3D mark: after load, on devices that can afford it.
	const canvas = document.querySelector<HTMLCanvasElement>('[data-flower]');
	const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
	const strong = (navigator.hardwareConcurrency || 2) >= 4 && !(conn && conn.saveData);
	if (canvas && !reduce && strong) {
		const start = () => import('../scripts/flower3d').then((m) => {
			if (m.mountFlower(canvas, () => canvas.classList.remove('on'))) canvas.classList.add('on');
		}).catch(() => {});
		const idle = (cb: () => void) => ('requestIdleCallback' in window
			? (window as Window & { requestIdleCallback: (f: () => void) => void }).requestIdleCallback(cb)
			: setTimeout(cb, 300));
		const later = () => setTimeout(() => idle(start), 2600);
		if (document.readyState === 'complete') later();
		else addEventListener('load', later, { once: true });
	}

	// Features fade in as they arrive; the sticky badge appears once the hero's
	// badge has scrolled away.
	const io = new IntersectionObserver((es) => es.forEach((e) => {
		if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
	}), { rootMargin: '0px 0px -8% 0px' });
	document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

	// The wall: images load when the visitor is near; it moves only on screen.
	const wall = document.querySelector<HTMLElement>('[data-wall]');
	if (wall) {
		const load = () => wall.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
			if (!img.offsetParent) return; // a column hidden at this width
			img.addEventListener('load', () => img.classList.add('in'), { once: true });
			// Wide screens show each shot larger: the 390 px file, unless on Data Saver.
			const big = innerWidth >= 769 && !(conn && conn.saveData);
			img.src = (img.dataset.src || '').replace(/\.webp$/, big ? '-390.webp' : '.webp');
			img.removeAttribute('data-src');
		});
		let near = false;
		new IntersectionObserver((es) => {
			if (es[0].isIntersecting && !near) { near = true; load(); }
		}, { rootMargin: '500px 0px' }).observe(wall);
		addEventListener('resize', () => { if (near) load(); }, { passive: true });

		new IntersectionObserver((es) => {
			wall.classList.toggle('run', es[0].isIntersecting);
			if (es[0].isIntersecting) fireBeacon('download_wall_seen', 'acquisition', 'ds_beacon_wall', { source, theme });
		}, { threshold: 0.15 }).observe(wall);

		const toggle = wall.querySelector<HTMLButtonElement>('[data-wall-toggle]');
		toggle?.addEventListener('click', () => {
			const paused = wall.classList.toggle('paused');
			const label = paused ? 'تشغيل الحركة' : 'إيقاف الحركة';
			toggle.setAttribute('aria-pressed', String(paused));
			toggle.setAttribute('aria-label', label);
			toggle.title = label;
		});
	}

	const sticky = document.querySelector<HTMLElement>('[data-sticky]');
	const heroCta = document.querySelector('[data-hero-cta]');
	const again = document.querySelector('.x-again');
	if (sticky && heroCta) {
		let pastHero = false, atAgain = false;
		const sync = () => {
			const show = pastHero && !atAgain;
			sticky.classList.toggle('on', show);
			sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
		};
		new IntersectionObserver((es) => { pastHero = !es[0].isIntersecting && es[0].boundingClientRect.top < 0; sync(); }).observe(heroCta);
		if (again) new IntersectionObserver((es) => { atAgain = es[0].isIntersecting; sync(); }).observe(again);
	}
</script>

<style>
	:global(body) { background: #F7FBFB; }
	.x { overflow-x: hidden; }

	/* ── top ─────────────────────────────────────────── */
	.x-top { position: absolute; top: 0; left: 0; right: 0; z-index: 5; display: flex; justify-content: center; padding: 22px 20px; }
	.x-logo img { display: block; height: 22px; width: auto; }

	/* ── hero ────────────────────────────────────────── */
	.x-hero { position: relative; padding: 96px 0 40px;
		background: radial-gradient(120% 70% at 50% 0%, #E3F4F4 0%, #F7FBFB 62%); }
