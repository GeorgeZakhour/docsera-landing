---
// The DocSera Pro page, for doctors, specialists and medical centres: everything the app
// does, in real screens, with two ways in: apply, or live a day in a clinic (/pro/day).
// Every sentence comes from src/data/proSite.ts; read its header before changing one.
import Layout from '../../layouts/Layout.astro';
import ProBackdrop from '../../components/pro/ProBackdrop.astro';
import ProHeader from '../../components/pro/ProHeader.astro';
import ProExplorer from '../../components/pro/ProExplorer.astro';
import ProFooter from '../../components/pro/ProFooter.astro';
import SHOTS from '../../data/proShots.json';
import { PRO_CENTER, PRO_GROUPS, PRO_ROLES, PRO_TRUST } from '../../data/proSite';
import { proWhatsAppUrl } from '../../config/links';
import { WHATSAPP_TEXT } from '../../config/pro-join';

const WA = proWhatsAppUrl(WHATSAPP_TEXT);
const groups = PRO_GROUPS.filter((g) => g.items.some((i) => (SHOTS as any)[i.shot]));
const crop = (key: string, rect?: number[]) => {
	const s = (SHOTS as any)[key];
	const [x, y, w, h] = rect || s.rect;
	return { box: `aspect-ratio:${w} / ${h}`, img: `width:${(s.w / w * 100).toFixed(3)}%;left:${(-x / w * 100).toFixed(3)}%;top:${(-y / h * 100).toFixed(3)}%`, src: `/images/pro/site/${key}.webp` };
};
const WAITING = crop('dash');
const PEAK = crop('an-appts');
const APPT = crop('calendar');
const play = '<path d="M8 5.500v13l10.500-6.500z"/>';
---

<Layout title="DocSera Pro — عيادتك كلها في مكان واحد" description="DocSera Pro لإدارة العيادات والمراكز الطبية: المواعيد، ملفات المرضى، التقارير، المحاسبة، الفريق، وأكثر. للأطباء والمختصين والمراكز. جرّبه مجاناً." appBanner="none" appBar={false}>
	<ProBackdrop />
	<ProHeader />

	<main class="pp">
		<section class="hh">
			<div class="hh-in">
				<div class="hh-tx">
					<p class="offer">عرض الإطلاق · لأول ١٠٠ طبيب ومختص</p>
					<h1>عيادتك كلها،<br />في مكان واحد</h1>
					<p class="sub">من الموعد إلى الملف والتقرير والفاتورة، للأطباء والمختصين والمراكز الطبية.</p>
					<div class="acts">
						<a class="btn" href="/pro/join">ابدأ تجربتك المجانية</a>
						<a class="btn2" href="/pro/day"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={play} />عِش يوماً في عيادتك</a>
					</div>
					<p class="micro">تجربة مجانية، دون دفع مسبق</p>
				</div>
				<div class="hv" data-hv aria-hidden="true">
					<div class="hw">
						<div class="bar"><i></i><i></i><i></i></div>
						<img class="hs" src="/images/pro/site/dash.webp" alt="" width="1728" height="1080" fetchpriority="high" decoding="async" />
					</div>
					<div class="fl fl-a" style={WAITING.box}><img src={WAITING.src} style={WAITING.img} alt="" decoding="async" /></div>
					<div class="fl fl-b" style={PEAK.box}><img data-src={PEAK.src} style={PEAK.img} alt="" decoding="async" /></div>
					<div class="fl fl-c" style={APPT.box}><img data-src={APPT.src} style={APPT.img} alt="" decoding="async" /></div>
				</div>
			</div>
		</section>

		<div class="below">
		<div class="scope">
		<nav class="jump" data-jump aria-label="أقسام الميزات">
			{groups.map((g) => <a href={`#${g.id}`}>{g.nav}</a>)}
			<a href="#centers" class="j-c">{PRO_CENTER.nav}</a>
		</nav>

		<div id="features">
			{groups.map((g, i) => <ProExplorer group={g} flip={i % 2 === 1} />)}
		</div>

		<div class="more-line"><p>وهذا جزء مما يفعله DocSera Pro، والمزيد داخل التطبيق.</p></div>

		<section class="cc" id="centers" data-spy="centers">
			<div class="cc-mark">
				<p class="cc-k">للمراكز الطبية</p>
			</div>
			<ProExplorer group={PRO_CENTER} />
			<div class="roles">
				<h3>لكل شخص في المركز مكانه</h3>
				<div class="roles-g">
					{PRO_ROLES.map((r) => <article><h4>{r.title}</h4><p>{r.text}</p></article>)}
				</div>
			</div>
		</section>
		</div>

		<section class="tt">
			<h2>مبني لواقع عيادتك</h2>
			<div class="tt-g">
				{PRO_TRUST.map((t) => <article><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /></i><h3>{t.title}</h3><p>{t.text}</p></article>)}
			</div>
		</section>

		<section class="sim">
			<a href="/pro/day">
				<span class="sim-t">8:30 ص <em></em> 9:00 م</span>
				<h2>عِش يوماً في عيادتك</h2>
				<p>من أول موعد في الصباح حتى إغلاق الحاسوب، خطوة بخطوة داخل التطبيق.</p>
				<span class="sim-go"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={play} />ابدأ المحاكاة</span>
			</a>
		</section>

		<section class="go">
			<h2>جاهز لتجربته؟</h2>
			<p>املأ طلباً قصيراً ونتواصل معك لتفعيل تجربتك المجانية.</p>
			<div class="acts">
				<a class="btn" href="/pro/join">ابدأ تجربتك المجانية</a>
				<a class="lnk" href={WA} target="_blank" rel="noopener">تواصل معنا على واتساب</a>
			</div>
		</section>
		</div>
	</main>

	<ProFooter />
</Layout>

<script>
	import { startProPage } from '../../scripts/site/pro-page';
	startProPage();
</script>

<style>
	:global(html) { background: #0A1218; }
	:global(body) { background: transparent; }
	.pp { position: relative; z-index: 1; overflow-x: clip; color: #EDF4F5; }

	.btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 26px; color: #04181C; font-size: 1.08rem; font-weight: 800; text-decoration: none; background: linear-gradient(180deg, #7DD3D4, #00B5B7); border-radius: 15px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35), 0 16px 30px -14px rgba(0, 181, 183, .62); transition: transform .2s ease, box-shadow .2s ease; }
	.btn:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .4), 0 20px 34px -14px rgba(0, 181, 183, .75); }
	.btn2 { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 22px; color: #E8F5F5; font-size: 1.04rem; font-weight: 800; text-decoration: none; background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .22); border-radius: 15px; transition: background .2s ease, border-color .2s ease; }
	.btn2:hover { background: rgba(255, 255, 255, .13); border-color: rgba(125, 211, 212, .6); }
	.btn2 svg { width: 19px; height: 19px; fill: #7DD3D4; }
	.btn:focus-visible, .btn2:focus-visible, .lnk:focus-visible, .jump a:focus-visible, .sim a:focus-visible { outline: 3px solid #7DD3D4; outline-offset: 3px; }
	.lnk { font-size: 1rem; font-weight: 700; color: #C9D8DB; text-underline-offset: 5px; }
	.lnk:hover { color: #fff; }
	.acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }

	/* ── first view ── */
	.hh { position: relative; display: flex; align-items: center; min-height: 100vh; min-height: 100svh; box-sizing: border-box; padding: 96px 20px 48px; }
	.hh-in { display: grid; grid-template-columns: minmax(0, 510px) minmax(0, 1fr); align-items: center; gap: clamp(30px, 5vw, 76px); width: min(1400px, 100%); margin: 0 auto; }
	.offer { display: inline-block; margin: 0 0 16px; padding: 6px 14px; font-size: .94rem; font-weight: 800; color: #FFD9C4; background: rgba(255, 180, 148, .11); border: 1px solid rgba(255, 180, 148, .34); border-radius: 999px; }
	.hh h1 { margin: 0 0 14px; font-size: clamp(2.5rem, 4.15vw, 4.5rem); font-weight: 900; line-height: 1.17; color: #fff; }
	.sub { margin: 0 0 24px; font-size: clamp(1.08rem, 1.45vw, 1.28rem); line-height: 1.8; color: #C5D5D8; }
	.micro { margin: 14px 0 0; font-size: .92rem; font-weight: 600; color: #93A9AE; }
	.hv { --mx: 0; --my: 0; position: relative; perspective: 1800px; transform-style: preserve-3d; animation: hv-in 1.1s cubic-bezier(.16, .8, .24, 1) both; }
	@keyframes hv-in { from { opacity: 0; transform: translateY(34px) scale(.97); } to { opacity: 1; transform: none; } }
	.hw { overflow: hidden; background: #0F1A21; border: 1px solid rgba(255, 255, 255, .14); border-radius: 16px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .1), 0 50px 90px -40px #000, 0 0 110px -46px rgba(0, 181, 183, .75); transform: rotateY(calc(9deg + var(--mx) * 3deg)) rotateX(calc(3deg - var(--my) * 2deg)); }
	.bar { display: flex; gap: 6px; padding: 10px 14px; direction: ltr; }
	.bar i { width: 9px; height: 9px; background: rgba(255, 255, 255, .17); border-radius: 50%; }
	.hs { display: block; width: 100%; height: auto; }
	.fl { position: absolute; overflow: hidden; background: #16232B; border-radius: 14px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .17), 0 28px 44px -14px rgba(0, 0, 0, .92); }
	.fl img { position: absolute; max-width: none; height: auto; }
	.fl-a { left: 1.5%; top: 9%; width: 26%; transform: translate(calc(var(--mx) * -12px), calc(var(--my) * -9px)); animation: fl-in .8s cubic-bezier(.2, .8, .2, 1) .5s both; }
	.fl-b { right: -2%; bottom: -5%; width: 37%; transform: translate(calc(var(--mx) * 15px), calc(var(--my) * 11px)); animation: fl-in .8s cubic-bezier(.2, .8, .2, 1) .68s both; }
	.fl-c { right: 3%; top: -5%; width: 17%; transform: translate(calc(var(--mx) * 9px), calc(var(--my) * -13px)); animation: fl-in .8s cubic-bezier(.2, .8, .2, 1) .84s both; }
	@keyframes fl-in { from { opacity: 0; translate: 0 18px; scale: .94; } to { opacity: 1; translate: 0 0; scale: 1; } }

	/* below the first view the desk dims, so nothing competes with the text */
	.below { position: relative; background: linear-gradient(180deg, rgba(10, 18, 24, 0), rgba(10, 18, 24, .9) 150px); }

	/* ── jump between families ── */
	.jump { position: sticky; z-index: 30; top: 74px; display: flex; gap: 4px; width: fit-content; max-width: calc(100% - 20px); margin: 0 auto; padding: 5px; overflow-x: auto; background: rgba(16, 27, 34, .82); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border: 1px solid rgba(255, 255, 255, .1); border-radius: 15px; scrollbar-width: none; }
	.jump::-webkit-scrollbar { display: none; }
	.jump a { flex: none; padding: 6px 14px; color: #B7C8CB; font-size: .94rem; font-weight: 700; text-decoration: none; border-radius: 11px; transition: color .2s ease, background .2s ease; }
	.jump a:hover { color: #fff; }
	.jump a:global(.on) { color: #04181C; background: #7DD3D4; }
	.jump .j-c { color: #FFD9C4; }

	.more-line { padding: 4px 20px 42px; text-align: center; }
	.more-line p { margin: 0; font-size: 1.08rem; font-weight: 700; color: #9FB4B8; }

	/* ── centres: their own room ── */
	.cc { position: relative; padding: clamp(46px, 6vw, 80px) 0 clamp(46px, 6vw, 84px); scroll-margin-top: 112px; background: linear-gradient(180deg, rgba(0, 181, 183, .13), rgba(0, 181, 183, .035) 34%, rgba(0, 181, 183, .08)); border-block: 1px solid rgba(125, 211, 212, .2); }
	.cc-mark { padding: 0 20px; text-align: center; }
	.cc-k { display: inline-block; margin: 0; padding: 7px 18px; color: #04181C; font-size: 1.02rem; font-weight: 800; background: #7DD3D4; border-radius: 999px; }
	.cc :global(.fx) { padding-top: 26px; padding-bottom: 34px; }
	.roles { width: min(1320px, calc(100% - 40px)); margin: 0 auto; }
	.roles h3 { margin: 0 0 14px; font-size: clamp(1.4rem, 2.2vw, 1.9rem); font-weight: 800; color: #fff; }
	.roles-g { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
	.roles article { padding: 18px; background: rgba(15, 26, 33, .78); border: 1px solid rgba(255, 255, 255, .12); border-radius: 16px; }
	.roles h4 { margin: 0 0 6px; font-size: 1.1rem; font-weight: 800; color: #7DD3D4; }
	.roles p { margin: 0; font-size: .98rem; line-height: 1.75; color: #D3E0E2; }

	/* ── trust ── */
	.tt { width: min(1320px, calc(100% - 40px)); margin: 0 auto; padding: clamp(52px, 7vw, 92px) 0 clamp(36px, 5vw, 60px); }
	.tt h2 { margin: 0 0 22px; font-size: clamp(1.95rem, 3.2vw, 3rem); font-weight: 800; color: #fff; }
	.tt-g { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
	.tt article { padding: 20px; background: linear-gradient(165deg, #182630, #111C23); border: 1px solid rgba(255, 255, 255, .1); border-radius: 16px; }
	.tt i { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 12px; color: #7DD3D4; background: rgba(0, 181, 183, .14); border-radius: 12px; }
	.tt svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
	.tt h3 { margin: 0 0 5px; font-size: 1.14rem; font-weight: 800; color: #fff; }
	.tt p { margin: 0; font-size: .98rem; line-height: 1.75; color: #BBCBCE; }

	/* ── the simulation ── */
	.sim { width: min(1320px, calc(100% - 40px)); margin: 0 auto; padding: 22px 0; }
	.sim a { position: relative; display: block; overflow: hidden; padding: clamp(36px, 6vw, 72px) clamp(22px, 5vw, 64px); color: #fff; text-decoration: none; background: radial-gradient(70% 120% at 12% 118%, rgba(255, 156, 100, .34), transparent 62%), radial-gradient(70% 120% at 92% -20%, rgba(125, 211, 212, .32), transparent 62%), #101C24; border: 1px solid rgba(255, 255, 255, .14); border-radius: 24px; transition: border-color .25s ease; }
	.sim a:hover { border-color: rgba(125, 211, 212, .55); }
	.sim-t { display: inline-flex; align-items: center; gap: 10px; font-family: Montserrat, Cairo, sans-serif; font-size: 1rem; font-weight: 700; color: #FFE2B8; }
	.sim-t em { width: 72px; height: 1px; background: linear-gradient(90deg, #FFE2B8, #7DD3D4); }
	.sim h2 { margin: 8px 0 6px; font-size: clamp(2rem, 4.2vw, 3.7rem); font-weight: 900; line-height: 1.2; color: #fff; }
	.sim p { max-width: 34em; margin: 0 0 20px; font-size: 1.08rem; line-height: 1.75; color: #D3E0E2; }
	.sim-go { display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; color: #04181C; font-size: 1.04rem; font-weight: 800; background: linear-gradient(180deg, #7DD3D4, #00B5B7); border-radius: 14px; }
	.sim-go svg { width: 18px; height: 18px; fill: currentColor; }

	.go { padding: clamp(50px, 7vw, 92px) 20px clamp(58px, 7vw, 96px); text-align: center; }
	.go h2 { margin: 0 0 6px; font-size: clamp(2rem, 3.8vw, 3.2rem); font-weight: 900; color: #fff; }
	.go p { margin: 0 0 22px; font-size: 1.1rem; line-height: 1.75; color: #C5D5D8; }
	.go .acts { justify-content: center; }

	@media (max-width: 1080px) {
		.roles-g, .tt-g { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 899px) {
		.hh { display: block; min-height: 0; padding: 88px 16px 44px; }
		.hh-in { grid-template-columns: minmax(0, 1fr); gap: 34px; }
		.hh h1 { font-size: 2.75rem; }
		.acts { flex-direction: column; align-items: stretch; }
		.btn, .btn2 { width: 100%; box-sizing: border-box; }
		.go .acts .lnk { text-align: center; }
		.hw { transform: none; }
		.fl-a { left: -1%; top: auto; bottom: -13%; width: 40%; }
		.fl-b { right: -1%; bottom: -11%; width: 54%; }
		.fl-c { display: none; }
		.hv { margin-bottom: 34px; }
		.jump { top: 72px; }
		.roles, .tt, .sim { width: calc(100% - 32px); }
	}
	@media (max-width: 540px) {
		.roles-g, .tt-g { grid-template-columns: minmax(0, 1fr); }
	}
	@media (prefers-reduced-motion: reduce) {
		.hv, .fl { animation: none; }
		.btn, .btn2, .jump a, .sim a { transition: none; }
	}
</style>
