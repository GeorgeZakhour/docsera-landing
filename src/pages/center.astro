---
// Medical-centre landing page, rendered for every /center/<id> URL: what a patient sees
// after scanning the centre's QR. The card is the app's own centre header (cover band with
// the «+» pattern, the logo riding on its edge, the team's faces) made into a physical
// object on the home page's silk. The motion and the sections it shares with the doctor
// page live in scripts/site/profile-card.ts.
//
// Routing: builds to dist/center/index.html. nginx serves this single file for any
// /center/<anything> URL via try_files fallback (see nginx/default.conf).
//
// The CTA (install / open in app / web app) is wired from the URL alone and works at once;
// it does not wait for the profile. Centres are addressed by their UUID (no public_token).
//
// A team member is deliberately NOT a link to /doctor/<token>: that page counts a QR scan
// and carries referral attribution, and browsing must never do either.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import EntityCta from '../components/EntityCta.astro';
import SiteHeader from '../components/site/SiteHeader.astro';

const silk = '/images/home/3d/silk-860.webp 860w, /images/home/3d/silk-1600.webp 1600w';
const I = {
	qr: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.4"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.4"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.4"/><path d="M14 14h2.500v2.500M20 14v.01M14 20h.01M17.500 20H20v-3"/>',
	clock: '<circle cx="12" cy="12" r="8.500"/><path d="M12 7.500V12l3 2"/>',
	pin: '<path d="M12 21s7-5.600 7-11.200A7 7 0 0 0 5 9.800C5 15.400 12 21 12 21z"/><circle cx="12" cy="9.800" r="2.500"/>',
	plus: '<rect x="4" y="7" width="16" height="13" rx="3"/><path d="M9 7V5.500A1.500 1.500 0 0 1 10.500 4h3A1.500 1.500 0 0 1 15 5.500V7M12 10.800v5.400M9.300 13.500h5.400"/>',
	info: '<circle cx="12" cy="12" r="8.500"/><path d="M12 11v5M12 8v.01"/>',
	team: '<circle cx="9" cy="8.500" r="3.200"/><path d="M3.500 19.500c.6-3.500 2.700-5.300 5.500-5.300s4.900 1.800 5.500 5.300M15.500 5.600a3.200 3.200 0 0 1 0 5.800M17 14.600c1.900.6 3.100 2.200 3.500 4.900"/>',
	dept: '<rect x="4" y="4" width="6.500" height="6.500" rx="1.800"/><rect x="13.500" y="4" width="6.500" height="6.500" rx="1.800"/><rect x="4" y="13.500" width="6.500" height="6.500" rx="1.800"/><path d="M16.750 13.800v5.900M13.800 16.750h5.900"/>',
	globe: '<circle cx="12" cy="12" r="8.500"/><path d="M3.500 12h17M12 3.500c2.400 2.400 3.600 5.200 3.600 8.500s-1.200 6.100-3.600 8.500c-2.400-2.400-3.600-5.200-3.600-8.500S9.600 5.900 12 3.500z"/>',
	shield: '<path d="M12 3.500 5 6v5.500c0 4.400 2.900 7.500 7 9 4.100-1.500 7-4.600 7-9V6z"/><path d="m9 12 2.200 2.200L15.200 10"/>',
	build: '<path d="M4 20.500h16M6 20.500V5.500A1.500 1.500 0 0 1 7.500 4h9A1.500 1.500 0 0 1 18 5.500v15M12 7.500v4M10 9.500h4M10 20.500v-4h4v4"/>',
	go: '<path d="m4 11 16-7-7 16-2.200-6.800z"/>',
	cal: '<rect x="4" y="5" width="16" height="15" rx="3"/><path d="M4 10h16M9 3v4M15 3v4"/>',
};
---

<Layout title="DocSera — ملف المركز" appBanner="entity" appBar={false}>
	<SiteHeader />

	<main class="dp">
		<div class="state state-loading" data-state="loading">
			<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<p>جارٍ تحميل بيانات المركز…</p>
		</div>

		<div class="state" data-state="center" hidden>
			<section class="st" data-stage>
				<div class="st-bg" aria-hidden="true"><img class="silk" src="/images/home/3d/silk-860.webp" srcset={silk} sizes="max(100vw, 160vh)" alt="" width="1600" height="1000" fetchpriority="high" decoding="async" /></div>
				<div class="st-in">
					<div class="hx">
						<h1><span data-hx-lead>تعرّف على</span><br /><b data-hx-name>المركز</b></h1>
						<p data-hx-sub></p>
						<div class="hx-cta">
							<button type="button" class="btn" data-book-open><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.cal} /><span data-book-label>افتح في التطبيق</span></button>
							<a class="hx-web" data-hx-web href="#" rel="noopener">أو افتحه من المتصفح</a>
						</div>
					</div>

					<div class="cd-wrap" data-cd-wrap>
						<div class="cd is-loading" data-cd data-center-card>
							<i class="sl" style="--z:-7"></i><i class="sl" style="--z:-5"></i><i class="sl" style="--z:-3"></i><i class="sl" style="--z:-1"></i>
							<div class="cd-front" data-cd-front>
								<i class="cd-face" aria-hidden="true"></i>
								<div class="cv" aria-hidden="true"><b></b></div>
								<div class="cd-top">
									<img src="/images/docsera_main.svg" alt="DocSera" width="101" height="16" />
									<button type="button" data-cd-flip aria-label="رمز QR للمركز" title="رمز QR للمركز"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.qr} /></button>
								</div>
								<div class="cd-pills" data-center-specs hidden></div>
								<div class="cd-id">
									<div class="cd-head">
										<div class="cd-logo"><img data-center-image alt="" /></div>
										<span class="cd-type" data-center-type></span>
									</div>
									<h2 class="cd-name" data-center-name></h2>
									<p class="cd-place" data-center-card-place hidden><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.pin} /><span data-center-card-place-t></span></p>
									<p class="cd-offline" data-center-offline hidden>
										تعذّر تحميل بيانات المركز. تحقق من اتصالك بالإنترنت.
										<button type="button" data-center-retry>إعادة المحاولة</button>
									</p>
								</div>
								<div class="cd-team" data-center-faces hidden>
									<span class="faces" data-faces></span>
									<span class="ft"><b data-faces-title></b><small data-faces-sub></small></span>
								</div>
								<button type="button" class="cd-team cd-open" data-book-open data-center-open hidden>
									<i class="cd-mark" aria-hidden="true"><img src="/images/DocSera-shape-main.svg" alt="" width="26" height="26" /></i>
									<span class="ft"><b>ملف المركز على DocSera</b><small>افتحه في التطبيق</small></span>
								</button>
								<i class="cd-sheen" data-cd-sheen aria-hidden="true"></i>
							</div>
							<div class="cd-back" data-cd-back>
								<img class="cd-blogo" src="/images/docsera_main.svg" alt="" width="101" height="16" />
								<div class="cd-qr" data-cd-qr></div>
								<b data-cd-back-name></b>
								<p>امسح الرمز لفتح الملف على DocSera</p>
								<button type="button" data-cd-flip>العودة إلى البطاقة</button>
							</div>
						</div>
						<div class="chips">
							<div class="chip chip-a" data-chip="hours" hidden><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.clock} /></i><span><small data-chip-hours-k>اليوم</small><b data-chip-hours></b></span></div>
							<div class="chip chip-c" data-chip="book" hidden><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.cal} /></i><span><small>الحجز</small><b>متاح عبر DocSera</b></span></div>
						</div>
					</div>
				</div>
			</section>

			<section class="pf">
				<article class="sc tm" data-sec="team" hidden>
					<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.team} /></i><h2>الفريق الطبي</h2></header>
					<div class="tm-row" data-team></div>
				</article>
				<div class="pf-grid" data-pf-grid>
					<article class="sc" data-sec="bio" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.info} /></i><h2>نبذة عن المركز</h2></header>
						<p class="bio" data-bio></p>
						<button type="button" class="more" data-bio-more hidden>عرض المزيد</button>
					</article>
					<article class="sc" data-sec="specialties" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.dept} /></i><h2>التخصصات والأقسام</h2></header>
						<ul class="list" data-list-specialties></ul>
					</article>
					<article class="sc" data-sec="services" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.plus} /></i><h2>الخدمات المقدمة</h2></header>
						<ul class="svc" data-services></ul>
						<button type="button" class="more" data-svc-more hidden>عرض الكل</button>
					</article>
					<article class="sc" data-sec="hours" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.clock} /></i><h2>ساعات العمل</h2><span class="now" data-now></span></header>
						<p class="today"><span>اليوم</span><b data-today></b></p>
						<details class="week">
							<summary>كل أيام الأسبوع</summary>
							<dl data-week></dl>
						</details>
					</article>
					<article class="sc sc-map" data-sec="place" hidden>
						<div class="map" aria-hidden="true">
							<svg viewBox="0 0 640 210" preserveAspectRatio="xMidYMid slice">
								<rect width="640" height="210" fill="#EEF3F2" />
								<path d="M70 -10C98 44 62 96 112 140S210 178 196 230" fill="none" stroke="#BFE7E2" stroke-width="20" />
								<path d="M-10 66 660 34M-10 150 660 118M250 -10 214 220M452 -10 482 220" fill="none" stroke="#fff" stroke-width="11" />
								<path d="M-10 108 660 76M150 -10 122 220M352 -10 346 220M560 -10 592 220" fill="none" stroke="#fff" stroke-width="5" />
								<path d="M320 118c-6-16-27-26-27-48a27 27 0 0 1 54 0c0 22-21 32-27 48z" fill="#007474" /><circle cx="320" cy="70" r="10" fill="#fff" />
							</svg>
						</div>
						<div class="place">
							<div><b data-place-name></b><span data-place-addr></span><small data-place-details hidden></small></div>
							<a class="go" data-map-link href="#" target="_blank" rel="noopener" hidden><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.go} />خرائط</a>
						</div>
					</article>
					<article class="sc" data-sec="langs" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.globe} /></i><h2>اللغات المتحدث بها</h2></header>
						<div class="langs" data-langs></div>
					</article>
					<article class="sc" data-sec="insurance" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.shield} /></i><h2>التأمينات المقبولة</h2></header>
						<ul class="list" data-list-insurance></ul>
					</article>
					<article class="sc" data-sec="facilities" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.build} /></i><h2>المرافق والتجهيزات</h2></header>
						<ul class="list" data-list-facilities></ul>
					</article>
				</div>
			</section>

			<section class="end">
				<h2 data-end-title>تابع هذا المركز على DocSera</h2>
				<button type="button" class="btn btn-w" data-book-open><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.cal} /><span data-book-label>افتح في التطبيق</span></button>
			</section>

			<aside class="bk" data-book-sheet>
				<button type="button" class="bk-x" data-book-close aria-label="إغلاق" title="إغلاق">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
				</button>
				<EntityCta kind="center" quiet />
			</aside>
			<div class="bk-scrim" data-book-scrim></div>
			<div class="bk-bar"><button type="button" class="btn" data-book-open><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.cal} /><span data-book-label>افتح في التطبيق</span></button></div>
		</div>

		<div class="state state-msg" data-state="not-found" hidden>
			<h1>لم نعثر على هذا المركز</h1>
			<p>قد يكون الرابط منتهي الصلاحية أو حذف المركز ملفه. تحقق من الرابط وحاول مرة أخرى.</p>
			<a href="/" class="btn">العودة للرئيسية</a>
		</div>

		<div class="state state-msg" data-state="invalid" hidden>
			<h1>رابط غير صحيح</h1>
			<p>الرابط لا يحتوي على معرّف مركز صالح. الرجاء العودة للرئيسية.</p>
			<a href="/" class="btn">العودة للرئيسية</a>
		</div>
	</main>

	<Footer seamless />
</Layout>

<script>
	import { SUPABASE_URL, SUPABASE_ANON_KEY, attributionSource, fireBeacon } from '../scripts/reach';
	import { initEntityCta } from '../scripts/entity-cta';
	import { byData, hasHours, parsed, placeholderFor, renderBio, renderHours, renderLanguages, renderServices, revealCards, setMapLink, showChip, showSec, startCard, stringList, wireSheet } from '../scripts/site/profile-card';

	// Local previews only: a fictional centre at /center/?preview=1. The flag exists only in
	// the untracked .env.local, so a production build drops this path entirely.
	const demo = import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && new URLSearchParams(window.location.search).has('preview');

	// Map raw type slugs from centers.type to human-readable Arabic labels.
	// 'solo' and 'clinic' are the only values seen in real data today (most
	// "centers" in this DB are actually single-doctor solo practices); the
	// rest are anticipated multi-specialty / lab / pharmacy types kept here
	// so future records render without code changes. Unknown/empty falls
	// back to "عيادة" — the most common case in production today.
	const TYPE_LABELS: Record<string, string> = {
		solo: 'عيادة',
		clinic: 'عيادة',
		medical_center: 'مركز طبي',
		hospital: 'مستشفى',
		polyclinic: 'مجمع عيادات',
		dental_center: 'مركز أسنان',
		dental_clinic: 'عيادة أسنان',
		lab: 'مختبر',
		laboratory: 'مختبر',
		imaging: 'مركز تصوير شعاعي',
		pharmacy: 'صيدلية',
	};

	const API_HEADERS = { apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + SUPABASE_ANON_KEY };
	const ctaTitle = document.querySelector('[data-entity-cta] .cta-title');
	const bookingTitle = ctaTitle?.textContent || '';
	let shownName = 'هذا المركز';

	// ----- Id extraction & validation -------------------------
	const match = window.location.pathname.match(/^\/center\/([^/?#]+)/);
	let centerId = '';
	try {
		centerId = match ? decodeURIComponent(match[1]) : '';
	} catch { /* malformed %-escape → invalid */ }
	if (import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && demo) centerId = 'preview';

	// Same broad bounds the patient app's isValidCenterId uses:
	// [A-Za-z0-9_-], length 1..64. UUIDs always fit.
	if (!/^[A-Za-z0-9_-]{1,64}$/.test(centerId)) {
		showState('invalid');
	} else {
		if (!demo) {
			fireBeacon('center_qr_scanned', 'reach', 'ds_beacon_center_' + centerId, {
				center_id: centerId,
				source: attributionSource(),
				surface: 'landing',
			});
		}
		// Buttons first, profile second — see doctor.astro.
		initEntityCta('center', centerId);
		showState('center');
		const web = document.querySelector<HTMLAnchorElement>('[data-entity-cta] [data-webapp-link]');
		if (web) (byData('hx-web') as HTMLAnchorElement).href = web.href;
		applyBookable(false);
		wireSheet();
		startCard();
		byData('center-retry').addEventListener('click', () => fetchCenter(centerId));
		fetchCenter(centerId);
	}

	function fetchCenter(id: string) {
		setCardState('loading');

		if (import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && demo) {
			import('../data/centerPreview').then((m) => window.setTimeout(() => {
				const solo = new URLSearchParams(window.location.search).has('solo');
				const c = solo ? m.CENTER_PREVIEW_SOLO : m.CENTER_PREVIEW;
				renderCenter(c);
				renderTeam(solo ? m.CENTER_PREVIEW_SOLO_TEAM : m.CENTER_PREVIEW_TEAM, c);
			}, 420));
			return;
		}

		const select = [
			'id', 'name', 'type', 'description', 'address', 'location', 'center_image', 'logo_url',
			'opening_hours', 'specialties', 'offered_services', 'languages', 'insurance_accepted', 'facilities',
		].join(',');

		const url = SUPABASE_URL + '/rest/v1/public_centers' +
			'?select=' + encodeURIComponent(select) +
			'&id=eq.' + encodeURIComponent(id) +
			'&limit=1';

		// Slow networks: give up after 15 s and offer a retry.
		const ctrl = new AbortController();
		const timer = window.setTimeout(() => ctrl.abort(), 15000);

		fetch(url, { headers: API_HEADERS, signal: ctrl.signal })
			.then((r) => {
				if (!r.ok) throw new Error('HTTP ' + r.status);
				return r.json();
			})
			.then((rows: any[]) => {
				if (!Array.isArray(rows) || rows.length === 0) {
					// The server answered and there is no such center.
					showState('not-found');
					return;
				}
				renderCenter(rows[0]);
				fetchTeam(id, rows[0]);
			})
			.catch((err) => {
				// Network failure, timeout or a server error: keep the CTA
				// usable and say what happened.
				console.error('[center page] fetch failed:', err);
				setCardState('offline');
			})
			.finally(() => window.clearTimeout(timer));
	}

	// The team is an addition to a page that already works: when it cannot load, the
	// card simply has no faces and the buttons stay as they are.
	async function fetchTeam(id: string, c: any) {
		const ctrl = new AbortController();
		const timer = window.setTimeout(() => ctrl.abort(), 15000);
		const get = async (path: string) => {
			const r = await fetch(SUPABASE_URL + '/rest/v1/' + path, { headers: API_HEADERS, signal: ctrl.signal });
			if (!r.ok) throw new Error('HTTP ' + r.status);
			return r.json();
		};
		try {
			const links: any[] = await get('public_center_doctors?select=doctor_id,kind,opening_hours&center_id=eq.' + encodeURIComponent(id));
			const byId = new Map<string, any>();
			links.forEach((l) => { if (/^[0-9a-f-]{36}$/i.test(String(l.doctor_id)) && !byId.has(l.doctor_id)) byId.set(l.doctor_id, l); });
			const ids = [...byId.keys()].slice(0, 40);
			if (!ids.length) { renderTeam([], c); return; }
			// select=*: placeholder_style is never named in a select list.
			const docs: any[] = await get(`public_doctors?select=*&is_active=eq.true&id=in.(${ids.join(',')})`);
			const team = docs.map((d) => ({ ...d, center_kind: byId.get(d.id)?.kind, center_opening_hours: byId.get(d.id)?.opening_hours }));
			team.sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id));
			renderTeam(team, c);
		} catch {
			renderTeam([], c);
		} finally {
			window.clearTimeout(timer);
		}
	}

	function setCardState(state: 'loading' | 'ready' | 'offline') {
		const card = byData('center-card');
		card.classList.toggle('is-loading', state === 'loading');
		card.classList.toggle('is-offline', state === 'offline');
		byData('center-offline').hidden = state !== 'offline';
	}

	function renderCenter(c: any) {
		const name = (c.name || '').trim() || 'مركز طبي';
		shownName = name;
		const nameEl = byData('center-name');
		nameEl.textContent = name;
		nameEl.style.setProperty('--fs', String(name.length > 30 ? 20 : name.length > 22 ? 23 : 27));
		byData('hx-name').textContent = name;
		byData('cd-back-name').textContent = name;
		document.title = name + ' — DocSera';

		// Type label — map known slugs, fall back to the raw value if it
		// looks readable (already Arabic), else "عيادة" (the most common
		// real-world case in this DB).
		const rawType = (c.type || '').trim();
		const label = TYPE_LABELS[rawType] ||
			(rawType && !/^[a-z_]+$/.test(rawType) ? rawType : 'عيادة');
		byData('center-type').textContent = label;

		const specialties = stringList(c.specialties);
		const specs = byData('center-specs');
		specs.replaceChildren(...specialties.slice(0, 3).map((t) => {
			const pill = document.createElement('span');
			pill.textContent = t;
			return pill;
		}));
		specs.hidden = specialties.length === 0;

		const address = parsed(c.address);
		const addr = formatAddress(address);
		byData('center-card-place-t').textContent = addr;
		byData('center-card-place').hidden = !addr;
		const city = String(address?.city || '').trim();
		byData('hx-sub').textContent = [label, city].filter(Boolean).join(' · ');

		renderBio(c.description);
		renderList('specialties', specialties);
		renderServices(c.offered_services);
		renderLanguages(c.languages);
		renderList('insurance', stringList(c.insurance_accepted));
		renderList('facilities', stringList(c.facilities));
		renderHours(c.opening_hours);

		byData('place-name').textContent = name;
		byData('place-addr').textContent = addr;
		const details = String(address?.details || '').trim();
		const detailsEl = byData('place-details');
		detailsEl.textContent = details;
		detailsEl.hidden = !details || details.toLowerCase() === 'null';
		showSec('place', !!addr);
		setMapLink(c.location);

		applyBookable(false);
		renderImage(c, name);
		setCardState('ready');
		revealCards();
	}

	function renderList(name: string, items: string[]) {
		showSec(name, items.length > 0);
		byData('list-' + name).replaceChildren(...items.map((t) => {
			const li = document.createElement('li');
			li.textContent = t;
			return li;
		}));
	}

	const fullName = (d: any) => [d.title, d.first_name, d.middle_name, d.last_name]
		.map((s) => String(s ?? '').trim())
		.filter((s) => s && s.toLowerCase() !== 'null')
		.join(' ');

	function faceImage(d: any): HTMLImageElement {
		const img = document.createElement('img');
		const fallback = placeholderFor(d);
		const path = String(d.doctor_image || '').trim();
		img.alt = '';
		img.width = 66;
		img.height = 66;
		img.decoding = 'async';
		if (!path) { img.src = fallback; return img; }
		img.onerror = () => { img.onerror = null; img.src = fallback; };
		img.src = path.startsWith('http')
			? path
			: SUPABASE_URL + '/storage/v1/object/public/doctor/' + path.split('/').map((seg) => encodeURIComponent(seg)).join('/');
		return img;
	}

	function renderTeam(team: any[], c: any) {
		const faces = byData('center-faces');
		faces.hidden = team.length === 0;
		byData('center-open').hidden = team.length > 0;
		showSec('team', team.length > 0);

		if (team.length) {
			const shown: HTMLElement[] = team.slice(0, 4).map(faceImage);
			if (team.length > 4) {
				const more = document.createElement('em');
				more.textContent = `+${team.length - 4}`;
				shown.push(more);
			}
			byData('faces').replaceChildren(...shown);
			const specialties = [...new Set(team.map((d) => String(d.specialty || '').trim()).filter(Boolean))];
			byData('faces-title').textContent = team.length === 1 ? fullName(team[0]) : 'الفريق الطبي';
			byData('faces-sub').textContent = team.length === 1 ? (specialties[0] || '') : specialties.slice(0, 2).join('، ');

			const row = byData('team');
			row.classList.toggle('solo', team.length === 1);
			row.replaceChildren(...team.map((d) => {
				const tile = document.createElement('div'), b = document.createElement('b');
				tile.className = 'tc';
				b.textContent = fullName(d);
				tile.append(faceImage(d), b);
				const specialty = String(d.specialty || '').trim();
				if (specialty) {
					const s = document.createElement('span');
					s.textContent = specialty;
					tile.append(s);
				}
				if (d.is_bookable_subscription !== true) {
					const off = document.createElement('small');
					off.textContent = 'غير متاح حالياً';
					tile.append(off);
				}
				return tile;
			}));
			// A small team sits among the other cards instead of a wide empty row.
			if (team.length <= 2) byData('pf-grid').prepend(document.querySelector('[data-sec="team"]')!);
		}

		renderHours(hoursFor(c, team));
		const bookable = team.some((d) => d.is_bookable_subscription === true);
		applyBookable(bookable);
		showChip('book', bookable);
		revealCards();
	}

	// A centre's own hours; for a one-doctor practice, that doctor's hours at this place.
	function hoursFor(c: any, team: any[]) {
		if (hasHours(c.opening_hours)) return c.opening_hours;
		if (team.length !== 1) return null;
		if (hasHours(team[0].center_opening_hours)) return team[0].center_opening_hours;
		return team[0].center_kind === 'visiting' ? null : team[0].opening_hours;
	}

	// A centre nobody can be booked at right now is still opened, never promised a booking.
	function applyBookable(bookable: boolean) {
		const label = bookable ? 'احجز موعداً' : 'افتح في التطبيق';
		document.querySelectorAll('[data-book-label]').forEach((el) => { el.textContent = label; });
		byData('hx-lead').textContent = bookable ? 'احجز موعدك في' : 'تعرّف على';
		byData('end-title').textContent = bookable ? `احجز موعدك في ${shownName}` : `تابع ${shownName} على DocSera`;
		if (ctaTitle) ctaTitle.textContent = bookable ? bookingTitle : 'افتح هذا المركز في تطبيق DocSera';
	}

	function formatAddress(addr: any): string {
		if (!addr || typeof addr !== 'object') return '';
		const street = (addr.street || '').trim();
		const rawHood = (addr.neighborhood || '').trim();
		const hood = rawHood.replace(/\s*\([^)]*\)\s*$/, '').trim();
		const city = (addr.city || '').trim();
		const parts: string[] = [];
		if (street) parts.push(street);
		// The zone is left out when the street already names it («شارع القصاع» +
		// «القصاع» prints once) — the same rule as the doctor page (Pro doc 140).
		if (hood && !street.includes(hood) && hood !== city) parts.push(hood);
		if (city) parts.push(city);
		return parts.join('، ');
	}

	// The centre's picture or logo, else the app's approved centre illustration.
	function renderImage(c: any, name: string) {
		const img = byData('center-image') as HTMLImageElement;
		const fallback = '/images/placeholders/ph_center.svg';
		img.alt = name;
		img.onload = () => img.classList.add('is-loaded');

		// Storage bucket for centers is "center-images" (plural, hyphenated)
		// — the doctor convention is "doctor" (singular).
		const storage = (p: string) => SUPABASE_URL + '/storage/v1/object/public/center-images/' +
			p.split('/').map((seg: string) => encodeURIComponent(seg)).join('/');
		const path = (c.center_image || '').trim();
		const logo = (c.logo_url || '').trim();
		const url = path ? storage(path) : logo ? (logo.startsWith('http') ? logo : storage(logo)) : '';

		if (!url) { img.onerror = null; img.src = fallback; return; }
		img.onerror = () => { img.onerror = null; img.src = fallback; };
		img.src = url;
	}

	function showState(state: string) {
		document.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => {
			el.hidden = el.dataset.state !== state;
		});
	}
</script>

