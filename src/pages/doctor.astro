---
// Doctor landing page, rendered for every /doctor/<token> URL: what a patient sees after
// scanning the clinic's QR. The doctor's card is the app's own profile header made into a
// physical object on the home page's silk: it tilts, its layers separate in depth, and it
// turns over to show the doctor's QR.
//
// Routing: this file builds to dist/doctor/index.html. The companion nginx rule (see
// nginx/default.conf) maps any /doctor/<anything> URL to this file via try_files, so a
// single static page handles every doctor's token without rebuilds.
//
// The page renders a loading shell, then the script reads the token from the path, queries
// the public_doctors view (anon read, RLS-gated) and shows one of these states:
//
//   - loading    placeholder until the script runs
//   - doctor     valid token → card (skeleton first) + EntityCta
//   - not-found  token didn't match an active doctor
//   - invalid    no token in the path, or it failed the safety regex (alnum + - + _, max 64)
//
// The CTA (install / open in app / web app) is wired from the URL alone and works at once;
// it does not wait for the profile. A patient on a weak connection can still install and
// open the doctor even when the profile never arrives: the card says so and offers a retry.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import EntityCta from '../components/EntityCta.astro';
import SiteHeader from '../components/site/SiteHeader.astro';

const silk = '/images/home/3d/silk-860.webp 860w, /images/home/3d/silk-1600.webp 1600w';
const I = {
	qr: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.4"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.4"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.4"/><path d="M14 14h2.5v2.5M20 14v.01M14 20h.01M17.5 20H20v-3"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
	pin: '<path d="M12 21s7-5.6 7-11.2A7 7 0 0 0 5 9.8C5 15.4 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.5"/>',
	plus: '<rect x="4" y="7" width="16" height="13" rx="3"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M12 10.8v5.4M9.3 13.5h5.4"/>',
	user: '<circle cx="12" cy="8" r="3.6"/><path d="M5 20c.7-4 3.4-6 7-6s6.3 2 7 6"/>',
	globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.4 3.6 5.2 3.6 8.5s-1.2 6.1-3.6 8.5c-2.4-2.4-3.6-5.2-3.6-8.5S9.6 5.900 12 3.500z"/>',
	go: '<path d="m4 11 16-7-7 16-2.2-6.800z"/>',
	cal: '<rect x="4" y="5" width="16" height="15" rx="3"/><path d="M4 10h16M9 3v4M15 3v4"/>',
};
---

<Layout title="DocSera — ملف الطبيب" appBanner="entity" appBar={false}>
	<SiteHeader />

	<main class="dp">
		<div class="state state-loading" data-state="loading">
			<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<p>جارٍ تحميل بيانات الطبيب…</p>
		</div>

		<div class="state" data-state="doctor" hidden>
			<section class="st" data-stage>
				<div class="st-bg" aria-hidden="true"><img class="silk" src="/images/home/3d/silk-860.webp" srcset={silk} sizes="max(100vw, 160vh)" alt="" width="1600" height="1000" fetchpriority="high" decoding="async" /></div>
				<div class="st-in">
					<div class="hx">
						<h1><span data-hx-lead>احجز موعدك مع</span><br /><b data-hx-name>طبيبك</b></h1>
						<p data-hx-sub></p>
						<div class="hx-cta">
							<button type="button" class="btn" data-book-open><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.cal} /><span data-book-label>احجز موعداً</span></button>
							<a class="hx-web" data-hx-web href="#" rel="noopener">أو افتحه من المتصفح</a>
						</div>
					</div>

					<div class="cd-wrap" data-cd-wrap>
						<div class="cd is-loading" data-cd data-doctor-card>
							<i class="sl" style="--z:-7"></i><i class="sl" style="--z:-5"></i><i class="sl" style="--z:-3"></i><i class="sl" style="--z:-1"></i>
							<div class="cd-front" data-cd-front>
								<i class="cd-face" aria-hidden="true"><b></b><b></b><img src="/images/DocSera-shape-main.svg" alt="" width="60" height="60" /></i>
								<div class="cd-top">
									<img src="/images/docsera_main.svg" alt="DocSera" width="101" height="16" />
									<button type="button" data-cd-flip aria-label="رمز QR للطبيب" title="رمز QR للطبيب"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.qr} /></button>
								</div>
								<div class="cd-who">
									<div class="cd-photo">
										<span class="cd-pic"><img data-doctor-image alt="" /></span>
										<i class="cd-tick" data-doctor-tick hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 12.500 4 4L18 8" /></svg></i>
									</div>
									<h2 class="cd-name" data-doctor-name></h2>
									<p class="cd-spec" data-doctor-specialty></p>
									<p class="cd-place" data-doctor-card-place hidden><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.pin} /><span data-doctor-card-place-t></span></p>
									<p class="cd-offline" data-doctor-offline hidden>
										تعذّر تحميل بيانات الطبيب. تحقق من اتصالك بالإنترنت.
										<button type="button" data-doctor-retry>إعادة المحاولة</button>
									</p>
								</div>
								<div class="cd-tags" data-doctor-tags hidden></div>
								<i class="cd-sheen" data-cd-sheen aria-hidden="true"></i>
							</div>
							<div class="cd-back" data-cd-back>
								<img class="cd-blogo" src="/images/docsera_main.svg" alt="" width="101" height="16" />
								<div class="cd-qr" data-cd-qr></div>
								<b data-cd-back-name></b>
								<p>امسح الرمز لفتح الملف على DocSera</p>
								<button type="button" data-cd-flip>العودة إلى البطاقة</button>
							</div>
						</div>
						<div class="chips">
							<div class="chip chip-a" data-chip="hours" hidden><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.clock} /></i><span><small data-chip-hours-k>اليوم</small><b data-chip-hours></b></span></div>
							<div class="chip chip-c" data-chip="svc" hidden><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.plus} /></i><span><small>الخدمات</small><b data-chip-svc></b></span></div>
						</div>
					</div>
				</div>
			</section>

			<section class="pf">
				<div class="pf-grid">
					<article class="sc" data-sec="bio" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.user} /></i><h2>الملف الشخصي</h2></header>
						<p class="bio" data-doctor-bio></p>
						<button type="button" class="more" data-bio-more hidden>عرض المزيد</button>
					</article>
					<article class="sc" data-sec="hours" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.clock} /></i><h2>ساعات العمل</h2><span class="now" data-doctor-now></span></header>
						<p class="today"><span>اليوم</span><b data-doctor-today></b></p>
						<details class="week">
							<summary>كل أيام الأسبوع</summary>
							<dl data-doctor-week></dl>
						</details>
					</article>
					<article class="sc" data-sec="services" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.plus} /></i><h2>الخدمات المقدمة</h2></header>
						<ul class="svc" data-doctor-services></ul>
						<button type="button" class="more" data-svc-more hidden>عرض الكل</button>
					</article>
					<article class="sc sc-map" data-sec="place" hidden>
						<div class="map" aria-hidden="true">
							<svg viewBox="0 0 640 210" preserveAspectRatio="xMidYMid slice">
								<rect width="640" height="210" fill="#EEF3F2" />
								<path d="M70 -10C98 44 62 96 112 140S210 178 196 230" fill="none" stroke="#BFE7E2" stroke-width="20" />
								<path d="M-10 66 660 34M-10 150 660 118M250 -10 214 220M452 -10 482 220" fill="none" stroke="#fff" stroke-width="11" />
								<path d="M-10 108 660 76M150 -10 122 220M352 -10 346 220M560 -10 592 220" fill="none" stroke="#fff" stroke-width="5" />
								<path d="M320 118c-6-16-27-26-27-48a27 27 0 0 1 54 0c0 22-21 32-27 48z" fill="#007474" /><circle cx="320" cy="70" r="10" fill="#fff" />
							</svg>
						</div>
						<div class="place">
							<div><b data-doctor-clinic></b><span data-doctor-address-text></span></div>
							<a class="go" data-doctor-map href="#" target="_blank" rel="noopener" hidden><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.go} />خرائط</a>
						</div>
					</article>
					<article class="sc" data-sec="langs" hidden>
						<header><i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.globe} /></i><h2>اللغات المتحدث بها</h2></header>
						<div class="langs" data-doctor-langs></div>
					</article>
				</div>
			</section>

			<section class="end">
				<h2 data-end-title>احجز موعدك عبر DocSera</h2>
				<button type="button" class="btn btn-w" data-book-open><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.cal} /><span data-book-label>احجز موعداً</span></button>
			</section>

			<aside class="bk" data-book-sheet>
				<button type="button" class="bk-x" data-book-close aria-label="إغلاق" title="إغلاق">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
				</button>
				<EntityCta kind="doctor" quiet />
			</aside>
			<div class="bk-scrim" data-book-scrim></div>
			<div class="bk-bar"><button type="button" class="btn" data-book-open><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.cal} /><span data-book-label>احجز موعداً</span></button></div>
		</div>

		<div class="state state-msg" data-state="not-found" hidden>
			<h1>لم نعثر على هذا الطبيب</h1>
			<p>قد يكون الرابط منتهي الصلاحية أو حذف الطبيب ملفه. تحقق من الرابط وحاول مرة أخرى.</p>
			<a href="/" class="btn">العودة للرئيسية</a>
		</div>

		<div class="state state-msg" data-state="invalid" hidden>
			<h1>رابط غير صحيح</h1>
			<p>الرابط لا يحتوي على معرّف طبيب صالح. الرجاء العودة للرئيسية.</p>
			<a href="/" class="btn">العودة للرئيسية</a>
		</div>
	</main>

	<Footer seamless />
</Layout>

<script>
	import qrcode from 'qrcode-generator';
	import { SUPABASE_URL, SUPABASE_ANON_KEY, attributionSource, fireBeacon } from '../scripts/reach';
	import { initEntityCta } from '../scripts/entity-cta';

	// Local previews only: a fictional doctor at /doctor/?preview=1. The flag exists only in
	// the untracked .env.local, so a production build drops this path entirely.
	const demo = import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && new URLSearchParams(window.location.search).has('preview');

	// ----- Token extraction & validation ----------------------
	const match = window.location.pathname.match(/^\/doctor\/([^/?#]+)/);
	let token = '';
	try {
		token = match ? decodeURIComponent(match[1]) : '';
	} catch { /* malformed %-escape → invalid */ }
	if (import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && demo) token = 'preview';

	// Same constraint the deep-link handler in the patient app uses
	// (services/navigation/deep_link_service.dart): alnum + - + _,
	// max 64 chars. Reject anything else as malformed.
	if (!/^[A-Za-z0-9_-]{1,64}$/.test(token)) {
		showState('invalid');
	} else {
		// Anonymous scan counter: counts landing opens even when the
		// visitor never installs the app.
		if (!demo) {
			fireBeacon('doctor_qr_scanned', 'reach', 'ds_beacon_doctor_' + token, {
				token: token,
				source: attributionSource(),
				surface: 'landing',
			});
		}
		// Buttons first, profile second.
		initEntityCta('doctor', token);
		showState('doctor');
		const web = document.querySelector<HTMLAnchorElement>('[data-entity-cta] [data-webapp-link]');
		if (web) (byData('hx-web') as HTMLAnchorElement).href = web.href;
		wireSheet();
		startCard();
		byData('doctor-retry').addEventListener('click', () => fetchDoctor(token));
		fetchDoctor(token);
	}

	function fetchDoctor(token: string) {
		setCardState('loading');

		if (import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && demo) {
			import('../data/doctorPreview').then((m) => window.setTimeout(() => renderDoctor(m.DOCTOR_PREVIEW), 420));
			return;
		}

		// select=*: placeholder_style must never be named in a select list (it is read
		// from whole rows, the same rule as the apps), and RLS + the view already blank
		// every private column.
		const url = SUPABASE_URL + '/rest/v1/public_doctors' +
			'?select=*' +
			'&public_token=eq.' + encodeURIComponent(token) +
			'&is_active=eq.true' +
			'&limit=1';

		// Slow networks: give up after 15 s and offer a retry rather than
		// leaving the card on its skeleton forever.
		const ctrl = new AbortController();
		const timer = window.setTimeout(() => ctrl.abort(), 15000);

		fetch(url, {
			headers: {
				apikey: SUPABASE_ANON_KEY,
				Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
			},
			signal: ctrl.signal,
		})
			.then((r) => {
				if (!r.ok) throw new Error('HTTP ' + r.status);
				return r.json();
			})
			.then((rows: any[]) => {
				if (!Array.isArray(rows) || rows.length === 0) {
					// The server answered and there is no such doctor.
					showState('not-found');
					return;
				}
				renderDoctor(rows[0]);
			})
			.catch((err) => {
				// Network failure, timeout or a server error: the token may
				// well be fine, so keep the CTA usable and say what happened.
				console.error('[doctor page] fetch failed:', err);
				setCardState('offline');
			})
			.finally(() => window.clearTimeout(timer));
	}

	function setCardState(state: 'loading' | 'ready' | 'offline') {
		const card = byData('doctor-card');
		card.classList.toggle('is-loading', state === 'loading');
		card.classList.toggle('is-offline', state === 'offline');
		card.classList.toggle('is-ready', state === 'ready');
		byData('doctor-offline').hidden = state !== 'offline';
	}

	const isPhysician = (d: any) => ['د.', '.د', 'dr.', 'د', 'doctor'].includes(String(d.title || '').toLowerCase().trim());

	function renderDoctor(d: any) {
		const titlePart = (d.title || '').trim();
		const namePart = [d.first_name, d.middle_name, d.last_name]
			.map((s: any) => (s || '').trim())
			.filter(Boolean)
			.join(' ');
		const fullName = [titlePart, namePart].filter(Boolean).join(' ').trim();
		const shown = fullName || 'طبيب';

		const nameEl = byData('doctor-name');
		nameEl.textContent = shown;
		nameEl.style.setProperty('--fs', String(shown.length > 26 ? 23 : shown.length > 19 ? 26 : 31));
		byData('hx-name').textContent = shown;
		byData('cd-back-name').textContent = shown;
		document.title = fullName ? (fullName + ' — DocSera') : 'DocSera — ملف الطبيب';

		const spec = d.specialty ||
			(Array.isArray(d.specialties) && d.specialties.length > 0
				? d.specialties[0]
				: '');
		byData('doctor-specialty').textContent = spec || 'طبيب';
		const clinic = (d.clinic || '').trim(), city = (d.address?.city || '').trim();
		byData('hx-sub').textContent = [spec, [clinic, city].filter(Boolean).join('، ')].filter(Boolean).join(' · ');

		// The same three tags, under the same conditions, as the app's profile header.
		const bookable = d.is_bookable_subscription === true;
		const verified = d.verification_status === 'verified';
		byData('doctor-tick').hidden = !verified;
		renderTags([
			bookable && d.require_confirmation === false ? ['bolt', 'حجز فوري'] : null,
			verified ? ['check', isPhysician(d) ? 'طبيب موثّق' : 'مختص موثّق'] : null,
			bookable && d.messages_enabled === true && d.is_messageable_subscription === true ? ['msg', 'يستقبل الرسائل'] : null,
		].filter(Boolean) as string[][]);
		applyBookable(bookable, shown);

		renderBio(d.profile_description);
		renderPlace(d);
		renderHours(d.opening_hours);
		renderServices(d.offered_services);
		renderLanguages(d.languages);
		renderImage(d, fullName);
		setCardState('ready');
		revealCards();
	}

	// A doctor who cannot be booked right now is still opened, never promised a booking.
	function applyBookable(bookable: boolean, name: string) {
		const label = bookable ? 'احجز موعداً' : 'افتح في التطبيق';
		document.querySelectorAll('[data-book-label]').forEach((el) => { el.textContent = label; });
		byData('hx-lead').textContent = bookable ? 'احجز موعدك مع' : 'تعرّف على';
		byData('end-title').textContent = bookable ? `احجز موعدك مع ${name}` : `تابع ${name} على DocSera`;
		const title = document.querySelector('[data-entity-cta] .cta-title');
		if (title && !bookable) title.textContent = 'افتح هذا الملف في تطبيق DocSera';
	}

	const TAG_ICONS: Record<string, string> = {
		bolt: '<path d="M13 3 5 13.500h6L10 21l8-10.500h-6z"/>',
		check: '<path d="m5 12.500 4.600 4.600L19 7.600"/>',
		msg: '<path d="M20.500 12a8.500 8.500 0 0 1-12.400 7.500L3.500 21l1.500-4.600A8.500 8.500 0 1 1 20.500 12z"/>',
	};
	function renderTags(tags: string[][]) {
		const box = byData('doctor-tags');
		box.hidden = tags.length === 0;
		box.replaceChildren(...tags.map(([icon, label]) => {
			const t = document.createElement('span'), i = document.createElement('i'), b = document.createElement('b');
			t.className = icon === 'bolt' ? 'tag tag-ok' : 'tag';
			i.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true">${TAG_ICONS[icon]}</svg>`;
			b.textContent = label;
			t.append(i, b);
			return t;
		}));
	}

	function showSec(name: string, on: boolean) {
		const el = document.querySelector<HTMLElement>(`[data-sec="${name}"]`);
		if (el) el.hidden = !on;
	}
	function showChip(name: string, on: boolean) {
		const el = document.querySelector<HTMLElement>(`[data-chip="${name}"]`);
		if (el) el.hidden = !on;
	}

	// ----- Sections: each one stays hidden when the doctor left it empty ----------
	function bioText(value: any): string {
		let d = value;
		if (typeof d === 'string') {
			try { d = JSON.parse(d); } catch { return d.trim(); }
		}
		const ops = (x: any) => (Array.isArray(x) ? x : (x?.ops || []))
			.map((o: any) => (typeof o?.insert === 'string' ? o.insert : ''))
			.join('');
		if (Array.isArray(d?.parts)) return d.parts.map((p: any) => ops(p?.delta).trim()).filter(Boolean).join('\n\n');
		return ops(d).trim();
	}

	function renderBio(value: any) {
		const text = bioText(value);
		showSec('bio', !!text);
		if (!text) return;
		const el = byData('doctor-bio'), more = byData('bio-more');
		el.textContent = text;
		more.hidden = text.length < 230;
		el.classList.toggle('short', text.length >= 230);
		more.onclick = () => { el.classList.remove('short'); more.hidden = true; };
	}

	function renderPlace(d: any) {
		const clinic = (d.clinic || '').trim(), addr = formatAddress(d.address);
		byData('doctor-clinic').textContent = clinic || addr;
		byData('doctor-clinic').hidden = !(clinic || addr);
		byData('doctor-address-text').textContent = clinic ? addr : '';
		showSec('place', !!(clinic || addr));
		const city = (d.address?.city || '').trim();
		const where = (clinic && city && !clinic.includes(city) ? `${clinic}، ${city}` : clinic || city) || addr;
		byData('doctor-card-place-t').textContent = where;
		byData('doctor-card-place').hidden = !where;
		const lat = Number(d.location?.lat), lng = Number(d.location?.lng), map = byData('doctor-map') as HTMLAnchorElement;
		const has = Number.isFinite(lat) && Number.isFinite(lng) && !(lat === 0 && lng === 0) && d.location?.lat != null && d.location?.lng != null;
		map.hidden = !has;
		if (has) map.href = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
	}

	function formatAddress(addr: any): string {
		if (!addr || typeof addr !== 'object') return '';
		// «street، zone، city». `street` is what the doctor typed; `neighborhood`
		// is the search zone he picked for the patient app's area filter — since
		// Pro doc 140 a required choice from the city's list, or a name he typed
		// under «أخرى» — so it is printed inside the address, between the street
		// and the city. It is left out when the street already names it
		// («شارع القصاع» + «القصاع» prints once) or when it is the city itself;
		// the city is left out when it equals the street.
		const street = (addr.street || '').trim();
		const zone = (addr.neighborhood || '').trim();
		const city = (addr.city || '').trim();
		const parts: string[] = [];
		if (street) parts.push(street);
		if (zone && !street.includes(zone) && zone !== city) parts.push(zone);
		if (city && city !== street) parts.push(city);
		return parts.join('، ');
	}

	const DAYS: [string, string][] = [['sat', 'السبت'], ['sun', 'الأحد'], ['mon', 'الاثنين'], ['tue', 'الثلاثاء'], ['wed', 'الأربعاء'], ['thu', 'الخميس'], ['fri', 'الجمعة']];
	function clock(t: string): string {
		const [h, m] = String(t).split(':').map(Number);
		if (!Number.isFinite(h)) return '';
		const pm = h >= 12 && h < 24;
		return `${h % 12 || 12}:${String(m || 0).padStart(2, '0')} ${pm ? 'م' : 'ص'}`;
	}
	function ranges(list: any): string {
		if (!Array.isArray(list)) return '';
		return list.map((x: any) => (x?.from && x?.to ? `${clock(x.from)} – ${clock(x.to)}` : '')).filter(Boolean).join('،  ');
	}
	const minutes = (t: string) => { const [h, m] = String(t).split(':').map(Number); return h * 60 + (m || 0); };
	function renderHours(hours: any) {
		const any = !!hours && typeof hours === 'object' && DAYS.some(([k]) => ranges(hours[k]));
		showSec('hours', any);
		showChip('hours', any);
		if (!any) return;
		const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Damascus', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
		const get = (k: string) => parts.find((p) => p.type === k)?.value || '';
		const today = get('weekday').toLowerCase(), nowM = Number(get('hour')) * 60 + Number(get('minute'));
		const list: any[] = Array.isArray(hours[today]) ? hours[today].filter((x: any) => x?.from && x?.to) : [];
		const open = list.find((x) => nowM >= minutes(x.from) && nowM < minutes(x.to));
		const next = list.find((x) => nowM < minutes(x.from));
		const status = open ? `مفتوح حتى ${clock(open.to)}` : next ? `يفتح اليوم ${clock(next.from)}` : 'مغلق الآن';
		const pill = byData('doctor-now');
		pill.textContent = status;
		pill.classList.toggle('on', !!open);
		byData('doctor-today').textContent = ranges(list) || 'مغلق';
		byData('chip-hours-k').textContent = open ? 'مفتوح الآن' : 'اليوم';
		byData('chip-hours').textContent = open ? `حتى ${clock(open.to)}` : next ? `يفتح ${clock(next.from)}` : (list.length ? 'انتهى الدوام' : 'مغلق');
		const week = byData('doctor-week');
		week.replaceChildren();
		DAYS.forEach(([key, label]) => {
			const line = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd');
			if (key === today) line.className = 'is-today';
			dt.textContent = label;
			dd.textContent = ranges(hours[key]) || 'مغلق';
			line.append(dt, dd);
			week.append(line);
		});
	}

	function serviceTitles(v: any): string[] {
		let d = v;
		if (typeof d === 'string') {
			try { d = JSON.parse(d); } catch { return []; }
		}
		if (Array.isArray(d)) return d.map((x: any) => (typeof x === 'string' ? x : x?.title || '')).map((s: string) => s.trim()).filter(Boolean);
		if (d && typeof d === 'object') return Object.keys(d).map((s) => s.trim()).filter(Boolean);
		return [];
	}
	function renderServices(v: any) {
		const items = serviceTitles(v);
		showSec('services', items.length > 0);
		showChip('svc', items.length > 0);
		if (!items.length) return;
		byData('chip-svc').textContent = items[0];
		const ul = byData('doctor-services'), more = byData('svc-more');
		const draw = (list: string[]) => ul.replaceChildren(...list.map((t) => {
			const li = document.createElement('li');
			li.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.500 4.600 4.600L19 7.600"/></svg>';
			li.append(document.createTextNode(t));
			return li;
		}));
		draw(items.slice(0, 6));
		more.hidden = items.length <= 6;
		more.onclick = () => { draw(items); more.hidden = true; };
	}

	const LANGS: Record<string, string> = { ar: 'العربية', en: 'الإنجليزية', fr: 'الفرنسية', de: 'الألمانية', ru: 'الروسية', tr: 'التركية', es: 'الإسبانية', it: 'الإيطالية', fa: 'الفارسية', ku: 'الكردية', hy: 'الأرمنية' };
	function renderLanguages(v: any) {
		const list = (Array.isArray(v) ? v : []).map((x: any) => String(x).trim()).filter(Boolean).map((x: string) => LANGS[x.toLowerCase()] || x);
		showSec('langs', list.length > 0);
		byData('doctor-langs').replaceChildren(...list.map((l) => { const s = document.createElement('span'); s.textContent = l; return s; }));
	}

	// The photo, or the app's approved illustration: never initials.
	function placeholderFor(d: any): string {
		const g = String(d.gender || '').toLowerCase().trim();
		const male = g === 'ذكر' || g === 'male';
		const hijab = !male && String(d.placeholder_style || '').toLowerCase().trim() === 'hijab';
		const who = isPhysician(d) ? 'doctor' : 'specialist';
		return `/images/placeholders/ph_${who}_${male ? 'male' : hijab ? 'female_hijab' : 'female'}.svg`;
	}
	function renderImage(d: any, fullName: string) {
		const img = byData('doctor-image') as HTMLImageElement;
		const fallback = placeholderFor(d);
		img.alt = fullName;
		img.onload = () => img.classList.add('is-loaded');
		const path = (d.doctor_image || '').trim();
		if (!path) { img.onerror = null; img.src = fallback; return; }
		// Preserve slashes in the path (it's typically uuid/profile/file.ext)
		// while still escaping any unsafe characters within each segment.
		img.onerror = () => { img.onerror = null; img.src = fallback; };
		img.src = SUPABASE_URL + '/storage/v1/object/public/doctor/' +
			path.split('/').map((seg: string) => encodeURIComponent(seg)).join('/');
	}

	// ----- The card: tilt, depth, sheen, and a turn to its QR ------
	function startCard() {
		const stage = byData('stage'), wrap = byData('cd-wrap'), card = byData('cd');
		const front = byData('cd-front'), back = byData('cd-back'), sheen = byData('cd-sheen');
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let rx = still ? 0 : 15, ry = still ? 0 : -26, tx = 0, ty = 0, flip = 0, flipTo = 0, sx = 30, sy = 18, tsx = 30, tsy = 18;
		let lastInput = 0, inView = true, running = false, showing = true, qrDone = false;
		const drawQr = () => {
			if (qrDone) return;
			qrDone = true;
			const qr = qrcode(0, 'M');
			qr.addData(window.location.href);
			qr.make();
			byData('cd-qr').innerHTML = qr.createSvgTag({ scalable: true, margin: 0 });
		};
		const apply = () => {
			const a = ry + flip;
			card.style.transform = `rotateX(${rx.toFixed(2)}deg) rotateY(${a.toFixed(2)}deg)`;
			const faceFront = Math.cos((a * Math.PI) / 180) >= 0;
			if (faceFront !== showing) {
				showing = faceFront;
				front.style.visibility = faceFront ? 'visible' : 'hidden';
				back.style.visibility = faceFront ? 'hidden' : 'visible';
			}
			sheen.style.setProperty('--sx', `${sx.toFixed(1)}%`);
			sheen.style.setProperty('--sy', `${sy.toFixed(1)}%`);
		};
		const tick = (t: number) => {
			if (!inView) { running = false; return; }
			if (performance.now() - lastInput > 1600 && !still) {
				tx = Math.cos(t / 3100) * 3.4;
				ty = Math.sin(t / 2300) * 8;
				tsx = 50 + ty * 3.4;
				tsy = 26 - tx * 4;
			}
			rx += (tx - rx) * 0.075;
			ry += (ty - ry) * 0.075;
			flip += (flipTo - flip) * 0.1;
			sx += (tsx - sx) * 0.1;
			sy += (tsy - sy) * 0.1;
			apply();
			requestAnimationFrame(tick);
		};
		const run = () => { if (!running && inView && !still) { running = true; requestAnimationFrame(tick); } };
		const aim = (x: number, y: number) => {
			const r = wrap.getBoundingClientRect();
			const nx = Math.max(-1, Math.min(1, (x - r.left - r.width / 2) / (r.width * 0.75)));
			const ny = Math.max(-1, Math.min(1, (y - r.top - r.height / 2) / (r.height * 0.75)));
			ty = nx * 17; tx = -ny * 12;
			tsx = 50 + nx * 46; tsy = 40 + ny * 46;
			stage.style.setProperty('--px', nx.toFixed(3));
			stage.style.setProperty('--py', ny.toFixed(3));
			lastInput = performance.now();
		};
		if (!still) {
			stage.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') aim(e.clientX, e.clientY); });
			wrap.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') aim(e.clientX, e.clientY); });
			wrap.addEventListener('pointermove', (e) => { if (e.pointerType !== 'mouse') aim(e.clientX, e.clientY); });
			new IntersectionObserver(([e]) => { inView = e.isIntersecting; run(); }).observe(stage);
		}
		document.querySelectorAll<HTMLElement>('[data-cd-flip]').forEach((b) => b.addEventListener('click', () => {
			drawQr();
			flipTo = flipTo === 0 ? 180 : 0;
			wrap.classList.toggle('is-flipped', flipTo !== 0);
			if (still) { flip = flipTo; apply(); }
		}));
		apply();
		run();
	}

	function revealCards() {
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.sc:not([hidden])'));
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) { cards.forEach((c) => c.classList.add('in')); return; }
		const io = new IntersectionObserver((es) => es.forEach((e) => {
			if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
		}), { rootMargin: '0px 0px -6% 0px' });
		cards.forEach((c, i) => { c.style.setProperty('--d', `${(i % 2) * 90}ms`); io.observe(c); });
	}

	// ----- The booking steps rise as a sheet (a dialog on wide screens) -----
	function wireSheet() {
		const sheet = document.querySelector<HTMLElement>('[data-book-sheet]')!;
		const scrim = document.querySelector<HTMLElement>('[data-book-scrim]')!;
		const closeBtn = document.querySelector<HTMLElement>('[data-book-close]')!;
		let opener: HTMLElement | null = null;
		const setOpen = (on: boolean, focus = true) => {
			sheet.classList.toggle('open', on);
			scrim.classList.toggle('open', on);
			document.documentElement.classList.toggle('bk-lock', on);
			if (on) { sheet.setAttribute('role', 'dialog'); sheet.setAttribute('aria-modal', 'true'); sheet.setAttribute('aria-label', 'احجز موعداً'); }
			else { sheet.removeAttribute('role'); sheet.removeAttribute('aria-modal'); sheet.removeAttribute('aria-label'); }
			if (focus) (on ? closeBtn : opener)?.focus();
		};
		document.querySelectorAll<HTMLElement>('[data-book-open]').forEach((b) => b.addEventListener('click', () => { opener = b; setOpen(true); }));
		closeBtn.addEventListener('click', () => setOpen(false));
		scrim.addEventListener('click', () => setOpen(false));
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet.classList.contains('open')) setOpen(false); });
		// Back from the store, step 2 is the thing to press: bring it back.
		const back = () => {
			if (document.visibilityState === 'visible' && sheet.querySelector('[data-step-open].is-ready')) setOpen(true, false);
		};
		document.addEventListener('visibilitychange', back);
		back();
	}

	// ----- Tiny DOM helpers -----------------------------------
	function byData(name: string): HTMLElement {
		return document.querySelector('[data-' + name + ']') as HTMLElement;
	}

	function showState(state: string) {
		document.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => {
			el.hidden = el.dataset.state !== state;
		});
	}
</script>

