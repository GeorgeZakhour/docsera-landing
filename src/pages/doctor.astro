---
// Doctor landing page — rendered for every /doctor/<token> URL.
//
// Routing: this file builds to dist/doctor/index.html. The companion
// nginx rule (see nginx/default.conf) maps any /doctor/<anything> URL
// to this file via try_files fallback, so a single static page handles
// every doctor's token without rebuilds when new doctors are added.
//
// The page renders a loading shell on the server, then a small inline
// script reads the token from window.location.pathname, queries the
// public_doctors view via Supabase REST (anon read access, RLS-gated),
// and populates the DOM with the appropriate state:
//
//   - loading    placeholder until the script runs
//   - doctor     valid token → profile card (skeleton first) + EntityCta
//   - not-found  token didn't match an active doctor
//   - invalid    URL path didn't contain a token, or token failed
//                the safety regex (alnum + - + _, max 64 chars)
//
// The CTA (install / open in app / web app) is wired from the URL alone and
// shown at once — it does not wait for the profile request. A patient who
// scans a clinic QR on a weak connection can still install and open the
// doctor even when the profile data never arrives; in that case the card
// says so and offers a retry instead of a dead-end "not found".

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import EntityCta from '../components/EntityCta.astro';
---

<Layout title="DocSera — ملف الطبيب" appBanner="entity" appBar={false}>
	<Navbar />

	<main class="doctor-page">
		<section class="doctor-section">
			<div class="container">

				<!-- Loading skeleton ------------------------------------ -->
				<div class="state state-loading" data-state="loading">
					<div class="spinner" aria-hidden="true"></div>
					<p>جارٍ تحميل بيانات الطبيب…</p>
				</div>

				<!-- Doctor preview + CTA -------------------------------- -->
				<div class="state state-doctor" data-state="doctor" hidden>
					<div class="doctor-card is-loading" data-doctor-card>
						<div class="doctor-photo">
							<!-- Initials fallback shown eagerly; the <img> is
							     stacked on top and only un-hides on successful
							     load. Avoids the "empty circle" intermediate
							     state if the image fetch is slow or fails. -->
							<div class="photo-fallback" data-doctor-fallback></div>
							<img data-doctor-image alt="" />
						</div>
						<div class="doctor-info">
							<span class="pill-badge specialty-badge" data-doctor-specialty></span>
							<h1 class="name" data-doctor-name></h1>
							<p class="clinic" data-doctor-clinic></p>
							<p class="address" data-doctor-address hidden>
								<svg class="pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
									<circle cx="12" cy="10" r="3"/>
								</svg>
								<span data-doctor-address-text></span>
							</p>
							<p class="card-offline" data-doctor-offline hidden>
								تعذّر تحميل بيانات الطبيب. تحقق من اتصالك بالإنترنت.
								<button type="button" data-doctor-retry>إعادة المحاولة</button>
							</p>
						</div>
					</div>

					<EntityCta kind="doctor" />
				</div>

				<!-- Doctor not found ----------------------------------- -->
				<div class="state state-not-found" data-state="not-found" hidden>
					<div class="error-card fade-up visible">
						<div class="error-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"/>
								<line x1="12" y1="8" x2="12" y2="12"/>
								<line x1="12" y1="16" x2="12.01" y2="16"/>
							</svg>
						</div>
						<h1>لم نعثر على هذا الطبيب</h1>
						<p>قد يكون الرابط منتهي الصلاحية أو حذف الطبيب ملفه. تحقق من الرابط وحاول مرة أخرى.</p>
						<a href="/" class="btn-main">العودة للرئيسية</a>
					</div>
				</div>

				<!-- Invalid token format ------------------------------- -->
				<div class="state state-invalid" data-state="invalid" hidden>
					<div class="error-card fade-up visible">
						<div class="error-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"/>
								<line x1="15" y1="9" x2="9" y2="15"/>
								<line x1="9" y1="9" x2="15" y2="15"/>
							</svg>
						</div>
						<h1>رابط غير صحيح</h1>
						<p>الرابط لا يحتوي على معرّف طبيب صالح. الرجاء العودة للرئيسية.</p>
						<a href="/" class="btn-main">العودة للرئيسية</a>
					</div>
				</div>

			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	import { SUPABASE_URL, SUPABASE_ANON_KEY, attributionSource, fireBeacon } from '../scripts/reach';
	import { initEntityCta } from '../scripts/entity-cta';

	// ----- Token extraction & validation ----------------------
	const match = window.location.pathname.match(/^\/doctor\/([^/?#]+)/);
	let token = '';
	try {
		token = match ? decodeURIComponent(match[1]) : '';
	} catch { /* malformed %-escape → invalid */ }

	// Same constraint the deep-link handler in the patient app uses
	// (services/navigation/deep_link_service.dart): alnum + - + _,
	// max 64 chars. Reject anything else as malformed.
	if (!/^[A-Za-z0-9_-]{1,64}$/.test(token)) {
		showState('invalid');
	} else {
		// Anonymous scan counter — counts landing opens even when the
		// visitor never installs the app.
		fireBeacon('doctor_qr_scanned', 'reach', 'ds_beacon_doctor_' + token, {
			token: token,
			source: attributionSource(),
			surface: 'landing',
		});
		// Buttons first, profile second.
		initEntityCta('doctor', token);
		showState('doctor');
		byData('doctor-retry').addEventListener('click', () => fetchDoctor(token));
		fetchDoctor(token);
	}

	function fetchDoctor(token: string) {
		setCardState('loading');

		// Only the columns we actually render — avoids pulling internal
		// fields from the view even though RLS already gates them.
		const select = [
			'id',
			'public_token',
			'first_name',
			'middle_name',
			'last_name',
			'title',
			'specialty',
			'specialties',
			'gender',
			'doctor_image',
			'clinic',
			'address',
		].join(',');

		const url = SUPABASE_URL + '/rest/v1/public_doctors' +
			'?select=' + encodeURIComponent(select) +
			'&public_token=eq.' + encodeURIComponent(token) +
			'&is_active=eq.true' +
			'&limit=1';

		// Slow networks: give up after 15 s and offer a retry rather than
		// leaving the card on its skeleton forever.
		const ctrl = new AbortController();
		const timer = window.setTimeout(() => ctrl.abort(), 15000);

		fetch(url, {
			headers: {
				apikey: SUPABASE_ANON_KEY,
				Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
			},
			signal: ctrl.signal,
		})
			.then((r) => {
				if (!r.ok) throw new Error('HTTP ' + r.status);
				return r.json();
			})
			.then((rows: any[]) => {
				if (!Array.isArray(rows) || rows.length === 0) {
					// The server answered and there is no such doctor.
					showState('not-found');
					return;
				}
				renderDoctor(rows[0]);
			})
			.catch((err) => {
				// Network failure, timeout or a server error: the token may
				// well be fine, so keep the CTA usable and say what happened.
				console.error('[doctor page] fetch failed:', err);
				setCardState('offline');
			})
			.finally(() => window.clearTimeout(timer));
	}

	function setCardState(state: 'loading' | 'ready' | 'offline') {
		const card = byData('doctor-card');
		card.classList.toggle('is-loading', state === 'loading');
		card.classList.toggle('is-offline', state === 'offline');
		byData('doctor-offline').hidden = state !== 'offline';
	}

	function renderDoctor(d: any) {
		const titlePart = (d.title || '').trim();
		const namePart = [d.first_name, d.middle_name, d.last_name]
			.map((s: any) => (s || '').trim())
			.filter(Boolean)
			.join(' ');
		const fullName = [titlePart, namePart].filter(Boolean).join(' ').trim();

		byData('doctor-name').textContent = fullName || 'طبيب';
		document.title = fullName ? (fullName + ' — DocSera') : 'DocSera — ملف الطبيب';

		const spec = d.specialty ||
			(Array.isArray(d.specialties) && d.specialties.length > 0
				? d.specialties[0]
				: '');
		byData('doctor-specialty').textContent = spec || 'طبيب';

		byData('doctor-clinic').textContent = d.clinic || '';

		// Address — formatted from the jsonb column, falls back gracefully
		// when fields are missing. Hidden entirely if no address at all.
		const addrText = formatAddress(d.address);
		if (addrText) {
			byData('doctor-address-text').textContent = addrText;
			byData('doctor-address').hidden = false;
		}

		renderImage(d, fullName);
		setCardState('ready');
	}

	function formatAddress(addr: any): string {
		if (!addr || typeof addr !== 'object') return '';
		// Compose "street، neighborhood، city" with whichever parts exist,
		// preferring the most specific. Strip neighborhood's parenthesised
		// detail so we don't end up with "المزة (فيلات، أوتوستراد، شيخ سعد)"
		// inline — the parens fight with the surrounding RTL comma-list.
		const street = (addr.street || '').trim();
		const rawHood = (addr.neighborhood || '').trim();
		const hood = rawHood.replace(/\s*\([^)]*\)\s*$/, '').trim();
		const city = (addr.city || '').trim();
		const parts: string[] = [];
		if (street) parts.push(street);
		if (hood && hood !== street && hood !== city) parts.push(hood);
		if (city) parts.push(city);
		return parts.join('، ');
	}

	function renderImage(d: any, fullName: string) {
		const img = byData('doctor-image') as HTMLImageElement;
		const fb = byData('doctor-fallback');

		// Always populate the fallback initials first, so the circle is
		// never blank even if the image hasn't started loading yet.
		fb.textContent = initialsFor(d);

		const path = (d.doctor_image || '').trim();
		if (!path) {
			img.hidden = true;
			return;
		}

		// Preserve slashes in the path (it's typically uuid/profile/file.ext)
		// while still escaping any unsafe characters within each segment.
		const url = SUPABASE_URL + '/storage/v1/object/public/doctor/' +
			path.split('/').map((seg: string) => encodeURIComponent(seg)).join('/');

		img.alt = fullName;
		img.onload = () => {
			// Reveal the image — it now sits on top of the initials fallback
			// (z-index in CSS), so the fallback is hidden visually.
			img.classList.add('is-loaded');
		};
		img.onerror = () => {
			img.hidden = true;
			// fallback initials are already populated and visible
		};
		img.src = url;
	}

	function initialsFor(d: any): string {
		const a = ((d.first_name || '').trim().charAt(0) || '');
		const b = ((d.last_name || '').trim().charAt(0) || '');
		return (a + b).toUpperCase() || '?';
	}

	// ----- Tiny DOM helpers -----------------------------------
	function byData(name: string): HTMLElement {
		return document.querySelector('[data-' + name + ']') as HTMLElement;
	}

	function showState(state: string) {
		document.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => {
			el.hidden = el.dataset.state !== state;
		});
	}
</script>

<style>
	main { overflow-x: hidden; }

	.doctor-section {
		padding: 140px 0 80px;
		min-height: 80vh;
		background: radial-gradient(circle at 10% 10%, #fff 0%, #FAFAFA 100%);
	}

	/* ----- States ----- */
	.state { text-align: center; }
	.state[hidden] { display: none !important; }

	/* Loading */
	.state-loading p { color: var(--c-text-muted); margin-top: 16px; }
	.spinner {
		width: 44px; height: 44px; margin: 0 auto;
		border: 3px solid var(--c-main-light);
		border-top-color: var(--c-main);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}
	@keyframes spin { to { transform: rotate(360deg); } }

	/* Doctor card */
	.doctor-card {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 32px;
		align-items: center;
		background: white;
		padding: 36px;
		border-radius: 28px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.05);
		margin: 0 auto 24px;
		max-width: 720px;
		text-align: right;
	}

	/* Photo with initials-first fallback strategy.
	   Stack: fallback initials at z-index 1, <img> at z-index 2.
	   The img is invisible by default (opacity 0) so the fallback shows
	   through; on successful load .is-loaded sets opacity 1, covering it. */
	.doctor-photo {
		width: 128px; height: 128px;
		border-radius: 50%;
		overflow: hidden;
		position: relative;
		flex-shrink: 0;
		background: var(--c-main-light);
	}
	.doctor-photo img {
		position: absolute; inset: 0;
		width: 100%; height: 100%;
		object-fit: cover;
		display: block;
		z-index: 2;
		opacity: 0;
		transition: opacity 0.25s ease-out;
	}
	.doctor-photo img.is-loaded { opacity: 1; }
	.photo-fallback {
		position: absolute; inset: 0;
		display: flex; align-items: center; justify-content: center;
		font-family: var(--font-en);
		font-size: 2.2rem;
		font-weight: 700;
		color: var(--c-main);
		background: var(--c-main-light);
		z-index: 1;
	}
	.doctor-info .pill-badge {
		display: inline-block;
		background: rgba(0, 144, 146, 0.1);
		color: var(--c-main);
		padding: 6px 14px;
		border-radius: 20px;
		font-weight: 700;
		font-size: 0.85rem;
		margin-bottom: 10px;
	}
	.doctor-info .name {
		font-size: clamp(1.5rem, 3.2vw, 2rem);
		font-weight: 800;
		line-height: 1.2;
		margin: 0 0 8px;
		color: var(--c-text);
	}
	.doctor-info .clinic {
		color: var(--c-text-muted);
		font-size: 1rem;
		margin: 0 0 6px;
	}
	.doctor-info .address {
		color: var(--c-text-muted);
		font-size: 0.92rem;
		margin: 6px 0 0;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		line-height: 1.4;
	}
	.doctor-info .address[hidden] { display: none; }
	.doctor-info .address .pin {
		width: 14px; height: 14px;
		color: var(--c-main);
		flex-shrink: 0;
	}

	/* Skeleton while the profile request is in flight. The CTA below is
	   already live, so this is only the card's own text. */
	.doctor-card.is-loading .pill-badge,
	.doctor-card.is-loading .name,
	.doctor-card.is-loading .clinic {
		display: block;
		color: transparent;
		background: #EEF4F4;
		border-radius: 8px;
		animation: card-pulse 1.1s ease-in-out infinite alternate;
	}
	.doctor-card.is-loading .pill-badge { width: 92px; height: 28px; }
	.doctor-card.is-loading .name { width: min(260px, 70vw); height: 1.25em; }
	.doctor-card.is-loading .clinic { width: min(170px, 48vw); height: 1em; }
	@keyframes card-pulse { from { opacity: 1; } to { opacity: 0.45; } }

	/* Profile request failed (weak connection). Buttons below still work. */
	.doctor-card.is-offline .pill-badge,
	.doctor-card.is-offline .name,
	.doctor-card.is-offline .clinic { display: none; }
	.card-offline {
		margin: 0;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--c-text-muted);
	}
	.card-offline button {
		display: block;
		margin-top: 10px;
		padding: 0;
		background: none;
		border: 0;
		font: inherit;
		font-weight: 700;
		color: var(--c-main);
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.card-offline button:focus-visible { outline: 3px solid var(--c-main); outline-offset: 3px; border-radius: 4px; }

	.btn-main {
		background: var(--c-main);
		color: white;
		padding: 14px 32px;
		border-radius: 12px;
		font-weight: 700;
		text-decoration: none;
		display: inline-block;
		font-size: 1rem;
		transition: background 0.2s;
	}
	.btn-main:hover { background: var(--c-main-dark); }

	/* Error states */
	.error-card {
		background: white;
		padding: 60px 40px;
		border-radius: 28px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.04);
		max-width: 540px;
		margin: 0 auto;
	}
	.error-card h1 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0 0 14px;
		color: var(--c-text);
	}
	.error-card p {
		color: var(--c-text-muted);
		margin: 0 0 28px;
		font-size: 1rem;
		line-height: 1.6;
	}
	.error-icon {
		width: 64px;
		height: 64px;
		margin: 0 auto 22px;
		color: var(--c-main);
		opacity: 0.85;
	}
	.error-icon svg { width: 100%; height: 100%; }

	@media (max-width: 700px) {
		.doctor-section { padding: 100px 0 60px; }
		.doctor-card {
			grid-template-columns: 1fr;
			text-align: center;
			justify-items: center;
			padding: 28px 22px;
			gap: 20px;
		}
		.doctor-info { text-align: center; }
		.doctor-info .address { display: inline-flex; justify-content: center; }
		.doctor-photo { width: 108px; height: 108px; }
		.photo-fallback { font-size: 1.8rem; }
		.doctor-card.is-loading .pill-badge,
		.doctor-card.is-loading .name,
		.doctor-card.is-loading .clinic { margin-inline: auto; }
		.card-offline button { margin-inline: auto; }
	}
	@media (prefers-reduced-motion: reduce) {
		.doctor-card.is-loading .pill-badge,
		.doctor-card.is-loading .name,
		.doctor-card.is-loading .clinic { animation: none; }
	}
</style>
