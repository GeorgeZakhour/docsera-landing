---
// Doctor landing page, rendered for every /doctor/<token> URL: what a patient sees after
// scanning the clinic's QR. A quiet profile card with one action.
//
// Routing: this file builds to dist/doctor/index.html. The companion nginx rule (see
// nginx/default.conf) maps any /doctor/<anything> URL to this file via try_files, so a
// single static page handles every doctor's token without rebuilds.
//
// The page renders a loading shell, then the script reads the token from the path, queries
// the public_doctors view (anon read, RLS-gated) and shows one of these states:
//
//   - loading    placeholder until the script runs
//   - doctor     valid token → profile (skeleton first) + EntityCta
//   - not-found  token didn't match an active doctor
//   - invalid    no token in the path, or it failed the safety regex (alnum + - + _, max 64)
//
// The CTA (install / open in app / web app) is wired from the URL alone and works at once;
// it does not wait for the profile. A patient on a weak connection can still install and
// open the doctor even when the profile never arrives: the card says so and offers a retry.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import EntityCta from '../components/EntityCta.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
---

<Layout title="DocSera — ملف الطبيب" appBanner="entity" appBar={false}>
	<SiteHeader />

	<main class="dp">
		<div class="state state-loading" data-state="loading">
			<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<p>جارٍ تحميل بيانات الطبيب…</p>
		</div>

		<div class="state state-doctor" data-state="doctor" hidden>
			<div class="dp-grid">
				<article class="dp-main is-loading" data-doctor-card>
					<header class="dp-id">
						<div class="photo">
							<div class="photo-fallback" data-doctor-fallback></div>
							<img data-doctor-image alt="" />
						</div>
						<h1 class="name" data-doctor-name></h1>
						<p class="spec" data-doctor-specialty></p>
						<p class="ok" data-doctor-verified hidden>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.6 4.6L19 7.6" /></svg>
							طبيب موثّق
						</p>
						<p class="card-offline" data-doctor-offline hidden>
							تعذّر تحميل بيانات الطبيب. تحقق من اتصالك بالإنترنت.
							<button type="button" data-doctor-retry>إعادة المحاولة</button>
						</p>
					</header>

					<section class="row" data-row="bio" hidden>
						<h2>نبذة</h2>
						<div>
							<p class="bio" data-doctor-bio></p>
							<button type="button" class="more" data-bio-more hidden>اقرأ المزيد</button>
						</div>
					</section>
					<section class="row" data-row="place" hidden>
						<h2>المكان</h2>
						<div class="place">
							<b data-doctor-clinic></b>
							<span data-doctor-address-text></span>
						</div>
					</section>
					<section class="row" data-row="hours" hidden>
						<h2>ساعات العمل</h2>
						<div>
							<p class="today"><span>اليوم</span> <b data-doctor-today></b></p>
							<details class="week">
								<summary>كل أيام الأسبوع</summary>
								<dl data-doctor-week></dl>
							</details>
						</div>
					</section>
					<section class="row" data-row="services" hidden>
						<h2>الخدمات</h2>
						<div>
							<ul class="svc" data-doctor-services></ul>
							<button type="button" class="more" data-svc-more hidden>عرض الكل</button>
						</div>
					</section>
					<section class="row" data-row="langs" hidden>
						<h2>اللغات</h2>
						<p class="plain" data-doctor-langs></p>
					</section>
				</article>

				<aside class="bk" data-book-sheet>
					<button type="button" class="bk-x" data-book-close aria-label="إغلاق" title="إغلاق">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
					</button>
					<EntityCta kind="doctor" quiet />
				</aside>
			</div>
			<div class="bk-scrim" data-book-scrim></div>
			<div class="bk-bar"><button type="button" data-book-open>احجز موعداً</button></div>
		</div>

		<div class="state state-msg" data-state="not-found" hidden>
			<h1>لم نعثر على هذا الطبيب</h1>
			<p>قد يكون الرابط منتهي الصلاحية أو حذف الطبيب ملفه. تحقق من الرابط وحاول مرة أخرى.</p>
			<a href="/" class="btn-main">العودة للرئيسية</a>
		</div>

		<div class="state state-msg" data-state="invalid" hidden>
			<h1>رابط غير صحيح</h1>
			<p>الرابط لا يحتوي على معرّف طبيب صالح. الرجاء العودة للرئيسية.</p>
			<a href="/" class="btn-main">العودة للرئيسية</a>
		</div>
	</main>

	<Footer seamless />
</Layout>

<script>
	import { SUPABASE_URL, SUPABASE_ANON_KEY, attributionSource, fireBeacon } from '../scripts/reach';
	import { initEntityCta } from '../scripts/entity-cta';

	// Local previews only: a fictional doctor at /doctor/?preview=1. The flag exists only in
	// the untracked .env.local, so a production build drops this path entirely.
	const demo = import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && new URLSearchParams(window.location.search).has('preview');

	// ----- Token extraction & validation ----------------------
	const match = window.location.pathname.match(/^\/doctor\/([^/?#]+)/);
	let token = '';
	try {
		token = match ? decodeURIComponent(match[1]) : '';
	} catch { /* malformed %-escape → invalid */ }
	if (import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && demo) token = 'preview';

	// Same constraint the deep-link handler in the patient app uses
	// (services/navigation/deep_link_service.dart): alnum + - + _,
	// max 64 chars. Reject anything else as malformed.
	if (!/^[A-Za-z0-9_-]{1,64}$/.test(token)) {
		showState('invalid');
	} else {
		// Anonymous scan counter: counts landing opens even when the
		// visitor never installs the app.
		if (!demo) {
			fireBeacon('doctor_qr_scanned', 'reach', 'ds_beacon_doctor_' + token, {
				token: token,
				source: attributionSource(),
				surface: 'landing',
			});
		}
		// Buttons first, profile second.
		initEntityCta('doctor', token);
		showState('doctor');
		wireSheet();
		byData('doctor-retry').addEventListener('click', () => fetchDoctor(token));
		fetchDoctor(token);
	}

	function fetchDoctor(token: string) {
		setCardState('loading');

		if (import.meta.env.PUBLIC_DOCTOR_PREVIEW === '1' && demo) {
			import('../data/doctorPreview').then((m) => window.setTimeout(() => renderDoctor(m.DOCTOR_PREVIEW), 420));
			return;
		}

		// Only the columns we actually render: avoids pulling internal
		// fields from the view even though RLS already gates them.
		const select = [
			'id',
			'public_token',
			'first_name',
			'middle_name',
			'last_name',
			'title',
			'specialty',
			'specialties',
			'gender',
			'doctor_image',
			'clinic',
			'address',
			'profile_description',
			'opening_hours',
			'offered_services',
			'languages',
			'verification_status',
		].join(',');

		const url = SUPABASE_URL + '/rest/v1/public_doctors' +
			'?select=' + encodeURIComponent(select) +
			'&public_token=eq.' + encodeURIComponent(token) +
			'&is_active=eq.true' +
			'&limit=1';

		// Slow networks: give up after 15 s and offer a retry rather than
		// leaving the card on its skeleton forever.
		const ctrl = new AbortController();
		const timer = window.setTimeout(() => ctrl.abort(), 15000);

		fetch(url, {
			headers: {
				apikey: SUPABASE_ANON_KEY,
				Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
			},
			signal: ctrl.signal,
		})
			.then((r) => {
				if (!r.ok) throw new Error('HTTP ' + r.status);
				return r.json();
			})
			.then((rows: any[]) => {
				if (!Array.isArray(rows) || rows.length === 0) {
					// The server answered and there is no such doctor.
					showState('not-found');
					return;
				}
				renderDoctor(rows[0]);
			})
			.catch((err) => {
				// Network failure, timeout or a server error: the token may
				// well be fine, so keep the CTA usable and say what happened.
				console.error('[doctor page] fetch failed:', err);
				setCardState('offline');
			})
			.finally(() => window.clearTimeout(timer));
	}

	function setCardState(state: 'loading' | 'ready' | 'offline') {
		const card = byData('doctor-card');
		card.classList.toggle('is-loading', state === 'loading');
		card.classList.toggle('is-offline', state === 'offline');
		card.classList.toggle('is-ready', state === 'ready');
		byData('doctor-offline').hidden = state !== 'offline';
	}

	function renderDoctor(d: any) {
		const titlePart = (d.title || '').trim();
		const namePart = [d.first_name, d.middle_name, d.last_name]
			.map((s: any) => (s || '').trim())
			.filter(Boolean)
			.join(' ');
		const fullName = [titlePart, namePart].filter(Boolean).join(' ').trim();

		byData('doctor-name').textContent = fullName || 'طبيب';
		document.title = fullName ? (fullName + ' — DocSera') : 'DocSera — ملف الطبيب';

		const spec = d.specialty ||
			(Array.isArray(d.specialties) && d.specialties.length > 0
				? d.specialties[0]
				: '');
		byData('doctor-specialty').textContent = spec || 'طبيب';
		byData('doctor-verified').hidden = d.verification_status !== 'verified';

		renderBio(d.profile_description);
		renderPlace(d);
		renderHours(d.opening_hours);
		renderServices(d.offered_services);
		renderLanguages(d.languages);
		renderImage(d, fullName);
		setCardState('ready');
		revealRows();
	}

	function showRow(name: string, on: boolean) {
		const row = document.querySelector<HTMLElement>(`[data-row="${name}"]`);
		if (row) row.hidden = !on;
	}

	// ----- Sections: each one stays hidden when the doctor left it empty ----------
	function bioText(value: any): string {
		let d = value;
		if (typeof d === 'string') {
			try { d = JSON.parse(d); } catch { return d.trim(); }
		}
		const ops = (x: any) => (Array.isArray(x) ? x : (x?.ops || []))
			.map((o: any) => (typeof o?.insert === 'string' ? o.insert : ''))
			.join('');
		if (Array.isArray(d?.parts)) return d.parts.map((p: any) => ops(p?.delta).trim()).filter(Boolean).join('\n\n');
		return ops(d).trim();
	}

	function renderBio(value: any) {
		const text = bioText(value);
		showRow('bio', !!text);
		if (!text) return;
		const el = byData('doctor-bio'), more = byData('bio-more');
		el.textContent = text;
		more.hidden = text.length < 230;
		el.classList.toggle('short', text.length >= 230);
		more.onclick = () => { el.classList.remove('short'); more.hidden = true; };
	}

	function renderPlace(d: any) {
		const clinic = (d.clinic || '').trim(), addr = formatAddress(d.address);
		byData('doctor-clinic').textContent = clinic;
		byData('doctor-clinic').hidden = !clinic;
		byData('doctor-address-text').textContent = addr;
		showRow('place', !!(clinic || addr));
	}

	function formatAddress(addr: any): string {
		if (!addr || typeof addr !== 'object') return '';
		// «street، zone، city». `street` is what the doctor typed; `neighborhood`
		// is the search zone he picked for the patient app's area filter — since
		// Pro doc 140 a required choice from the city's list, or a name he typed
		// under «أخرى» — so it is printed inside the address, between the street
		// and the city. It is left out when the street already names it
		// («شارع القصاع» + «القصاع» prints once) or when it is the city itself;
		// the city is left out when it equals the street.
		const street = (addr.street || '').trim();
		const zone = (addr.neighborhood || '').trim();
		const city = (addr.city || '').trim();
		const parts: string[] = [];
		if (street) parts.push(street);
		if (zone && !street.includes(zone) && zone !== city) parts.push(zone);
		if (city && city !== street) parts.push(city);
		return parts.join('، ');
	}

	const DAYS: [string, string][] = [['sat', 'السبت'], ['sun', 'الأحد'], ['mon', 'الاثنين'], ['tue', 'الثلاثاء'], ['wed', 'الأربعاء'], ['thu', 'الخميس'], ['fri', 'الجمعة']];
	function clock(t: string): string {
		const [h, m] = String(t).split(':').map(Number);
		if (!Number.isFinite(h)) return '';
		const pm = h >= 12 && h < 24;
		return `${h % 12 || 12}:${String(m || 0).padStart(2, '0')} ${pm ? 'م' : 'ص'}`;
	}
	function ranges(list: any): string {
		if (!Array.isArray(list)) return '';
		return list.map((x: any) => (x?.from && x?.to ? `${clock(x.from)} – ${clock(x.to)}` : '')).filter(Boolean).join('،  ');
	}
	function renderHours(hours: any) {
		const any = !!hours && typeof hours === 'object' && DAYS.some(([k]) => ranges(hours[k]));
		showRow('hours', any);
		if (!any) return;
		const now = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Damascus', weekday: 'short' }).format(new Date()).toLowerCase();
		byData('doctor-today').textContent = ranges(hours[now]) || 'مغلق';
		const week = byData('doctor-week');
		week.replaceChildren();
		DAYS.forEach(([key, label]) => {
			const line = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd');
			if (key === now) line.className = 'is-today';
			dt.textContent = label;
			dd.textContent = ranges(hours[key]) || 'مغلق';
			line.append(dt, dd);
			week.append(line);
		});
	}

	function serviceTitles(v: any): string[] {
		let d = v;
		if (typeof d === 'string') {
			try { d = JSON.parse(d); } catch { return []; }
		}
		if (Array.isArray(d)) return d.map((x: any) => (typeof x === 'string' ? x : x?.title || '')).map((s: string) => s.trim()).filter(Boolean);
		if (d && typeof d === 'object') return Object.keys(d).map((s) => s.trim()).filter(Boolean);
		return [];
	}
	function renderServices(v: any) {
		const items = serviceTitles(v);
		showRow('services', items.length > 0);
		if (!items.length) return;
		const ul = byData('doctor-services'), more = byData('svc-more');
		const draw = (list: string[]) => ul.replaceChildren(...list.map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
		draw(items.slice(0, 5));
		more.hidden = items.length <= 5;
		more.onclick = () => { draw(items); more.hidden = true; };
	}

	const LANGS: Record<string, string> = { ar: 'العربية', en: 'الإنجليزية', fr: 'الفرنسية', de: 'الألمانية', ru: 'الروسية', tr: 'التركية', es: 'الإسبانية', it: 'الإيطالية', fa: 'الفارسية', ku: 'الكردية', hy: 'الأرمنية' };
	function renderLanguages(v: any) {
		const list = (Array.isArray(v) ? v : []).map((x: any) => String(x).trim()).filter(Boolean).map((x: string) => LANGS[x.toLowerCase()] || x);
		showRow('langs', list.length > 0);
		byData('doctor-langs').textContent = list.join('، ');
	}

	function renderImage(d: any, fullName: string) {
		const img = byData('doctor-image') as HTMLImageElement;
		const fb = byData('doctor-fallback');

		// Always populate the fallback initials first, so the circle is
		// never blank even if the image hasn't started loading yet.
		fb.textContent = initialsFor(d);

		const path = (d.doctor_image || '').trim();
		if (!path) {
			img.hidden = true;
			return;
		}

		// Preserve slashes in the path (it's typically uuid/profile/file.ext)
		// while still escaping any unsafe characters within each segment.
		const url = path.startsWith('/images/') && demo ? path : SUPABASE_URL + '/storage/v1/object/public/doctor/' +
			path.split('/').map((seg: string) => encodeURIComponent(seg)).join('/');

		img.alt = fullName;
		img.onload = () => {
			// Reveal the image: it now sits on top of the initials fallback.
			img.classList.add('is-loaded');
		};
		img.onerror = () => {
			img.hidden = true;
			// fallback initials are already populated and visible
		};
		img.src = url;
	}

	function initialsFor(d: any): string {
		const a = ((d.first_name || '').trim().charAt(0) || '');
		const b = ((d.last_name || '').trim().charAt(0) || '');
		return (a + b).toUpperCase() || '?';
	}

	// ----- The sections arrive quietly, each with its hairline ----
	function revealRows() {
		const rows = Array.from(document.querySelectorAll<HTMLElement>('.row:not([hidden])'));
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) { rows.forEach((r) => r.classList.add('in')); return; }
		const io = new IntersectionObserver((es) => es.forEach((e) => {
			if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
		}), { rootMargin: '0px 0px -6% 0px' });
		rows.forEach((r, i) => { r.style.setProperty('--d', `${Math.min(i, 3) * 70}ms`); io.observe(r); });
	}

	// ----- On a phone the booking steps rise as a sheet ------------
	function wireSheet() {
		const sheet = document.querySelector<HTMLElement>('[data-book-sheet]')!;
		const scrim = document.querySelector<HTMLElement>('[data-book-scrim]')!;
		const openBtn = document.querySelector<HTMLElement>('[data-book-open]')!;
		const closeBtn = document.querySelector<HTMLElement>('[data-book-close]')!;
		const narrow = matchMedia('(max-width: 899px)');
		const setOpen = (on: boolean, focus = true) => {
			sheet.classList.toggle('open', on);
			scrim.classList.toggle('open', on);
			document.documentElement.classList.toggle('bk-lock', on);
			if (on) { sheet.setAttribute('role', 'dialog'); sheet.setAttribute('aria-modal', 'true'); sheet.setAttribute('aria-label', 'احجز موعداً'); }
			else { sheet.removeAttribute('role'); sheet.removeAttribute('aria-modal'); sheet.removeAttribute('aria-label'); }
			if (focus) (on ? closeBtn : openBtn).focus();
		};
		openBtn.addEventListener('click', () => setOpen(true));
		closeBtn.addEventListener('click', () => setOpen(false));
		scrim.addEventListener('click', () => setOpen(false));
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet.classList.contains('open')) setOpen(false); });
		narrow.addEventListener('change', () => { if (!narrow.matches && sheet.classList.contains('open')) setOpen(false, false); });
		// Back from the store, step 2 is the thing to press: bring it back.
		const back = () => {
			if (narrow.matches && document.visibilityState === 'visible' && sheet.querySelector('[data-step-open].is-ready')) setOpen(true, false);
		};
		document.addEventListener('visibilitychange', back);
		back();
	}

	// ----- Tiny DOM helpers -----------------------------------
	function byData(name: string): HTMLElement {
		return document.querySelector('[data-' + name + ']') as HTMLElement;
	}

	function showState(state: string) {
		document.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => {
			el.hidden = el.dataset.state !== state;
		});
	}
</script>

<style>
	.dp { --paper: #F8F9F6; --ink: #12282C; --soft: #5E6E71; --hair: rgba(18, 40, 44, .14); min-height: 100vh; min-height: 100svh; box-sizing: border-box; padding: clamp(104px, 13vh, 136px) 24px 88px; color: var(--ink); background: var(--paper); }
	.state[hidden], [hidden] { display: none !important; }

	.state-loading { padding-top: 22vh; text-align: center; color: var(--soft); }
	.state-loading p { margin: 16px 0 0; font-size: 1rem; }
	.dots { display: inline-flex; gap: 7px; }
	.dots i { width: 6px; height: 6px; background: var(--c-main-dark); border-radius: 50%; animation: dot 1.1s ease-in-out infinite; }
	.dots i:nth-child(2) { animation-delay: .14s; }
	.dots i:nth-child(3) { animation-delay: .28s; }
	@keyframes dot { 0%, 100% { opacity: .2; } 50% { opacity: 1; } }

	.dp-grid { display: grid; grid-template-columns: minmax(0, 1fr) 372px; align-items: start; gap: clamp(48px, 7vw, 108px); max-width: 1120px; margin: 0 auto; }

	/* who */
	.dp-id { padding-bottom: clamp(30px, 4vw, 44px); }
	.photo { position: relative; width: 132px; height: 132px; margin-bottom: 26px; overflow: hidden; background: #E6F1EF; border-radius: 50%; box-shadow: 0 0 0 1px var(--hair), 0 0 0 7px var(--paper), 0 0 0 8px rgba(0, 116, 116, .22); }
	.photo img { position: absolute; z-index: 2; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 8%; opacity: 0; transition: opacity .5s ease; }
	.photo img.is-loaded { opacity: 1; }
	.photo-fallback { position: absolute; z-index: 1; inset: 0; display: grid; place-items: center; font-size: 2.3rem; font-weight: 400; color: var(--c-main-dark); }
	.name { margin: 0; font-size: clamp(2.1rem, 4.5vw, 3.6rem); font-weight: 400; line-height: 1.35; color: var(--ink); text-wrap: balance; }
	.spec { margin: 4px 0 0; font-size: clamp(1.14rem, 1.7vw, 1.34rem); font-weight: 600; line-height: 1.6; color: var(--c-main-dark); }
	.ok { display: inline-flex; align-items: center; gap: 6px; margin: 10px 0 0; font-size: .98rem; line-height: 1.6; color: var(--soft); }
	.ok svg { width: 16px; height: 16px; fill: none; stroke: var(--c-main-dark); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

	.dp-main.is-loading .name, .dp-main.is-loading .spec { width: min(300px, 74%); color: transparent; background: #ECEFEB; border-radius: 8px; animation: pulse 1.2s ease-in-out infinite alternate; }
	.dp-main.is-loading .name { height: 1.2em; }
	.dp-main.is-loading .spec { width: min(160px, 44%); height: 1.1em; margin-top: 14px; }
	@keyframes pulse { from { opacity: 1; } to { opacity: .5; } }
	.dp-main.is-offline .name, .dp-main.is-offline .spec { display: none; }
	.dp-main.is-ready .dp-id > * { animation: rise .8s cubic-bezier(.2, .7, .2, 1) both; }
