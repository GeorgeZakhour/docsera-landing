---
// PREVIEW (branch site-v2): the home page as one story, «أربع بتلات». The DocSera
// mark has four petals and the app four great things: each petal opens a world.
// Every phone screen is the real 1.1.0 app with fake data; nothing switched off
// on production is shown, and no doctor counts. Without JS or with reduced motion
// the same content is a plain column.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Closing from '../components/home/Closing.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { WEB_APP_URL } from '../config/links';
import bootUrl from '../scripts/home/boot.ts?worker&url';

const PAPERS = [
	{ label: 'تحليل دم شامل', kind: 'lines' },
	{ label: 'صورة أشعة الصدر', kind: 'xray' },
	{ label: 'تقرير المتابعة', kind: 'lines' },
	{ label: 'وصفة', kind: 'rx' },
	{ label: 'بطاقة التأمين', kind: 'card' },
	{ label: 'نتيجة التحليل', kind: 'lines' },
];

const CHAPTERS = [
	{ key: 'ملفك', title: 'ملفك الطبي، بلا أوراق', text: 'تقاريرك وتحاليلك وصور الأشعة وأدويتك، مرتّبة في مكان واحد.', shot: '/images/app110/health-640.webp' },
	{ key: 'روتيني', title: 'لا تنسَ جرعة بعد اليوم', text: 'تذكير في وقت كل جرعة حتى دون إنترنت، ولأدوية أهلك أيضاً.', shot: '/images/app110/routine-640.webp' },
	{ key: 'حجزك', title: 'موعدك بلمسات', text: 'ابحث عن طبيبك، وشاهد أقرب المواعيد المتاحة، واحجز مباشرة.', shot: '/images/app110/booking-640.webp' },
	{ key: 'طبيبك', title: 'ملفك بإذنك', text: 'لا يطّلع طبيب على ملفك إلا برمز تعطيه له، وتسحبه متى شئت.', shot: '/images/app110/share-390.webp' },
];

const SHOTS = [
	'/images/app110/home-640.webp', '/images/app110/health-640.webp', '/images/app110/routine-640.webp', '/images/app110/results-640.webp',
	'/images/app110/booking-640.webp', '/images/home/confirmed.webp', '/images/app110/share-390.webp',
];

// The booking map: one city on a 1600×1000 canvas, so it keeps the same scale on a
// phone and on a wide screen. Streets bend together; every pin stands on a crossing.
const warp = (x: number, y: number): [number, number] => [
	x + 26 * Math.sin(y / 190 + 0.6) + y * 0.09 - 40,
	y + 20 * Math.sin(x / 240 + 1.4) - x * 0.06 + 46,
];
const curve = (raw: [number, number][]) => {
	const p = raw.map(([x, y]) => warp(x, y));
	let d = `M${p[0][0].toFixed(0)} ${p[0][1].toFixed(0)}`;
	for (let i = 0; i < p.length - 1; i++) {
		const a = p[Math.max(0, i - 1)], b = p[i], c = p[i + 1], e = p[Math.min(p.length - 1, i + 2)];
		d += `C${(b[0] + (c[0] - a[0]) / 6).toFixed(0)} ${(b[1] + (c[1] - a[1]) / 6).toFixed(0)} ${(c[0] - (e[0] - b[0]) / 6).toFixed(0)} ${(c[1] - (e[1] - b[1]) / 6).toFixed(0)} ${c[0].toFixed(0)} ${c[1].toFixed(0)}`;
	}
	return d;
};
const down = (x: number) => curve([0, 1, 2, 3, 4, 5].map((k) => [x, -120 + k * 260] as [number, number]));
const across = (y: number) => curve([0, 1, 2, 3, 4, 5, 6, 7].map((k) => [-140 + k * 280, y] as [number, number]));
const AVENUES = [110, 340, 600, 860, 1130, 1400], CROSS = [90, 300, 520, 740, 940];
const LANES_X = [225, 470, 730, 995, 1265, 1520], LANES_Y = [195, 410, 630, 845];
const ROADS = [...AVENUES.map(down), ...CROSS.map(across), curve([[-120, 960], [300, 800], [700, 610], [1100, 380], [1720, 80]])];
const STREETS = [...LANES_X.map(down), ...LANES_Y.map(across)];
const ALLEYS = LANES_X.flatMap((x, i) => LANES_Y.map((y, j) => {
	const [a, b] = warp(x + ((i + j) % 2 ? 58 : -58), y), [c, e] = warp(x + ((i + j) % 2 ? 58 : -58), y + 104);
	return `M${a.toFixed(0)} ${b.toFixed(0)}L${c.toFixed(0)} ${e.toFixed(0)}`;
})).join('');
const RIVER = curve([[-160, 650], [240, 700], [620, 560], [1000, 470], [1360, 300], [1760, 250]]);
const PARKS = [[[245, 320], [445, 320], [445, 500], [245, 500]], [[880, 760], [1100, 760], [1100, 920], [880, 920]], [[620, 110], [840, 110], [840, 280], [620, 280]]]
	.map((q) => 'M' + q.map(([x, y]) => warp(x, y).map((n) => n.toFixed(0)).join(' ')).join('L') + 'Z');
const PINS = [[340, 300], [110, 520], [225, 740], [470, 195], [600, 630], [860, 300], [730, 845], [995, 520], [860, 740], [1130, 195]].map(([x, y]) => warp(x, y));

const TRY = [
	['الرئيسية', '/images/app110/home-640.webp'], ['البحث', '/images/home/search.webp'], ['الطبيب', '/images/home/doctor.webp'],
	['الحجز', '/images/app110/booking-640.webp'], ['مواعيدي', '/images/home/appointments.webp'], ['ملفي', '/images/app110/health-640.webp'],
	['التقارير', '/images/app110/wall/reports-390.webp'], ['الأدوية', '/images/app110/wall/medications-390.webp'],
	['القياسات', '/images/app110/wall/vitals-390.webp'], ['روتيني', '/images/app110/routine-640.webp'],
	['الرسائل', '/images/home/chat.webp'], ['العائلة', '/images/home/relatives.webp'],
];

const WALL = [
	['reports', 'vaccines', 'messages', 'booking'], ['medications', 'offers', 'doctor', 'family'],
	['vitals', 'search', 'appointments', 'surgeries'], ['allergies', 'notifications', 'wallet', 'relatives'],
	['documents', 'chronic', 'vouchers', 'confirmed'],
];
const MORE = [
	['الأقارب', 'الرسائل', 'الوصفات', 'التحاليل', 'صور الأشعة', 'اللقاحات', 'الحساسيات', 'العمليات', 'الأمراض المزمنة', 'التاريخ العائلي', 'نمط الحياة'],
	['تذكير الفحوصات', 'أداة الشاشة الرئيسية', 'الأطباء المفضلون', 'تأجيل المواعيد', 'إضافة إلى التقويم', 'العروض والقسائم', 'النقاط والمكافآت', 'الدخول بالبصمة', 'الآيباد والويب', 'العربية والإنجليزية'],
];
---

<Layout
	title="DocSera — دوكسيرا | كل صحتك في تطبيق واحد"
	description="دوكسيرا: ملفك الطبي، وتذكير أدويتك، وحجز مواعيدك، والتواصل مع طبيبك في تطبيق واحد."
	path="/"
	appBar={false}
	homeFonts
>
	<script is:inline>
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('story');
	</script>

	<header class="h">
		<a href="/" class="h-logo" aria-label="DocSera"><img src="/images/docsera_main.svg" alt="DocSera" width="101" height="16" /></a>
		<nav class="h-nav" aria-label="الأقسام">
			<a href="/features">عن التطبيق</a><a href="/about">من نحن</a><a href="/help">المساعدة</a><a href="/pro">للأطباء</a>
		</nav>
		<a href="/download" class="h-cta">حمّل التطبيق</a>
	</header>

	<main class="m">
		<section class="st" data-story>
			<div class="stick" data-stick>
				<div class="bg bg-hero" data-bg-hero aria-hidden="true"><img class="silk" data-late="/images/home/3d/silk-860.webp 860w, /images/home/3d/silk-1600.webp 1600w" sizes="max(100vw, 160vh)" alt="" width="1600" height="1000" decoding="async" /></div>
				<div class="bg bg-dusk" data-dusk aria-hidden="true"></div>
				<div class="bg bg-twi" data-twi aria-hidden="true"></div>
				<div class="bg bg-night" data-night aria-hidden="true"></div>
				<div class="bg bg-silk" data-silk aria-hidden="true"><img class="silk" data-vault-src="/images/home/3d/silk-860.webp 860w, /images/home/3d/silk-1600.webp 1600w" sizes="max(100vw, 160vh)" alt="" width="1600" height="1000" decoding="async" /></div>
				<div class="sun fx" data-sun aria-hidden="true"><i class="disc" data-sun-disc></i><i class="moon" data-moon-disc></i></div>

				<svg class="map fx" data-map viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
					<path class="map-river" d={RIVER} />
					{PARKS.map((d) => <path class="map-park" d={d} />)}
					<path class="map-alley" d={ALLEYS} />
					{STREETS.map((d) => <path class="map-street" data-road d={d} pathLength="1" />)}
					{ROADS.map((d) => <path class="map-road" data-road d={d} pathLength="1" />)}
					{PINS.map(([x, y]) => (
						<g transform={`translate(${x.toFixed(0)} ${y.toFixed(0)})`}><g class="pin" data-pin><ellipse class="pin-sh" cy="1" rx="10" ry="3.6" /><path class="pin-b" d="M0 0C-3-8-16-14-16-27a16 16 0 1 1 32 0C16-14 3-8 0 0z" /><circle class="pin-d" cy="-27" r="6" /></g></g>
					))}
				</svg>

				<div class="a-dial" data-a-dial aria-hidden="true"></div>
				<div class="a-vault" data-a-vault aria-hidden="true"></div>
				<div class="vault fx" data-vault aria-hidden="true">
					<img data-vault-src="/images/home/3d/vault-base-420.webp 420w, /images/home/3d/vault-base-760.webp 760w" sizes="(max-width: 899px) 180px, 340px" alt="" width="760" height="760" decoding="async" />
					<img class="v-dial" data-vault-dial data-vault-src="/images/home/3d/vault-dial-420.webp 420w, /images/home/3d/vault-dial-760.webp 760w" sizes="(max-width: 899px) 180px, 340px" alt="" width="760" height="760" decoding="async" />
					<i class="v-glow"></i>
				</div>
				<div class="rig fx" data-rig-box aria-hidden="true">
					<div class="a-hero" data-a-hero></div>
					<div class="r3" style="left:0;top:0;width:100%" data-rig="0"><img data-late="/images/home/3d/trio-sm.webp 900w, /images/home/3d/trio-md.webp 1200w, /images/home/3d/trio-lg.webp 1640w" sizes="(max-width: 899px) 100vw, 880px" alt="" width="1640" height="903" decoding="async" /></div>
					<div class="a-fan" data-a-fan></div>
				</div>


				<div class="papers fx" aria-hidden="true">
					{PAPERS.map((x) => (
						<div class={`paper p-${x.kind}`} data-paper><div class="paper-art"></div><span>{x.label}</span></div>
					))}
				</div>

				<div class="fl" data-fl aria-hidden="true">
					<canvas data-fl-canvas></canvas>
					<img data-fl-still data-src="/images/app110/gem.webp" alt="" width="480" height="480" decoding="async" />
				</div>

				<button class="cue fx" type="button" data-cue aria-label="مرّر للأسفل لتكتشف التطبيق"><span>مرّر للأسفل</span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg></i></button>
				<div class="hero" data-hero>
					<div class="hero-tx">
						<h1>كل صحتك، في تطبيق واحد</h1>
						<p>ملفك الطبي وأدويتك ومواعيدك وطبيبك، في مكان واحد.</p>
					</div>
					<div class="hero-cta">
						<StoreBadges adaptive size="lg" align="start" centerOnMobile />
						<a class="hero-web" href={WEB_APP_URL}>أو افتحه من المتصفح</a>
					</div>
					<span class="hint fx" aria-hidden="true"><i></i></span>
				</div>

				<div class="chs">
					{CHAPTERS.map((c, i) => (
						<article class="ch" data-ch>
							<span class="ch-key"><b>{i + 1}</b>{c.key}</span>
							<h2>{c.title}</h2>
							<p>{c.text}</p>
							<img class="ch-shot" src={c.shot} alt="" loading="lazy" decoding="async" width="390" height="844" />
						</article>
					))}
				</div>

				<div class="ph fx" data-phone aria-hidden="true">
					<i class="ph-side" data-ph-side></i><i class="ph-face"></i>
					<div class="ph-in">
						{SHOTS.map((s, i) => i === 0
							? <img data-shot src={s} srcset="/images/app110/home-320.webp 320w, /images/app110/home-480.webp 480w, /images/app110/home-640.webp 640w" sizes="(max-width: 599px) 27vw, 180px" data-full-sizes="(max-width: 899px) 270px, 340px" alt="" width="640" height="1387" decoding="async" fetchpriority="high" />
							: <img data-shot data-src={s} alt="" width="640" height="1387" decoding="async" />)}
					</div>
					<div class="notes">
						<div class="note" data-note>
							<div class="note-h"><img src="/favicon-48.png" alt="" width="18" height="18" /><b>DocSera</b><i>8:00 ص</i></div>
							<p>حان موعد <bdi>Metformin</bdi></p>
							<div class="note-a"><span class="main">أخذته <em class="tick">✓</em></span><span>بعد 10 دقائق</span></div>
						</div>
						<div class="note" data-note>
							<div class="note-h"><img src="/favicon-48.png" alt="" width="18" height="18" /><b>DocSera</b><i>2:00 م</i></div>
							<p>حان موعد دواء سميرة</p>
							<div class="note-a"><span class="main">أخذها <em class="tick">✓</em></span><span>بعد 10 دقائق</span></div>
						</div>
						<div class="note" data-note>
							<div class="note-h"><img src="/favicon-48.png" alt="" width="18" height="18" /><b>DocSera</b><i>9:00 م</i></div>
							<p>علبة <bdi>Omega 3</bdi> على وشك النفاد</p>
							<div class="note-a"><span class="main">عبّأتها</span><span>ذكّرني غداً</span></div>
						</div>
					</div>
				</div>

				<div class="hchip fx" data-float aria-hidden="true"><i><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="3" /><path d="M4 10h16M9 3v4M15 3v4" /></svg></i><span><small>موعدك القادم</small><b>غداً · 10:30 ص</b></span></div>
				<div class="hchip fx" data-float aria-hidden="true"><i><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></i><span><small>حان موعد دوائك</small><b>أخذته <em class="tick">✓</em></b></span></div>
				<div class="hchip fx" data-float aria-hidden="true"><i><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z" /><path d="M10 12h5M10 16h5" /></svg></i><span><b>تقرير زيارة جديد</b></span></div>

				<div class="cl fx" data-clinic aria-hidden="true">
					<div class="cl-bar"><i></i><i></i><i></i></div>
					<p class="cl-t">الاطّلاع على الملف الطبي</p>
					<div class="digits">
						{['4', '8', '2', '7', '1', '5'].map((d) => <span data-box><b>{d}</b></span>)}
					</div>
					<div class="cl-ok" data-check><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" /><path d="M7 12.4l3.2 3.2L17.2 8.6" /></svg>برمز من المريض</div>
				</div>
				<div class="chip fx" data-chip aria-hidden="true">
					<small>رمز الاطّلاع</small>
					<div class="digits">{['4', '8', '2', '7', '1', '5'].map((d) => <span class="on"><b>{d}</b></span>)}</div>
				</div>
			</div>
		</section>

		<section class="try" data-try>
			<div class="try-in">
				<div class="sec-h">
					<h2>جرّبه بنفسك</h2>
					<p>اضغط واكتشف الشاشات الحقيقية للتطبيق.</p>
				</div>
				<div class="try-phone"><div class="ph-in">
					{TRY.map(([, s]) => <img data-try-shot data-src={s} alt="" width="640" height="1387" decoding="async" />)}
				</div></div>
				<div class="tabs" role="group" aria-label="شاشات التطبيق">
					{TRY.map(([l], i) => <button type="button" data-tab class={i === 0 ? 'on' : ''} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
				</div>
			</div>
		</section>

		<section class="wall" data-wall>
			<div class="wall-scene" aria-hidden="true"><div class="wall-tilt">
				{WALL.map((col, c) => (
					<div class="col" style={`--d:${64 + c * 9}s`}><div class="track">
						{[...col, ...col].map((n) => <div class="shot"><img data-src={`/images/app110/wall/${n}.webp`} alt="" width="260" height="563" decoding="async" /></div>)}
					</div></div>
				))}
			</div></div>
			<button class="wall-toggle" type="button" data-wall-toggle aria-pressed="false" aria-label="إيقاف الحركة" title="إيقاف الحركة">
				<svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.3" /><rect x="13.5" y="5" width="4" height="14" rx="1.3" /></svg>
				<svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8a.8.8 0 0 0 1.2.7l10-6.4a.8.8 0 0 0 0-1.4l-10-6.4a.8.8 0 0 0-1.2.7z" /></svg>
			</button>
			<div class="wall-body">
				<h2>وهذا جزء مما ستجده داخل التطبيق</h2>
				<div class="strips">
					{MORE.map((row, r) => (
						<div class={`strip strip-${r}`}><div class="strip-track">
							{[0, 1].map((copy) => (
								<ul class="chips" aria-hidden={copy === 1 ? 'true' : undefined}>
									{row.map((t) => <li>{t}</li>)}<li class="more">وأكثر</li>
								</ul>
							))}
						</div></div>
					))}
				</div>
			</div>
		</section>

		<section class="ex" data-expand>
			<div class="ex-stick">
				<div class="ex-light" data-ex-light aria-hidden="true"></div>
				<div class="sec-h ex-h">
					<h2>على كل شاشاتك</h2>
					<p>هاتفك، وآيبادك، ومتصفحك، بالحساب نفسه.</p>
				</div>
				<div class="dev" data-dev aria-hidden="true">
					<img class="dev-small" src="/images/app110/home-640.webp" alt="" loading="lazy" decoding="async" width="640" height="1387" />
					<img class="dev-big" data-dev-big src="/images/home/ipad.webp" alt="" loading="lazy" decoding="async" width="1100" height="825" />
				</div>
			</div>
		</section>

		<Closing />
	</main>
	<script is:inline async src={bootUrl}></script>
	<Footer seamless />
</Layout>

<style is:global>
	/* Same Cairo, without the Latin-extended glyphs this page never prints. Any other character still comes from the full file. */
	@font-face { font-family: 'Cairo'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/home/Cairo-400.woff2') format('woff2'); unicode-range: U+0020-007E, U+00A0, U+00A9, U+00AB, U+00B0, U+00B7, U+00BB, U+00D7, U+0600-06FF, U+200C-200F, U+2013, U+2014, U+2018-201D, U+2026, U+FB50-FDFF, U+FE70-FEFF; }
	@font-face { font-family: 'Cairo'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/home/Cairo-700.woff2') format('woff2'); unicode-range: U+0020-007E, U+00A0, U+00A9, U+00AB, U+00B0, U+00B7, U+00BB, U+00D7, U+0600-06FF, U+200C-200F, U+2013, U+2014, U+2018-201D, U+2026, U+FB50-FDFF, U+FE70-FEFF; }
	@font-face { font-family: 'Cairo'; font-style: normal; font-weight: 800; font-display: swap; src: url('/fonts/home/Cairo-800.woff2') format('woff2'); unicode-range: U+0020-007E, U+00A0, U+00A9, U+00AB, U+00B0, U+00B7, U+00BB, U+00D7, U+0600-06FF, U+200C-200F, U+2013, U+2014, U+2018-201D, U+2026, U+FB50-FDFF, U+FE70-FEFF; }
</style>

<style>
	:global(body) { background: #F7FBFB; }
	.m { overflow-x: clip; }

	/* ── header ───────────────────────────────── */
	.h { position: fixed; z-index: 50; top: 10px; left: 50%; translate: -50% 0; width: min(1180px, calc(100% - 20px)); height: 56px;
		display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 12px 0 18px; padding-inline: 18px 8px;
		background: rgba(255, 255, 255, .86); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
		border: 1px solid rgba(0, 144, 146, .12); border-radius: 18px; box-shadow: 0 12px 30px -20px rgba(0, 60, 62, .5); }
	.h-logo img { display: block; height: 16px; width: auto; }
	.h-nav { display: flex; gap: 26px; }
	.h-nav a { color: #2D3436; font-weight: 700; font-size: .96rem; text-decoration: none; }
	.h-nav a:hover { color: var(--c-main-dark); }
	.h-cta { background: var(--c-main-dark); color: #fff; font-weight: 700; font-size: .92rem; padding: 9px 16px; border-radius: 12px; text-decoration: none; white-space: nowrap; }

	/* ── the story: plain column by default ───── */
	.st { position: relative; }
	.stick { position: relative; padding: 96px 22px 30px; }
	.fx, .a-hero, .a-dial, .bg { display: none; }
	.fl { width: 220px; height: 220px; margin: 0 auto 20px; position: relative; }
	.fl canvas, .fl img { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .3s ease; }
	.fl canvas:global(.on), .fl img:global(.on) { opacity: 1; }
	.hero { text-align: center; }
	.hero h1 { font-size: clamp(2.2rem, 5.4vw, 4rem); font-weight: 800; line-height: 1.16; color: #0F1A22; margin: 0 0 12px; text-wrap: balance; }
	.hero p { font-size: clamp(1.08rem, 2vw, 1.34rem); line-height: 1.7; color: #3D4A50; margin: 0 0 22px; }
	.hero-web { display: inline-block; margin-top: 12px; color: var(--c-main-dark); font-weight: 700; font-size: .96rem; }
	.chs { display: grid; gap: 40px; max-width: 560px; margin: 50px auto 0; }
	.ch-key { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; color: var(--c-main-dark); font-size: 1rem; margin-bottom: 8px; }
	.ch-key b { width: 26px; height: 26px; border-radius: 9px; background: var(--c-main-dark); color: #fff; display: grid; place-items: center; font: 800 .86rem Cairo, sans-serif; }
	.ch h2 { font-size: clamp(1.7rem, 3.5vw, 3rem); line-height: 1.2; font-weight: 800; color: #0F1A22; margin: 0 0 10px; text-wrap: balance; transition: color .4s; }
	.ch p { font-size: clamp(1rem, 1.7vw, 1.26rem); line-height: 1.7; color: #3D4A50; margin: 0; transition: color .4s; }
	.ch-shot { display: block; width: min(70vw, 280px); height: auto; margin: 20px auto 0; border: 7px solid #0F1A22; border-radius: 34px; }

	/* ── the story: on stage ──────────────────── */
	:global(html.story) .st { height: 640vh; height: 640svh; }
	@supports (height: 100lvh) { :global(html.story) .stick { --bar: calc(100lvh - 100svh); } }
	:global(html.story) .stick { --bar: 0px; position: sticky; top: 0; height: 100vh; height: 100lvh; overflow: hidden; padding: 0; isolation: isolate;
		background: radial-gradient(90% 70% at 70% 10%, #DFF3F3 0%, #F7FBFB 60%); }
	:global(html.story) .fx, :global(html.story) .a-hero, :global(html.story) .a-dial, :global(html.story) .bg { display: block; }
	:global(html.story) .ch-shot { display: none; }
	.bg { position: absolute; inset: 0; z-index: -2; opacity: 0; }
	.bg-hero { opacity: 1; overflow: hidden; background: radial-gradient(85% 72% at 30% 52%, #0A4A50 0%, rgba(10, 74, 80, 0) 70%), linear-gradient(200deg, #05282E 0%, #031B20 58%, #021418 100%); }
	.bg-silk { opacity: 0; overflow: hidden; background: #04232A; }
	.silk { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 34% 50%; opacity: 0; transition: opacity .5s; }
	.silk:global(.in) { opacity: 1; }
	.bg-dusk { background: linear-gradient(180deg, #FFC49B 0%, #FFE0C8 42%, #D5EFEB 100%); }
	.bg-twi { background: linear-gradient(180deg, #0E4A54 0%, #1F6C75 52%, #E8AE8C 100%); }
	.bg-night { background: radial-gradient(90% 60% at 60% 8%, #10555B 0%, #0A343B 48%, #08282E 100%); }
	.sun { position: absolute; width: 110px; height: 110px; translate: -50% -50%; z-index: -1; opacity: 0; }
	.sun i { position: absolute; inset: 0; border-radius: 50%; }
	.disc { background: radial-gradient(circle at 42% 38%, #FFE4CF 0%, #FFB494 58%, #FF9C70 100%); box-shadow: 0 0 70px 24px rgba(255, 180, 148, .42); }
	.moon { background: radial-gradient(circle at 38% 34%, #FFFFFF 0%, #DCEFF0 62%, #A9CFD1 100%); box-shadow: 0 0 60px 16px rgba(190, 235, 235, .28); opacity: 0; }

	.map { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0;
		-webkit-mask-image: linear-gradient(90deg, #000 42%, transparent 62%); mask-image: linear-gradient(90deg, #000 42%, transparent 62%); }
	.map path { fill: none; stroke: #2FB7B5; stroke-dasharray: 1; stroke-dashoffset: 1; vector-effect: non-scaling-stroke; stroke-linecap: round; }
	.map path.map-road { stroke-width: 2.8; stroke-opacity: .62; }
	.map path.map-street { stroke-width: 1.5; stroke-opacity: .34; }
	.map path.map-alley { stroke-width: 1; stroke-opacity: .17; stroke-dasharray: none; stroke-dashoffset: 0; }
	.map path.map-river { stroke: #0F6670; stroke-width: 34; stroke-opacity: .5; stroke-dasharray: none; stroke-dashoffset: 0; }
	.map path.map-park { fill: #12807A; fill-opacity: .13; stroke: none; stroke-dasharray: none; stroke-dashoffset: 0; }
	.pin { transform-box: fill-box; transform-origin: 50% 100%; opacity: 0; }
	.pin-sh { fill: rgba(0, 0, 0, .42); }
	.map path.pin-b { fill: #4BE3D8; stroke: #E9FFFC; stroke-width: 1.6; stroke-dasharray: none; stroke-dashoffset: 0; }
	.pin-d { fill: #06343A; }

	:global(html.story) .hero { position: absolute; z-index: 6; text-align: start; inset-inline-start: max(6vw, calc(50vw - 560px)); top: 50%; width: min(45vw, 560px); margin-top: -170px; }
	.rig { position: absolute; z-index: 2; left: max(1.5vw, calc(50vw - 770px)); top: 52%; translate: 0 -50%; width: min(55.5vw, 880px, 150vh); aspect-ratio: 1.8162; pointer-events: none; }
	.r3 { position: absolute; opacity: 0; will-change: transform, opacity; }
	.r3 img { display: block; width: 100%; height: auto; opacity: 0; transition: opacity .5s; }
	.r3 img:global(.in) { opacity: 1; }
	.a-hero { position: absolute; left: 60%; top: 2%; width: 22%; aspect-ratio: 1; }
	.a-fan { position: absolute; left: 45.0%; top: 10.35%; width: 20.37%; aspect-ratio: 1290 / 2796; }
	.cue { position: absolute; z-index: 7; left: 50%; bottom: calc(var(--bar, 0px) + clamp(12px, 2.8svh, 28px)); translate: -50% 0; align-items: center; gap: 7px; padding: 8px 17px 8px 12px; border: 1px solid rgba(191, 242, 238, .38); border-radius: 999px; background: rgba(5, 38, 44, .78); color: #fff; font: inherit; font-size: .92rem; font-weight: 700; cursor: pointer; opacity: 0; }
	:global(html.story) .cue { display: flex; }
	.cue:focus-visible { outline: 3px solid #BFF2EE; outline-offset: 3px; }
	.cue i { position: relative; display: block; width: 18px; height: 22px; overflow: hidden; }
	.cue svg { position: absolute; left: 0; top: 2px; width: 18px; height: 18px; fill: none; stroke: #BFF2EE; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; animation: cue 1.5s ease-in-out infinite; }
	.cue svg + svg { animation-delay: .24s; }
	@keyframes cue { 0% { transform: translateY(-9px); opacity: 0; } 40% { opacity: 1; } 100% { transform: translateY(9px); opacity: 0; } }
	:global(html:not(.story)) .a-fan { display: none; }
	:global(html.story) .a-fan { display: block; }
	:global(html.story) .hero h1 { color: #fff; }
	:global(html.story) .hero p { color: #D8EEEE; }
	:global(html.story) .hero-web { color: #BFF2EE; }
	:global(html.story) .hchip { display: flex; }
	.hchip { position: absolute; left: 0; top: 0; z-index: 5; display: flex; align-items: center; gap: 8px; padding: 8px 12px 8px 14px; border-radius: 14px; white-space: nowrap; opacity: 0; will-change: transform;
		background: rgba(255, 255, 255, .95); box-shadow: 0 16px 30px -14px rgba(0, 0, 0, .6); }
	.hchip i { width: 30px; height: 30px; flex: none; display: grid; place-items: center; border-radius: 9px; background: #E0F2F2; color: var(--c-main-dark); }
	.hchip svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.hchip small { display: block; font-size: .7rem; line-height: 1.3; color: #56636B; font-weight: 700; }
	.hchip b { display: block; font-size: .84rem; line-height: 1.35; color: #0F1A22; font-weight: 800; }
	.a-vault { display: none; position: absolute; aspect-ratio: 1; inset-inline-start: calc(max(6vw, 50vw - 560px) + 120px); top: calc(50% + 156px); width: min(124px, 15.500vh); }
	:global(html.story) .a-vault { display: block; }
	.vault { position: absolute; z-index: 0; aspect-ratio: 1; translate: -50% -50%; opacity: 0; will-change: transform, opacity; }
	.vault img { position: absolute; inset: 0; width: 100%; height: 100%; }
	.v-dial { will-change: transform; }
	.v-glow { position: absolute; inset: 1.500%; border-radius: 50%; opacity: 0; box-shadow: 0 0 0 1px rgba(127, 243, 230, .55), 0 0 70px 10px rgba(0, 214, 200, .38); transition: opacity .55s; }
	.vault:global(.open) .v-glow { opacity: 1; }
	.a-dial { position: absolute; inset-inline-start: max(6vw, calc(50vw - 560px)); top: calc(50% - 262px); width: 150px; aspect-ratio: 1; }
	:global(html.story) .fl { position: absolute; left: 0; top: 0; margin: 0; z-index: 1; transform-origin: center; will-change: transform; }
	.hint { position: absolute; display: none; }
	:global(html.story) .chs { position: absolute; z-index: 5; display: block; margin: 0; max-width: none; inset-inline-start: max(6vw, calc(50vw - 560px)); top: calc(50% - 96px); width: min(42vw, 520px); }
	:global(html.story) .ch { position: absolute; inset: 0 0 auto 0; opacity: 0; visibility: hidden; }
	:global(.stick.dark) .ch h2 { color: #fff; }
	:global(.stick.dark) .ch p { color: #D5E8E9; }
	:global(.stick.dark) .ch-key { color: #7FE3DD; }
	:global(.stick.dark) .ch-key b { background: #7FE3DD; color: #08282E; }

	.paper { position: absolute; left: 0; top: 0; z-index: 2; width: 138px; padding: 10px 10px 9px; background: #fff; border-radius: 10px; font-size: .8rem; font-weight: 700; color: #2D3436;
		box-shadow: 0 18px 30px -16px rgba(15, 26, 34, .45); will-change: transform; }
	.papers { position: absolute; inset: 0; z-index: 4; pointer-events: none; }
	.paper span { display: block; margin-top: 7px; }
	.paper-art { height: 72px; border-radius: 6px; background: repeating-linear-gradient(180deg, #E4ECEC 0 4px, transparent 4px 11px) 0 8px / 100% 60px no-repeat, #F7FAFA; }
	.p-xray .paper-art { background: radial-gradient(55% 60% at 50% 50%, #B9C7CC 0%, #6F7F86 45%, #263238 75%); }
	.p-rx .paper-art { position: relative; background: repeating-linear-gradient(180deg, #E4ECEC 0 4px, transparent 4px 11px) 0 26px / 100% 40px no-repeat, #F7FAFA; }
	.p-rx .paper-art::before { content: 'Rx'; position: absolute; top: 4px; right: 8px; font: 800 .95rem Cairo, sans-serif; color: var(--c-main); }
	.p-card .paper-art { height: 56px; background: linear-gradient(135deg, #009092, #66B8B8); }

	.ph { position: absolute; z-index: 3; left: calc(34vw - min(82vh, 740px) * .2307); top: calc(50% - min(82vh, 740px) / 2 + 22px); height: min(82vh, 740px); aspect-ratio: 1290 / 2796;
		padding: 9px; background: #0F1A22; border-radius: 46px; box-shadow: 0 40px 80px -30px rgba(0, 50, 54, .65); will-change: transform; opacity: 0; }
	.ph-side, .ph-face { position: absolute; inset: 0; z-index: -1; border-radius: inherit; }
	.ph-side { inset: -6px; border-radius: 52px; background: linear-gradient(135deg, #E4EBED, #76858B 32%, #3B474D 58%, #B4C0C4); }
	.ph-face { background: #0F1A22; }
	.ph-in { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 38px; background: #E9F5F5; }
	.ph-in img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }
	.notes { position: absolute; top: 11%; inset-inline: -7%; height: 150px; }
	.note { position: absolute; inset: 0 0 auto 0; padding: 11px 13px 12px; border-radius: 20px; background: rgba(255, 255, 255, .95); box-shadow: 0 22px 40px -18px rgba(0, 40, 44, .6); opacity: 0; }
	.note-h { display: flex; align-items: center; gap: 7px; font-size: .78rem; color: #56636B; }
	.note-h img { width: 18px; height: 18px; border-radius: 5px; }
	.note-h b { color: #0F1A22; font: 700 .76rem Cairo, sans-serif; }
	.note-h i { margin-inline-start: auto; font: 700 .78rem Cairo, sans-serif; color: #0F1A22; }
	.note p { margin: 6px 0 0; font-weight: 800; font-size: .98rem; color: #0F1A22; }
	/* Cairo has no check mark: go straight to the fallback instead of fetching a font to find that out. */
	.tick { font-family: sans-serif; font-style: normal; }
	.note-a { display: flex; gap: 8px; margin-top: 10px; }
	.note-a span { flex: 1; text-align: center; font-size: .84rem; font-weight: 700; padding: 6px 4px; border-radius: 12px; background: #EEF3F4; color: #2D3436; }
	.note-a .main { background: #E0F2F2; color: var(--c-main-dark); transition: background .25s, color .25s, transform .25s; }
	.note:global(.tap) .main { background: var(--c-main); color: #fff; transform: scale(.96); }

	.cl { position: absolute; z-index: 4; left: max(2vw, calc(34vw - 500px)); top: calc(50% - 100px); width: min(21vw, 260px); padding: 10px 14px 14px; background: #fff; border-radius: 16px; opacity: 0;
		box-shadow: 0 26px 50px -20px rgba(0, 0, 0, .6); }
	.cl-bar { display: flex; gap: 4px; margin-bottom: 10px; }
	.cl-bar i { width: 8px; height: 8px; border-radius: 50%; background: #C9D8DA; }
	.cl-t { margin: 0 0 10px; font-weight: 800; font-size: .9rem; color: #0F1A22; }
	.digits { direction: ltr; display: flex; gap: 3px; justify-content: center; }
	.digits span { flex: 1; max-width: 30px; height: 36px; border-radius: 7px; border: 1.4px solid #BFD8D9; display: grid; place-items: center; background: #F3FAFA; }
	.digits b { font: 700 .95rem Cairo, sans-serif; color: #0F1A22; opacity: 0; transition: opacity .2s; }
	.digits span:global(.on) { border-color: var(--c-main); }
	.digits span:global(.on) b { opacity: 1; }
	.cl-ok { display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: .82rem; font-weight: 700; color: var(--c-main-dark); opacity: 0; transform: translateY(4px); transition: opacity .3s, transform .3s; }
	.cl-ok:global(.on) { opacity: 1; transform: none; }
	.cl-ok svg { width: 18px; height: 18px; flex: none; }
	.cl-ok circle { fill: var(--c-main-dark); }
	.cl-ok path { fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
	.chip { position: absolute; left: 0; top: 0; z-index: 7; width: 190px; padding: 8px 9px 10px; text-align: center; background: #fff; border-radius: 14px; opacity: 0; box-shadow: 0 18px 34px -12px rgba(0, 0, 0, .65); }
	.chip small { display: block; font-size: .78rem; font-weight: 800; color: var(--c-main-dark); margin-bottom: 5px; }

	/* ── try it ───────────────────────────────── */
	.try { position: relative; color: #fff; background: #08282E; padding: 70px 0 60px; }
	.try-in { max-width: 860px; margin: 0 auto; text-align: center; }
	.sec-h { padding: 0 22px; }
	.sec-h h2 { font-size: clamp(1.9rem, 4.2vw, 3.2rem); font-weight: 800; line-height: 1.2; margin: 0 0 8px; color: inherit; }
	.sec-h p { font-size: clamp(1rem, 1.8vw, 1.24rem); line-height: 1.7; margin: 0; opacity: .86; }
	.try-phone { width: min(66vw, 290px); aspect-ratio: 1290 / 2796; margin: 28px auto 22px; padding: 8px; background: #000; border-radius: 40px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .14), 0 34px 70px -24px rgba(0, 200, 200, .35); }
	.try-phone .ph-in { border-radius: 33px; }
	.try-phone img { transition: opacity .35s ease; }
	.try-phone img:global(.on) { opacity: 1; }
	.tabs { display: flex; gap: 8px; overflow-x: auto; padding: 4px 22px 8px; scrollbar-width: none; justify-content: safe center; flex-wrap: wrap; }
	@media (min-width: 900px) {
		:global(html.story) .hero p { max-width: 400px; }
		.try { padding: 90px 0; }
		.try-in { max-width: 1040px; padding: 0 30px; display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'head phone' 'tabs phone'; gap: 22px 70px; align-content: center; text-align: start; }
		.try-in .sec-h { grid-area: head; align-self: end; padding: 0; }
		.try-phone { grid-area: phone; width: auto; height: min(78vh, 680px); margin: 0; }
		.tabs { grid-area: tabs; align-self: start; justify-content: flex-start; padding: 4px 0 8px; overflow: visible; }
	}
	.tabs::-webkit-scrollbar { display: none; }
	.tabs button { flex: none; font: 700 .95rem Cairo, sans-serif; color: #DDF3F3; background: rgba(255, 255, 255, .09); border: 1px solid rgba(255, 255, 255, .2); padding: 7px 16px; border-radius: 100px; cursor: pointer; transition: background .2s, color .2s; }
	.tabs button:global(.on) { background: #fff; color: var(--c-main-dark); border-color: #fff; }
	.tabs button:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }

	/* ── the wall ─────────────────────────────── */
	.wall { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: linear-gradient(180deg, #08282E 0%, #0B5459 42%, #08282E 100%); }
	.wall-scene { position: absolute; inset: 0 0 auto 0; height: 660px; z-index: -1; overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 48%, transparent 90%); mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 48%, transparent 90%); }
	.wall-tilt { position: absolute; top: -150px; left: 50%; display: flex; align-items: flex-start; gap: 22px; direction: ltr; translate: -50% 0;
		transform-origin: 50% 470px; transform: perspective(1500px) rotateX(24deg) rotateZ(-10deg) scale(1.14); }
	.col { width: 236px; flex: none; }
	.col:nth-child(even) { margin-top: -120px; }
	.track { animation: rise var(--d) linear infinite; animation-play-state: paused; }
	.col:nth-child(even) .track { animation-direction: reverse; }
	.wall:global(.run) .track, .wall:global(.run) .strip-track { animation-play-state: running; }
	.wall:global(.paused) .track, .wall:global(.paused) .strip-track { animation-play-state: paused; }
	@keyframes rise { to { transform: translate3d(0, -50%, 0); } }
	.shot { padding-bottom: 20px; }
	.shot img { display: block; width: 100%; height: auto; border-radius: 24px; background: #0E5F63; opacity: .35; box-shadow: 0 18px 34px -14px rgba(0, 0, 0, .55); transition: opacity .7s ease; }
	.shot img:global(.in) { opacity: .96; }
	.wall-toggle { position: absolute; top: 16px; left: 16px; z-index: 2; width: 40px; height: 40px; padding: 10px; border: 0; border-radius: 50%; cursor: pointer; color: #fff; background: rgba(5, 40, 44, .62); }
	.wall-toggle svg { display: block; width: 100%; height: 100%; fill: currentColor; }
	.wall-toggle:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
	.wall-toggle .i-play, .wall:global(.paused) .wall-toggle .i-pause { display: none; }
	.wall:global(.paused) .wall-toggle .i-play { display: block; }
	.wall-body { padding: 470px 0 64px; text-align: center; }
	.wall-body h2 { color: #fff; font-size: clamp(1.75rem, 3.8vw, 2.9rem); font-weight: 800; line-height: 1.28; margin: 0 auto 26px; padding: 0 22px; max-width: 24em; text-wrap: balance; text-shadow: 0 2px 22px rgba(0, 30, 34, .75); }
	.strips { display: grid; gap: 10px; }
	.strip { overflow: hidden; direction: ltr; -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent); mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent); }
	.strip-track { display: flex; width: max-content; animation: slide 58s linear infinite; animation-play-state: paused; }
	.strip-1 .strip-track { animation-direction: reverse; animation-duration: 66s; }
	@keyframes slide { to { transform: translate3d(-50%, 0, 0); } }
	.chips { direction: rtl; display: flex; gap: 10px; list-style: none; margin: 0; padding: 0 5px; }
	.chips li { flex: none; white-space: nowrap; font-size: 1rem; font-weight: 700; color: #EAF8F8; padding: 7px 18px; border-radius: 100px; background: rgba(255, 255, 255, .11); border: 1px solid rgba(255, 255, 255, .2); }
	.chips .more { background: #fff; color: var(--c-main-dark); border-color: #fff; font-weight: 800; }

	/* ── on every screen ──────────────────────── */
	.ex { position: relative; background: #08282E; color: #fff; padding: 60px 0; }
	.ex-stick { position: relative; display: flex; flex-direction: column; align-items: center; gap: 26px; }
	.ex-light { position: absolute; inset: 0; opacity: 0; background: #fff; z-index: 0; display: none; }
	.ex-h { position: relative; z-index: 1; text-align: center; transition: color .35s; }
	.dev { position: relative; z-index: 1; width: min(90vw, 760px); aspect-ratio: 4 / 3; overflow: hidden; background: #000; border: 8px solid #0F1A22; border-radius: 22px; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .6); }
	.dev img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
	.dev-small { display: none; }
	:global(html.story) .ex { height: 260vh; height: 260svh; padding: 0; }
	:global(html.story) .ex-stick { position: sticky; top: 0; height: 100vh; height: 100lvh; box-sizing: border-box; padding-bottom: calc(100lvh - 100svh); justify-content: center; overflow: hidden; }
	:global(html.story) .ex-light { display: block; }
	:global(html.story) .dev { aspect-ratio: auto; width: 240px; height: 520px; }
	:global(html.story) .dev-small { display: block; }
	:global(html.story) .dev-big { opacity: 0; }
	.ex:global(.lit) .ex-h { color: #0F1A22; }

