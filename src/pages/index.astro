---
// PREVIEW (branch site-v2): the home page as one story, «أربع بتلات». The DocSera
// mark has four petals and the app four great things: each petal opens a world.
// Every phone screen is the real 1.1.0 app with fake data; nothing switched off
// on production is shown, and no doctor counts. Without JS or with reduced motion
// the same content is a plain column.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ClassicSections from '../components/home/ClassicSections.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { WEB_APP_URL } from '../config/links';
import bootUrl from '../scripts/home/boot.ts?worker&url';

const PAPERS = [
	{ label: 'تحليل دم شامل', kind: 'lines' },
	{ label: 'صورة أشعة الصدر', kind: 'xray' },
	{ label: 'تقرير المتابعة', kind: 'lines' },
	{ label: 'وصفة', kind: 'rx' },
	{ label: 'بطاقة التأمين', kind: 'card' },
	{ label: 'نتيجة التحليل', kind: 'lines' },
];

const CHAPTERS = [
	{ key: 'ملفك', title: 'ملفك الطبي، بلا أوراق', text: 'تقاريرك وتحاليلك وصور الأشعة وأدويتك، مرتّبة في مكان واحد.', shot: '/images/app110/health-640.webp' },
	{ key: 'روتيني', title: 'لا تنسَ جرعة بعد اليوم', text: 'تذكير في وقت كل جرعة حتى دون إنترنت، ولأدوية أهلك أيضاً.', shot: '/images/app110/routine-640.webp' },
	{ key: 'حجزك', title: 'موعدك بلمسات', text: 'ابحث عن طبيبك، وشاهد أقرب المواعيد المتاحة، واحجز مباشرة.', shot: '/images/app110/booking-640.webp' },
	{ key: 'طبيبك', title: 'ملفك بإذنك', text: 'لا يطّلع طبيب على ملفك إلا برمز تعطيه له، وتسحبه متى شئت.', shot: '/images/app110/share-390.webp' },
];

const SHOTS = [
	'/images/app110/home-640.webp', '/images/app110/health-640.webp', '/images/app110/routine-640.webp', '/images/app110/results-640.webp',
	'/images/app110/booking-640.webp', '/images/home/confirmed.webp', '/images/app110/share-390.webp',
];

const ROADS = [
	'M-20 210C180 190 300 260 470 240S820 150 1020 190', 'M-20 520C160 480 330 560 520 520S840 430 1020 470',
	'M-20 820C200 790 360 850 560 800S860 730 1020 770', 'M160 -20C190 180 130 360 190 540S210 860 170 1020',
	'M430 -20C400 170 480 330 450 520S520 830 470 1020', 'M760 -20C720 200 800 340 760 520S830 820 790 1020',
	'M-20 360C240 420 420 340 640 400S900 360 1020 330', 'M-20 680C220 640 460 720 680 660S900 640 1020 620',
	'M60 -20C260 240 420 420 620 620S900 900 1020 980', 'M980 -20C760 200 610 340 420 560S130 880 40 1020',
	'M600 -20C620 140 570 300 620 450S640 800 610 1020', 'M300 -20C280 160 340 340 310 560S360 860 320 1020',
];
const PINS = [[190, 240], [470, 240], [760, 330], [320, 500], [620, 450], [860, 520], [170, 690], [470, 660], [770, 720], [610, 830]];

const TRY = [
	['الرئيسية', '/images/app110/home-640.webp'], ['البحث', '/images/home/search.webp'], ['الطبيب', '/images/home/doctor.webp'],
	['الحجز', '/images/app110/booking-640.webp'], ['مواعيدي', '/images/home/appointments.webp'], ['ملفي', '/images/app110/health-640.webp'],
	['التقارير', '/images/app110/wall/reports-390.webp'], ['الأدوية', '/images/app110/wall/medications-390.webp'],
	['القياسات', '/images/app110/wall/vitals-390.webp'], ['روتيني', '/images/app110/routine-640.webp'],
	['الرسائل', '/images/home/chat.webp'], ['العائلة', '/images/home/relatives.webp'],
];

const WALL = [
	['reports', 'vaccines', 'messages', 'booking'], ['medications', 'offers', 'doctor', 'family'],
	['vitals', 'search', 'appointments', 'surgeries'], ['allergies', 'notifications', 'wallet', 'relatives'],
	['documents', 'chronic', 'vouchers', 'confirmed'],
];
const MORE = [
	['الأقارب', 'الرسائل', 'الوصفات', 'التحاليل', 'صور الأشعة', 'اللقاحات', 'الحساسيات', 'العمليات', 'الأمراض المزمنة', 'التاريخ العائلي', 'نمط الحياة'],
	['تذكير الفحوصات', 'أداة الشاشة الرئيسية', 'الأطباء المفضلون', 'تأجيل المواعيد', 'إضافة إلى التقويم', 'العروض والقسائم', 'النقاط والمكافآت', 'الدخول بالبصمة', 'الآيباد والويب', 'العربية والإنجليزية'],
];
---

<Layout
	title="DocSera — دوكسيرا | كل صحتك في تطبيق واحد"
	description="دوكسيرا: ملفك الطبي، وتذكير أدويتك، وحجز مواعيدك، والتواصل مع طبيبك في تطبيق واحد."
	path="/"
	appBar={false}
>
	<script is:inline>
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('story');
	</script>

	<header class="h">
		<a href="/" class="h-logo" aria-label="DocSera"><img src="/images/docsera_main.svg" alt="DocSera" width="101" height="16" /></a>
		<nav class="h-nav" aria-label="الأقسام">
			<a href="/features">عن التطبيق</a><a href="/about">من نحن</a><a href="/help">المساعدة</a><a href="/pro">للأطباء</a>
		</nav>
		<a href="/download" class="h-cta">حمّل التطبيق</a>
	</header>

	<main class="m">
		<section class="st" data-story>
			<div class="stick" data-stick>
				<div class="bg bg-hero" data-bg-hero aria-hidden="true"><i class="au au1"></i><i class="au au2"></i></div>
				<div class="bg bg-dusk" data-dusk aria-hidden="true"></div>
				<div class="bg bg-twi" data-twi aria-hidden="true"></div>
				<div class="bg bg-night" data-night aria-hidden="true"></div>
				<div class="sun fx" data-sun aria-hidden="true"><i class="disc" data-sun-disc></i><i class="moon" data-moon-disc></i></div>

				<svg class="map fx" data-map viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
					{ROADS.map((d) => <path data-road d={d} pathLength="1" />)}
					{PINS.map(([x, y]) => (
						<g transform={`translate(${x} ${y})`}><g class="pin" data-pin><circle r="26" class="pin-glow" /><circle r="9" class="pin-dot" /></g></g>
					))}
				</svg>

				<div class="a-hero" data-a-hero aria-hidden="true"></div>
				<div class="a-dial" data-a-dial aria-hidden="true"></div>
				<div class="a-fan" data-a-fan aria-hidden="true"></div>

				<div class="side fx" data-side="1" aria-hidden="true"><div class="ph-in"><img src="/images/app110/health-320.webp" alt="" width="320" height="694" decoding="async" /></div></div>
				<div class="side fx" data-side="-1" aria-hidden="true"><div class="ph-in"><img src="/images/app110/routine-320.webp" alt="" width="320" height="694" decoding="async" /></div></div>

				<div class="papers fx" aria-hidden="true">
					{PAPERS.map((x) => (
						<div class={`paper p-${x.kind}`} data-paper><div class="paper-art"></div><span>{x.label}</span></div>
					))}
				</div>

				<div class="fl" data-fl aria-hidden="true">
					<canvas data-fl-canvas></canvas>
					<img data-fl-still data-src="/images/app110/gem.webp" alt="" width="480" height="480" decoding="async" />
				</div>

				<div class="hero" data-hero>
					<div class="hero-tx">
						<h1>كل صحتك، في تطبيق واحد</h1>
						<p>ملفك الطبي وأدويتك ومواعيدك وطبيبك، في مكان واحد.</p>
					</div>
					<div class="hero-cta">
						<StoreBadges adaptive size="lg" align="start" centerOnMobile />
						<a class="hero-web" href={WEB_APP_URL}>أو افتحه من المتصفح</a>
					</div>
					<span class="hint fx" aria-hidden="true"><i></i></span>
				</div>

				<div class="chs">
					{CHAPTERS.map((c, i) => (
						<article class="ch" data-ch>
							<span class="ch-key"><b>{i + 1}</b>{c.key}</span>
							<h2>{c.title}</h2>
							<p>{c.text}</p>
							<img class="ch-shot" src={c.shot} alt="" loading="lazy" decoding="async" width="390" height="844" />
						</article>
					))}
				</div>

				<div class="ph fx" data-phone aria-hidden="true">
					<div class="ph-in">
						{SHOTS.map((s, i) => i === 0
							? <img data-shot src={s} srcset="/images/app110/home-320.webp 320w, /images/app110/home-480.webp 480w, /images/app110/home-640.webp 640w" sizes="(max-width: 899px) 240px, 300px" alt="" width="640" height="1387" decoding="async" fetchpriority="high" />
							: <img data-shot data-src={s} alt="" width="640" height="1387" decoding="async" />)}
					</div>
					<div class="notes">
						<div class="note" data-note>
							<div class="note-h"><img src="/favicon-48.png" alt="" width="18" height="18" /><b>DocSera</b><i>8:00 ص</i></div>
							<p>حان موعد <bdi>Metformin</bdi></p>
							<div class="note-a"><span class="main">أخذته ✓</span><span>بعد 10 دقائق</span></div>
						</div>
						<div class="note" data-note>
							<div class="note-h"><img src="/favicon-48.png" alt="" width="18" height="18" /><b>DocSera</b><i>2:00 م</i></div>
							<p>حان موعد دواء سميرة</p>
							<div class="note-a"><span class="main">أخذها ✓</span><span>بعد 10 دقائق</span></div>
						</div>
						<div class="note" data-note>
							<div class="note-h"><img src="/favicon-48.png" alt="" width="18" height="18" /><b>DocSera</b><i>9:00 م</i></div>
							<p>علبة <bdi>Omega 3</bdi> على وشك النفاد</p>
							<div class="note-a"><span class="main">عبّأتها</span><span>ذكّرني غداً</span></div>
						</div>
					</div>
				</div>

				<div class="hchip fx" data-float aria-hidden="true"><i><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="3" /><path d="M4 10h16M9 3v4M15 3v4" /></svg></i><span><small>موعدك القادم</small><b>غداً · 10:30 ص</b></span></div>
				<div class="hchip fx" data-float aria-hidden="true"><i><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></i><span><small>حان موعد دوائك</small><b>أخذته ✓</b></span></div>
				<div class="hchip fx" data-float aria-hidden="true"><i><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z" /><path d="M10 12h5M10 16h5" /></svg></i><span><b>تقرير زيارة جديد</b></span></div>
				<div class="hchip fx" data-float aria-hidden="true"><i><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z" /><path d="M9 12l2 2 4-4" /></svg></i><span><b>طبيب موثّق</b></span></div>

				<div class="cl fx" data-clinic aria-hidden="true">
					<div class="cl-bar"><i></i><i></i><i></i></div>
					<p class="cl-t">الاطّلاع على الملف الطبي</p>
					<div class="digits">
						{['4', '8', '2', '7', '1', '5'].map((d) => <span data-box><b>{d}</b></span>)}
					</div>
					<div class="cl-ok" data-check><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" /><path d="M7 12.4l3.2 3.2L17.2 8.6" /></svg>برمز من المريض</div>
				</div>
				<div class="chip fx" data-chip aria-hidden="true">
					<small>رمز الاطّلاع</small>
					<div class="digits">{['4', '8', '2', '7', '1', '5'].map((d) => <span class="on"><b>{d}</b></span>)}</div>
				</div>
			</div>
		</section>

		<section class="try" data-try>
			<div class="try-in">
				<div class="sec-h">
					<h2>جرّبه بنفسك</h2>
					<p>اضغط واكتشف الشاشات الحقيقية للتطبيق.</p>
				</div>
				<div class="try-phone"><div class="ph-in">
					{TRY.map(([, s]) => <img data-try-shot data-src={s} alt="" width="640" height="1387" decoding="async" />)}
				</div></div>
				<div class="tabs" role="group" aria-label="شاشات التطبيق">
					{TRY.map(([l], i) => <button type="button" data-tab class={i === 0 ? 'on' : ''} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
				</div>
			</div>
		</section>

		<section class="wall" data-wall>
			<div class="wall-scene" aria-hidden="true"><div class="wall-tilt">
				{WALL.map((col, c) => (
					<div class="col" style={`--d:${64 + c * 9}s`}><div class="track">
						{[...col, ...col].map((n) => <div class="shot"><img data-src={`/images/app110/wall/${n}.webp`} alt="" width="260" height="563" decoding="async" /></div>)}
					</div></div>
				))}
			</div></div>
			<button class="wall-toggle" type="button" data-wall-toggle aria-pressed="false" aria-label="إيقاف الحركة" title="إيقاف الحركة">
				<svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.3" /><rect x="13.5" y="5" width="4" height="14" rx="1.3" /></svg>
				<svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8a.8.8 0 0 0 1.2.7l10-6.4a.8.8 0 0 0 0-1.4l-10-6.4a.8.8 0 0 0-1.2.7z" /></svg>
			</button>
			<div class="wall-body">
				<h2>وهذا جزء مما ستجده داخل التطبيق</h2>
				<div class="strips">
					{MORE.map((row, r) => (
						<div class={`strip strip-${r}`}><div class="strip-track">
							{[0, 1].map((copy) => (
								<ul class="chips" aria-hidden={copy === 1 ? 'true' : undefined}>
									{row.map((t) => <li>{t}</li>)}<li class="more">وأكثر</li>
								</ul>
							))}
						</div></div>
					))}
				</div>
			</div>
		</section>

		<section class="ex" data-expand>
			<div class="ex-stick">
				<div class="ex-light" data-ex-light aria-hidden="true"></div>
				<div class="sec-h ex-h">
					<h2>على كل شاشاتك</h2>
					<p>هاتفك، وآيبادك، ومتصفحك، بالحساب نفسه.</p>
				</div>
				<div class="dev" data-dev aria-hidden="true">
					<img class="dev-small" src="/images/app110/home-640.webp" alt="" loading="lazy" decoding="async" width="640" height="1387" />
					<img class="dev-big" data-dev-big src="/images/home/ipad.webp" alt="" loading="lazy" decoding="async" width="1100" height="825" />
				</div>
			</div>
		</section>

		<ClassicSections />
	</main>
	<script is:inline async src={bootUrl}></script>
	<Footer />
</Layout>

<style>
	:global(body) { background: #F7FBFB; }
	.m { overflow-x: clip; }

	/* ── header ───────────────────────────────── */
	.h { position: fixed; z-index: 50; top: 10px; left: 50%; translate: -50% 0; width: min(1180px, calc(100% - 20px)); height: 56px;
		display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 12px 0 18px; padding-inline: 18px 8px;
		background: rgba(255, 255, 255, .86); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
		border: 1px solid rgba(0, 144, 146, .12); border-radius: 18px; box-shadow: 0 12px 30px -20px rgba(0, 60, 62, .5); }
	.h-logo img { display: block; height: 16px; width: auto; }
	.h-nav { display: flex; gap: 26px; }
	.h-nav a { color: #2D3436; font-weight: 700; font-size: .96rem; text-decoration: none; }
	.h-nav a:hover { color: var(--c-main-dark); }
	.h-cta { background: var(--c-main-dark); color: #fff; font-weight: 700; font-size: .92rem; padding: 9px 16px; border-radius: 12px; text-decoration: none; white-space: nowrap; }

	/* ── the story: plain column by default ───── */
	.st { position: relative; }
	.stick { position: relative; padding: 96px 22px 30px; }
	.fx, .a-hero, .a-dial, .bg { display: none; }
	.fl { width: 220px; height: 220px; margin: 0 auto 20px; position: relative; }
	.fl canvas, .fl img { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .3s ease; }
	.fl canvas:global(.on), .fl img:global(.on) { opacity: 1; }
	.hero { text-align: center; }
	.hero h1 { font-size: clamp(2.2rem, 5.4vw, 4rem); font-weight: 800; line-height: 1.16; color: #0F1A22; margin: 0 0 12px; text-wrap: balance; }
	.hero p { font-size: clamp(1.08rem, 2vw, 1.34rem); line-height: 1.7; color: #3D4A50; margin: 0 0 22px; }
	.hero-web { display: inline-block; margin-top: 12px; color: var(--c-main-dark); font-weight: 700; font-size: .96rem; }
	.chs { display: grid; gap: 40px; max-width: 560px; margin: 50px auto 0; }
	.ch-key { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; color: var(--c-main-dark); font-size: 1rem; margin-bottom: 8px; }
	.ch-key b { width: 26px; height: 26px; border-radius: 9px; background: var(--c-main-dark); color: #fff; display: grid; place-items: center; font: 800 .86rem Cairo, sans-serif; }
	.ch h2 { font-size: clamp(1.7rem, 3.5vw, 3rem); line-height: 1.2; font-weight: 800; color: #0F1A22; margin: 0 0 10px; text-wrap: balance; transition: color .4s; }
	.ch p { font-size: clamp(1rem, 1.7vw, 1.26rem); line-height: 1.7; color: #3D4A50; margin: 0; transition: color .4s; }
	.ch-shot { display: block; width: min(70vw, 280px); height: auto; margin: 20px auto 0; border: 7px solid #0F1A22; border-radius: 34px; }

	/* ── the story: on stage ──────────────────── */
	:global(html.story) .st { height: 640vh; height: 640svh; }
	:global(html.story) .stick { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; padding: 0; isolation: isolate;
		background: radial-gradient(90% 70% at 70% 10%, #DFF3F3 0%, #F7FBFB 60%); }
	:global(html.story) .fx, :global(html.story) .a-hero, :global(html.story) .a-dial, :global(html.story) .bg { display: block; }
	:global(html.story) .ch-shot { display: none; }
	.bg { position: absolute; inset: 0; z-index: -2; opacity: 0; }
	.bg-hero { opacity: 1; overflow: hidden; background: radial-gradient(70% 55% at 74% 16%, #0E7C7E 0%, rgba(14, 124, 126, 0) 70%), radial-gradient(60% 50% at 14% 88%, #0B5D62 0%, rgba(11, 93, 98, 0) 72%), #062A30; }
	.au { position: absolute; width: 80vmax; height: 80vmax; border-radius: 50%; will-change: transform; }
	.au1 { top: -46vmax; left: -22vmax; background: radial-gradient(closest-side, rgba(0, 196, 190, .26), rgba(0, 196, 190, 0)); animation: au1 16s ease-in-out infinite alternate; }
	.au2 { bottom: -50vmax; right: -24vmax; background: radial-gradient(closest-side, rgba(255, 180, 148, .13), rgba(255, 180, 148, 0)); animation: au2 19s ease-in-out infinite alternate; }
	@keyframes au1 { to { transform: translate3d(16vmax, 9vmax, 0) scale(1.12); } }
	@keyframes au2 { to { transform: translate3d(-14vmax, -8vmax, 0) scale(1.1); } }
	.bg-dusk { background: linear-gradient(180deg, #FFC49B 0%, #FFE0C8 42%, #D5EFEB 100%); }
	.bg-twi { background: linear-gradient(180deg, #0E4A54 0%, #1F6C75 52%, #E8AE8C 100%); }
	.bg-night { background: radial-gradient(90% 60% at 60% 8%, #10555B 0%, #0A343B 48%, #08282E 100%); }
	.sun { position: absolute; width: 110px; height: 110px; translate: -50% -50%; z-index: -1; opacity: 0; }
	.sun i { position: absolute; inset: 0; border-radius: 50%; }
	.disc { background: radial-gradient(circle at 42% 38%, #FFE4CF 0%, #FFB494 58%, #FF9C70 100%); box-shadow: 0 0 70px 24px rgba(255, 180, 148, .42); }
	.moon { background: radial-gradient(circle at 38% 34%, #FFFFFF 0%, #DCEFF0 62%, #A9CFD1 100%); box-shadow: 0 0 60px 16px rgba(190, 235, 235, .28); opacity: 0; }

	.map { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0;
		-webkit-mask-image: linear-gradient(90deg, #000 42%, transparent 62%); mask-image: linear-gradient(90deg, #000 42%, transparent 62%); }
	.map path { fill: none; stroke: #2FB7B5; stroke-width: 2.2; stroke-opacity: .55; stroke-dasharray: 1; stroke-dashoffset: 1; vector-effect: non-scaling-stroke; }
	.pin { transform-box: fill-box; transform-origin: center; opacity: 0; }
	.pin-glow { fill: rgba(102, 232, 226, .2); }
	.pin-dot { fill: #8BF3EC; }

	:global(html.story) .hero { position: absolute; z-index: 6; text-align: start; inset-inline-start: max(6vw, calc(50vw - 560px)); top: 50%; width: min(45vw, 560px); margin-top: -170px; }
