---
// «من نحن»: a quiet page that opens on one question. The dot of its question mark falls
// and becomes the patient; a broken path runs to the doctor; while the story is read, one
// hairline crosses it and each everyday friction turns into what replaced it. Without JS
// or with reduced motion it is a plain column with the line already drawn.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import StoreBadges from '../components/StoreBadges.astro';

const STORY = [
	['ما رأيناه', 'أطباء أكفاء ورعاية صادقة، لكن تفاصيلها موزّعة بين مكالمات وانتظار وأوراق وذاكرة الناس.'],
	['ما فهمناه', 'لم يكن الطب هو ما ينقص. كان ينقص طريق واضح تصل به المعلومة إلى من يحتاجها، في وقتها، وبإذن صاحبها.'],
	['ما بنيناه', 'منصة واحدة تصل المريض بعيادته، وتبقي تاريخه الصحي معه.'],
];
// Each friction on the path, what replaced it once the line crossed it, and the real app card
// that shows the answer (cut from the tour's full-resolution screens; invented names only).
const STATIONS = [
	['مكالمات', 'رسائل', 18, 'msg', 480, 208],
	['انتظار', 'موعد', 39, 'appt', 480, 219],
	['أوراق', 'ملف', 61, 'file', 480, 181],
	['ذاكرة', 'تذكير', 82, 'dose', 480, 194],
] as const;
// The friction, drawn as a grey line icon until the line reaches it.
const OLD_ICON: Record<string, string> = {
	msg: 'M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A17 17 0 0 1 4.5 5.5a2 2 0 0 1 2-2z',
	appt: 'M7 3.5h10M7 20.5h10M8 3.5c0 4 4 5.5 4 8.5s-4 4.5-4 8.5M16 3.5c0 4-4 5.5-4 8.5s4 4.5 4 8.5',
	file: 'M8 3.5h7.5L19 7v13.5H8zM15 3.5V7h4M5 6.5v15h11M11 11h5M11 14.5h5',
	dose: 'M12 20.5a8.5 8.5 0 1 1 0-17 8.5 8.5 0 0 1 0 17zM9.6 9.4a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.2-2.4 2.2M12 15.6h.01',
};
// The Arabic question mark of Cairo, drawn as two shapes so that its dot can leave it.
const QM_HOOK = 'M285 202H220V237Q220 270 198 296Q176 323 132 360Q93 393 73 418Q53 442 46 470Q39 498 39 541Q39 599 62 634Q84 670 129 686Q174 702 241 702Q266 702 296 697Q327 692 357 685Q387 678 409 671L403 608Q382 613 354 618Q326 624 298 628Q270 631 249 631Q182 631 150 609Q119 587 119 535Q119 507 126 488Q133 468 152 448Q171 427 207 396Q234 373 254 352Q275 331 287 310Q299 288 299 264Q299 245 294 229Q290 213 285 202Z';
const QM_DOT = 'M296 1H212V116H296Z';
const BELIEFS = [
	['السجل ملك صاحبه', 'حجز موعد لا يفتح ملفك. يفتحه رمز تعطيه لطبيبك، وتسحبه متى شئت.'],
	['خصوصيتك أولاً', 'بياناتك الطبية محفوظة على خوادمنا داخل سوريا، ومشفّرة.'],
	['القرار لطبيبك', 'لا يقدّم DocSera رأياً طبياً. القرار يبقى للطبيب، ونحن ننظّم كل ما حوله.'],
	['مبني لواقعنا', 'عربي أولاً، خفيف على الشبكات الضعيفة، ويذكّرك بأدويتك حتى دون إنترنت.'],
	['ضفتان معاً', 'نبني تطبيق المريض وأدوات العيادة معاً، لأن الجسر لا يقوم على ضفة واحدة.'],
];
---

<Layout
	title="من نحن — DocSera"
	description="قصة دوكسيرا: منصة سورية تصل المريض بعيادته، وتبقي تاريخه الصحي معه، لأن المعلومة الطبية يجب أن تعبر."
	path="/about"
	appBar={false}
>
	<script is:inline>
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim');
	</script>
	<SiteHeader current="about" />
	<main>
		<section class="q" data-q>
			<div class="q-stick" data-q-stick>
				<i class="aura aura-t" data-aura-t aria-hidden="true"></i>
				<i class="aura aura-g" data-aura-g aria-hidden="true"></i>
				<i class="aura aura-c" data-aura-c aria-hidden="true"></i>
				<div class="q-text">
					<h1 class="q-line q-ask" data-q-ask><span class="q-rise" data-q-rise>من نحن<span class="q-sr">؟</span><svg class="qm" viewBox="0 -720 446 740" aria-hidden="true"><g transform="scale(1 -1)"><path data-q-hook d={QM_HOOK} /><path data-q-tittle d={QM_DOT} /></g></svg></span></h1>
					<p class="q-line q-say" data-q-say=".125,.155,.235,.265">بين المريض وطبيبه،<br />كانت هناك مسافة.</p>
					{STORY.map(([label, text]) => (
						<article class="q-line q-par" data-q-par>
							<h2>{label}</h2>
							<p>{text.split(' ').map((w) => <Fragment><span class="w">{w}</span>{' '}</Fragment>)}</p>
						</article>
					))}
					<h2 class="q-line q-say q-answer" data-q-say=".885,.915,2,3"><img class="q-gem" src="/images/app110/gem.webp" width="480" height="480" alt="" loading="lazy" decoding="async" />نحن DocSera.</h2>
				</div>
				<div class="q-ends" aria-hidden="true">
					<span class="q-end"><i class="q-dot on" data-q-dot-r></i><span data-q-word-r>المريض</span></span>
					<span class="q-wire">
						<i class="q-dash" data-q-dash></i>
						<i class="q-solid" data-q-wire></i>
						{STATIONS.map(([from, to, at, card, w, h]) => (
							<span class="st" style={`right:${at}%`} data-st={at / 100}>
								<span class="st-a">{from}</span><span class="st-b">{to}</span><i class="st-t"></i>
								<span class="qc" aria-hidden="true">
									<span class="qc-old"><svg viewBox="0 0 24 24"><path d={OLD_ICON[card]} /></svg></span>
									<img class="qc-new" src={`/images/about/st-${card}.webp`} width={w} height={h} alt="" loading="lazy" decoding="async" />
								</span>
							</span>
						))}
						<span class="q-mark" data-q-mark><img src="/images/DocSera-shape-main.svg" alt="" width="24" height="24" /></span>
					</span>
					<span class="q-end" data-q-end-l><i class="q-dot" data-q-dot></i>الطبيب</span>
				</div>
				<div class="q-slot" data-q-slot aria-hidden="true">
					{STATIONS.map(([, , , card, w, h]) => <img src={`/images/about/st-${card}.webp`} width={w} height={h} alt="" loading="lazy" decoding="async" />)}
				</div>
				<i class="q-fly" data-q-fly aria-hidden="true"></i>
				<i class="q-ring" data-q-ring aria-hidden="true"></i>
				<span class="q-cue" data-q-cue aria-hidden="true">مرّر<i></i></span>
			</div>
		</section>

		<section class="dev" data-dev>
			<img data-dev-img src="/images/about/devices-sm.webp" srcset="/images/about/devices-sm.webp 960w, /images/about/devices-lg.webp 1640w" sizes="(max-width: 899px) 116vw, 1040px" alt="DocSera على الحاسوب والهاتف والآيباد" width="1640" height="986" loading="lazy" decoding="async" />
			<p data-r>على الهاتف والآيباد والويب، بحساب واحد.</p>
		</section>

		<section class="bel">
			<h2>ما نؤمن به</h2>
			<div class="bel-list">
				{BELIEFS.map(([h, s]) => <article data-r><h3>{h}</h3><p>{s}</p></article>)}
			</div>
		</section>

		<section class="vis">
			<blockquote data-r>رؤيتنا أن يرافقك تاريخك الصحي كاملاً، إلى كل عيادة في سوريا.</blockquote>
			<p data-r>مستقبل الطب الرقمي، يبدأ في سوريا.</p>
			<div class="doors">
				<div class="door" data-r>
					<h3>أنا مريض</h3>
					<p>مواعيدك وأدويتك وملفك الطبي في تطبيق واحد.</p>
					<StoreBadges adaptive size="md" />
				</div>
				<div class="door door-pro" data-r>
					<h3>أنا طبيب، مختص، أو صاحب مركز</h3>
					<p>أدر عيادتك أو مركزك بأدوات صُممت لك.</p>
					<a href="/pro">اكتشف DocSera Pro</a>
				</div>
			</div>
		</section>
	</main>
	<Footer seamless />
</Layout>

<script>
	const anim = document.documentElement.classList.contains('anim');
	const clamp = (v: number) => Math.min(1, Math.max(0, v));
	const seg = (p: number, a: number, b: number) => { const t = clamp((p - a) / (b - a)); return t * t * (3 - 2 * t); };
	const root = document.querySelector<HTMLElement>('[data-q]');
	const stick = root?.querySelector<HTMLElement>('[data-q-stick]');
	if (root && stick && anim) {
		const one = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
		const ask = one('[data-q-ask]'), tittle = one<SVGPathElement>('[data-q-tittle]'), fly = one('[data-q-fly]'), ring = one('[data-q-ring]');
		const dotR = one('[data-q-dot-r]'), wordR = one('[data-q-word-r]'), endL = one('[data-q-end-l]'), dot = one('[data-q-dot]');
		const dash = one('[data-q-dash]'), wire = one('[data-q-wire]'), mark = one('[data-q-mark]'), cue = one('[data-q-cue]');
		const slot = one('[data-q-slot]'), auraT = one('[data-aura-t]'), auraG = one('[data-aura-g]'), auraC = one('[data-aura-c]');
		const says = Array.from(root.querySelectorAll<HTMLElement>('[data-q-say]')).map((el) => ({ el, t: (el.dataset.qSay || '').split(',').map(Number) }));
		// [fade in from, to, ink from, to, fade out from, to]
		const TIMES = [[0.275, 0.305, 0.312, 0.405, 0.432, 0.462], [0.472, 0.502, 0.51, 0.612, 0.635, 0.665], [0.675, 0.705, 0.712, 0.79, 0.85, 0.88]];
		const pars = Array.from(root.querySelectorAll<HTMLElement>('[data-q-par]')).map((el, i) => ({ el, t: TIMES[i], words: Array.from(el.querySelectorAll<HTMLElement>('.w')), last: [] as number[] }));
		const stations = Array.from(root.querySelectorAll<HTMLElement>('[data-st]')).map((el, i) => ({
			el, at: Number(el.dataset.st), i,
			from: el.querySelector<HTMLElement>('.st-a')!, to: el.querySelector<HTMLElement>('.st-b')!, tick: el.querySelector<HTMLElement>('.st-t')!,
		}));
		// Where the question's dot starts and where it lands.
		let S = { x: 0, y: 0, w: 8, h: 11 }, E = { x: 0, y: 0 };
		const measure = () => {
			const keep = ask.style.transform;
			ask.style.transform = 'none';
			const base = stick.getBoundingClientRect(), a = tittle.getBoundingClientRect(), b = dotR.getBoundingClientRect();
			ask.style.transform = keep;
			S = { x: a.left + a.width / 2 - base.left, y: a.top + a.height / 2 - base.top, w: a.width, h: a.height };
			E = { x: b.left + b.width / 2 - base.left, y: b.top + b.height / 2 - base.top };
			ring.style.left = `${E.x}px`;
			ring.style.top = `${E.y}px`;
		};
		const paint = (p: number) => {
			const leave = seg(p, 0.045, 0.09);
			ask.style.opacity = String(1 - leave);
			ask.style.transform = `translateY(${-12 * leave}px)`;
			cue.style.opacity = String(1 - seg(p, 0, 0.028));

			// The dot of the question mark falls and becomes the patient.
			const f = clamp((p - 0.045) / 0.077);
			tittle.style.opacity = p < 0.045 ? '1' : '0';
			if (p < 0.045 || f >= 1) fly.style.opacity = '0';
			else {
				const x = S.x + (E.x - S.x) * (f * f * (3 - 2 * f)), y = S.y + (E.y - S.y) * Math.pow(f, 2.1);
				const w = S.w + (7 - S.w) * f, h = S.h + (7 - S.h) * f, c = (a: number, b: number) => Math.round(a + (b - a) * f);
				fly.style.opacity = '1';
				fly.style.width = `${w.toFixed(2)}px`;
				fly.style.height = `${h.toFixed(2)}px`;
				fly.style.borderRadius = `${(1 + f * 3).toFixed(1)}px`;
				fly.style.background = `rgb(${c(18, 0)},${c(40, 116)},${c(44, 116)})`;
				fly.style.transform = `translate3d(${(x - w / 2).toFixed(2)}px,${(y - h / 2).toFixed(2)}px,0)`;
			}
			dotR.style.opacity = f >= 1 ? '1' : '0';
			const rg = clamp((p - 0.122) / 0.04);
			ring.style.opacity = rg > 0 && rg < 1 ? String((1 - rg) * 0.55) : '0';
			ring.style.transform = `translate(-50%, -50%) scale(${(1 + rg * 3.6).toFixed(3)})`;
			wordR.style.opacity = String(seg(p, 0.118, 0.142));
			endL.style.opacity = String(seg(p, 0.14, 0.172));

			says.forEach(({ el, t }) => {
				const a = seg(p, t[0], t[1]), o = seg(p, t[2], t[3]);
				el.style.opacity = String(a * (1 - o));
				el.style.transform = `translateY(${(1 - a) * 12 - o * 12}px)`;
			});
			pars.forEach(({ el, t, words, last }) => {
				const a = seg(p, t[0], t[1]), o = seg(p, t[4], t[5]);
				el.style.opacity = String(a * (1 - o));
				el.style.transform = `translateY(${(1 - a) * 12 - o * 12}px)`;
				if (a <= 0 || o >= 1) return;
				const n = words.length, span = t[3] - t[2];
				words.forEach((w, i) => {
					const from = t[2] + span * 0.84 * (i / n), v = 0.15 + 0.85 * seg(p, from, from + span * 0.16);
					if (Math.abs((last[i] ?? -1) - v) > 0.006) { w.style.opacity = v.toFixed(3); last[i] = v; }
				});
			});

			// A broken path; then one line crosses it, and each friction turns into its answer.
			dash.style.opacity = String(seg(p, 0.298, 0.336));
			const r = seg(p, 0.7, 0.868);
			wire.style.transform = `scaleX(${r.toFixed(4)})`;
			// the light: teal from the start, a grey fog over the broken path, teal again once crossed
			auraT.style.opacity = String(0.55 + 0.45 * seg(p, 0, 0.08) - 0.4 * seg(p, 0.3, 0.4) + 0.4 * r);
			auraT.style.transform = `translate3d(${(p * 18).toFixed(2)}vw, ${(p * 26).toFixed(2)}vh, 0)`;
			auraG.style.opacity = String(seg(p, 0.29, 0.36) * (1 - r));
			auraC.style.opacity = String(r);
			let latest = -1;
			stations.forEach(({ el, at, i, from, to, tick }) => {
				const show = seg(p, 0.316 + i * 0.021, 0.342 + i * 0.021), done = seg(r, at - 0.012, at + 0.035);
				el.style.setProperty('--done', done.toFixed(3));
				if (done > 0.5) latest = i;
				el.style.opacity = String(show);
				from.style.opacity = String(1 - done);
				from.style.transform = `translateY(${-5 * done}px)`;
				to.style.opacity = String(done);
				to.style.transform = `translateY(${5 * (1 - done)}px)`;
				tick.classList.toggle('on', done > 0.5);
			});
			slot.dataset.cur = String(latest);
			dot.classList.toggle('on', r > 0.997);
			const m = seg(p, 0.868, 0.908);
			mark.style.opacity = String(m);
			mark.style.transform = `translate(-50%, -50%) scale(${(0.82 + m * 0.18).toFixed(3)})`;
		};
		// The page follows the scroll with a little weight, so nothing ever jumps.
		let cur = 0, target = 0, running = false;
		const loop = () => {
			const d = target - cur;
			cur = Math.abs(d) < 0.0003 ? target : cur + d * 0.12;
			paint(cur);
			if (cur !== target) requestAnimationFrame(loop); else running = false;
		};
		const read = () => {
			const r = root.getBoundingClientRect();
			target = clamp(-r.top / Math.max(1, r.height - stick.offsetHeight));
			if (!running) { running = true; requestAnimationFrame(loop); }
		};
		addEventListener('scroll', read, { passive: true });
		addEventListener('resize', () => { measure(); read(); });
		one('[data-q-rise]').addEventListener('animationend', measure);
		document.fonts?.ready.then(measure);
		measure();
		const r0 = root.getBoundingClientRect();
		cur = target = clamp(-r0.top / Math.max(1, r0.height - stick.offsetHeight));
		paint(cur);

		// The devices settle into place as they arrive.
		const dev = document.querySelector<HTMLElement>('[data-dev]'), img = document.querySelector<HTMLElement>('[data-dev-img]');
		if (dev && img) {
			let q = false;
			const settle = () => {
				q = false;
				const b = dev.getBoundingClientRect();
				if (b.top > innerHeight || b.bottom < 0) return;
				const t = seg((innerHeight - b.top) / (innerHeight * 0.82), 0, 1);
				img.style.opacity = String(seg(t, 0, 0.55));
				img.style.transform = `translate3d(0, ${(44 * (1 - t)).toFixed(1)}px, 0) scale(${(0.965 + 0.035 * t).toFixed(4)})`;
			};
			img.style.opacity = '0';
			addEventListener('scroll', () => { if (!q) { q = true; requestAnimationFrame(settle); } }, { passive: true });
			settle();
		}
	}

	// Quiet reveals below the story.
	const items = Array.from(document.querySelectorAll<HTMLElement>('[data-r]'));
	if (anim) {
		const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
		items.forEach((el) => { el.classList.add('wait'); io.observe(el); });
	}
</script>

<style>
	.q { --paper: #F8F9F6; --ink: #12282C; --soft: #5E6E71; position: relative; color: var(--ink); background: var(--paper); }
	.q-stick { position: relative; padding: 124px 24px 56px; }
	.q-fly, .q-ring, .q-cue, .q-dash { display: none; }
	.q-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	.q-text { position: relative; display: grid; gap: 64px; max-width: 880px; margin: 0 auto; text-align: center; }
	.q-ask { margin: 0; font-size: clamp(3.1rem, 7.6vw, 6.6rem); font-weight: 400; line-height: 1.4; color: var(--ink); }
	.qm { display: inline-block; width: .446em; height: .74em; margin-inline-start: .05em; vertical-align: -.02em; overflow: visible; fill: currentColor; }
	.q-rise { display: block; }
	.q-say, .q-par p { margin: 0; font-size: clamp(1.9rem, 3.9vw, 3.5rem); font-weight: 400; line-height: 1.6; color: var(--ink); text-wrap: balance; }
	.q-say.q-answer { font-size: clamp(3.1rem, 7.6vw, 6.6rem); line-height: 1.4; }
	.q-par h2 { margin: 0 0 16px; font-size: 1.06rem; font-weight: 600; line-height: 1.6; color: var(--c-main-dark); }
	.q-ends { position: relative; display: flex; align-items: center; gap: 16px; max-width: 960px; margin: 96px auto 30px; font-size: 1.06rem; font-weight: 600; color: var(--ink); }
	.q-end { flex: none; display: inline-flex; align-items: center; gap: 9px; }
	.q-dot { width: 7px; height: 7px; box-sizing: border-box; border: 1px solid var(--c-main-dark); border-radius: 50%; transition: background .5s ease; }
	.q-dot:global(.on) { background: var(--c-main-dark); }
	.q-wire { position: relative; flex: 1; height: 1px; }
	.q-solid { position: absolute; inset: 0; background: var(--c-main-dark); transform-origin: 100% 50%; }
	.st { position: absolute; bottom: 0; display: grid; justify-items: center; padding-bottom: 13px; font-size: 1rem; font-weight: 400; transform: translateX(50%); }
	.st-a, .st-b { grid-area: 1 / 1; white-space: nowrap; }
	.st-a { visibility: hidden; color: var(--soft); }
	.st-b { font-weight: 600; color: var(--c-main-dark); }
	.st-t { position: absolute; left: 50%; bottom: -3px; width: 7px; height: 7px; margin-left: -3.5px; box-sizing: border-box; background: var(--c-main-dark); border: 1px solid var(--c-main-dark); border-radius: 50%; transition: background .35s ease, border-color .35s ease; }
	.q-mark { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; padding: 0 14px; background: var(--paper); transform: translate(-50%, -50%); }
	.q-mark img { display: block; width: 24px; height: 24px; }

	:global(html.anim) .q { height: 780vh; }
	:global(html.anim) .q-stick { position: sticky; top: 0; height: 100vh; height: 100lvh; box-sizing: border-box; padding: 0; overflow: hidden; }
	:global(html.anim) .q-text { position: absolute; inset: 76px 28px 31%; display: grid; place-items: center; gap: 0; max-width: none; margin: 0; }
	:global(html.anim) .q-line { grid-area: 1 / 1; max-width: 880px; opacity: 0; will-change: transform, opacity; pointer-events: none; }
	:global(html.anim) .q-ask { opacity: 1; }
	:global(html.anim) .q-rise { animation: q-rise 1.2s cubic-bezier(.2, .7, .2, 1) both; }
