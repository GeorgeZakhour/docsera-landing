---
// «من نحن»: a quiet page. One sentence, then one hairline drawn between two words while
// the story is read. Nothing glows and nothing falls. Without JS or with reduced motion
// it is a plain column with the line already drawn.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import StoreBadges from '../components/StoreBadges.astro';

const STORY = [
	['ما رأيناه', 'أطباء أكفاء ورعاية صادقة، لكن تفاصيلها موزّعة بين مكالمات وأوراق وذاكرة الناس.'],
	['ما فهمناه', 'لم يكن الطب هو ما ينقص. كان ينقص طريق واضح تصل به المعلومة إلى من يحتاجها، في وقتها، وبإذن صاحبها.'],
	['ما بنيناه', 'منصة واحدة تصل المريض بعيادته، وتبقي تاريخه الصحي معه. هذه هي DocSera.'],
];
const BELIEFS = [
	['السجل ملك صاحبه', 'حجز موعد لا يفتح ملفك. يفتحه رمز تعطيه لطبيبك، وتسحبه متى شئت.'],
	['خصوصيتك أولاً', 'بياناتك الطبية محفوظة على خوادمنا داخل سوريا، ومشفّرة.'],
	['القرار لطبيبك', 'لا يقدّم DocSera رأياً طبياً. القرار يبقى للطبيب، ونحن ننظّم كل ما حوله.'],
	['مبني لواقعنا', 'عربي أولاً، خفيف على الشبكات الضعيفة، ويذكّرك بأدويتك حتى دون إنترنت.'],
	['ضفتان معاً', 'نبني تطبيق المريض وأدوات العيادة معاً، لأن الجسر لا يقوم على ضفة واحدة.'],
];
---

<Layout
	title="من نحن — DocSera"
	description="قصة دوكسيرا: منصة سورية تصل المريض بعيادته، وتبقي تاريخه الصحي معه، لأن المعلومة الطبية يجب أن تعبر."
	path="/about"
	appBar={false}
>
	<script is:inline>
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim');
	</script>
	<SiteHeader current="about" />
	<main>
		<section class="q" data-q>
			<div class="q-stick" data-q-stick>
				<div class="q-text">
					<h1 class="q-line q-hero" data-q-hero><span class="q-rise">بين المريض وطبيبه،<br />كانت هناك مسافة.</span></h1>
					{STORY.map(([label, text]) => (
						<article class="q-line q-par" data-q-par>
							<h2>{label}</h2>
							<p>{text.split(' ').map((w) => <Fragment><span class="w">{w}</span>{' '}</Fragment>)}</p>
						</article>
					))}
				</div>
				<div class="q-ends" aria-hidden="true">
					<span class="q-end"><i class="q-dot on"></i>المريض</span>
					<span class="q-wire"><i data-q-wire></i><span class="q-mark" data-q-mark><img src="/images/DocSera-shape-main.svg" alt="" width="24" height="24" /></span></span>
					<span class="q-end"><i class="q-dot" data-q-dot></i>الطبيب</span>
				</div>
				<span class="q-cue" data-q-cue aria-hidden="true">مرّر<i></i></span>
			</div>
		</section>

		<section class="dev">
			<img data-r src="/images/about/devices-sm.webp" srcset="/images/about/devices-sm.webp 960w, /images/about/devices-lg.webp 1640w" sizes="(max-width: 899px) 116vw, 1040px" alt="DocSera على الحاسوب والهاتف والآيباد" width="1640" height="986" loading="lazy" decoding="async" />
			<p data-r>على الهاتف والآيباد والويب، بحساب واحد.</p>
		</section>

		<section class="bel">
			<h2>ما نؤمن به</h2>
			<div class="bel-list">
				{BELIEFS.map(([h, s]) => <article data-r><h3>{h}</h3><p>{s}</p></article>)}
			</div>
		</section>

		<section class="vis">
			<blockquote data-r>نريد أن يأتي يوم لا يحمل فيه مريض في سوريا ملفه الطبي في كيس.</blockquote>
			<p data-r>مستقبل الطب الرقمي، يبدأ في سوريا.</p>
			<div class="doors">
				<div class="door" data-r>
					<h3>أنا مريض</h3>
					<p>مواعيدك وأدويتك وملفك الطبي في تطبيق واحد.</p>
					<StoreBadges adaptive size="md" />
				</div>
				<div class="door door-pro" data-r>
					<h3>أنا طبيب، مختص، أو صاحب مركز</h3>
					<p>أدر عيادتك أو مركزك بأدوات صُممت لك.</p>
					<a href="/pro">اكتشف DocSera Pro</a>
				</div>
			</div>
		</section>
	</main>
	<Footer seamless />
</Layout>

<script>
	const anim = document.documentElement.classList.contains('anim');
	const root = document.querySelector<HTMLElement>('[data-q]');
	const stick = root?.querySelector<HTMLElement>('[data-q-stick]');
	if (root && stick && anim) {
		const clamp = (v: number) => Math.min(1, Math.max(0, v));
		const seg = (p: number, a: number, b: number) => { const t = clamp((p - a) / (b - a)); return t * t * (3 - 2 * t); };
		const one = (s: string) => root.querySelector<HTMLElement>(s)!;
		const hero = one('[data-q-hero]'), wire = one('[data-q-wire]'), mark = one('[data-q-mark]'), dot = one('[data-q-dot]'), cue = one('[data-q-cue]');
		// [fade in from, to, ink from, to, fade out from, to]
		const TIMES = [[0.17, 0.205, 0.215, 0.365, 0.395, 0.43], [0.44, 0.475, 0.485, 0.635, 0.665, 0.7], [0.71, 0.745, 0.755, 0.885, 2, 3]];
		const pars = Array.from(root.querySelectorAll<HTMLElement>('[data-q-par]')).map((el, i) => ({ el, t: TIMES[i], words: Array.from(el.querySelectorAll<HTMLElement>('.w')), last: [] as number[] }));
		const STOPS = [[0.13, 0], [0.375, 1 / 3], [0.645, 2 / 3], [0.89, 1]];
		const reach = (p: number) => {
			if (p <= STOPS[0][0]) return 0;
			for (let i = 1; i < STOPS.length; i++) if (p <= STOPS[i][0]) {
				const [a, va] = STOPS[i - 1], [b, vb] = STOPS[i];
				return va + (vb - va) * seg(p, a, b);
			}
			return 1;
		};
		const paint = (p: number) => {
			const h = seg(p, 0.095, 0.16);
			hero.style.opacity = String(1 - h);
			hero.style.transform = `translateY(${-10 * h}px)`;
			cue.style.opacity = String(1 - seg(p, 0, 0.035));
			pars.forEach(({ el, t, words, last }) => {
				const a = seg(p, t[0], t[1]), o = seg(p, t[4], t[5]);
				el.style.opacity = String(a * (1 - o));
				el.style.transform = `translateY(${(1 - a) * 10 - o * 10}px)`;
				if (a <= 0 || o >= 1) return;
				const n = words.length, span = t[3] - t[2];
				words.forEach((w, i) => {
					const from = t[2] + span * 0.84 * (i / n), v = 0.15 + 0.85 * seg(p, from, from + span * 0.16);
					if (Math.abs((last[i] ?? -1) - v) > 0.006) { w.style.opacity = v.toFixed(3); last[i] = v; }
				});
			});
			const r = reach(p);
			wire.style.transform = `scaleX(${r.toFixed(4)})`;
			dot.classList.toggle('on', r > 0.997);
			const m = seg(p, 0.89, 0.935);
			mark.style.opacity = String(m);
			mark.style.transform = `translate(-50%, -50%) scale(${(0.86 + m * 0.14).toFixed(3)})`;
		};
		// The page follows the scroll with a little weight, so nothing ever jumps.
		let cur = 0, target = 0, running = false;
		const loop = () => {
			const d = target - cur;
			cur = Math.abs(d) < 0.0004 ? target : cur + d * 0.13;
			paint(cur);
			if (cur !== target) requestAnimationFrame(loop); else running = false;
		};
		const read = () => {
			const r = root.getBoundingClientRect();
			target = clamp(-r.top / Math.max(1, r.height - stick.offsetHeight));
			if (!running) { running = true; requestAnimationFrame(loop); }
		};
		addEventListener('scroll', read, { passive: true });
		addEventListener('resize', read);
		const r0 = root.getBoundingClientRect();
		cur = target = clamp(-r0.top / Math.max(1, r0.height - stick.offsetHeight));
		paint(cur);
	}

	// Quiet reveals below the story.
	const items = Array.from(document.querySelectorAll<HTMLElement>('[data-r]'));
	if (anim) {
		const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
		items.forEach((el) => { el.classList.add('wait'); io.observe(el); });
	}
</script>

<style>
	.q { --paper: #F8F9F6; --ink: #12282C; --soft: #5E6E71; position: relative; color: var(--ink); background: var(--paper); }
	.q-stick { position: relative; padding: 124px 24px 56px; }
	.q-text { display: grid; gap: 64px; max-width: 880px; margin: 0 auto; text-align: center; }
	.q-line h1, .q-hero, .q-par p { margin: 0; font-size: clamp(1.9rem, 3.9vw, 3.5rem); font-weight: 400; line-height: 1.6; color: var(--ink); text-wrap: balance; }
	.q-rise { display: block; }
	.q-par h2 { margin: 0 0 16px; font-size: 1.06rem; font-weight: 600; line-height: 1.6; color: var(--c-main-dark); }
	.q-ends { display: flex; align-items: center; gap: 16px; max-width: 960px; margin: 72px auto 0; font-size: 1.06rem; font-weight: 600; color: var(--ink); }
	.q-end { flex: none; display: inline-flex; align-items: center; gap: 9px; }
	.q-dot { width: 7px; height: 7px; box-sizing: border-box; border: 1px solid var(--c-main-dark); border-radius: 50%; transition: background .5s ease; }
	.q-dot:global(.on) { background: var(--c-main-dark); }
	.q-wire { position: relative; flex: 1; height: 1px; }
	.q-wire > i { position: absolute; inset: 0; background: var(--c-main-dark); transform-origin: 100% 50%; }
	.q-mark { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; padding: 0 14px; background: var(--paper); transform: translate(-50%, -50%); }
	.q-mark img { display: block; width: 24px; height: 24px; }
	.q-cue { display: none; }

	:global(html.anim) .q { height: 560vh; }
	:global(html.anim) .q-stick { position: sticky; top: 0; height: 100vh; height: 100lvh; box-sizing: border-box; padding: 0; overflow: hidden; }
	:global(html.anim) .q-text { position: absolute; inset: 76px 28px 30%; display: grid; place-items: center; gap: 0; max-width: none; margin: 0; }
	:global(html.anim) .q-line { grid-area: 1 / 1; max-width: 880px; opacity: 0; will-change: transform, opacity; pointer-events: none; }
	:global(html.anim) .q-hero { opacity: 1; }
	:global(html.anim) .q-rise { animation: q-rise 1.1s cubic-bezier(.2, .7, .2, 1) both; }
	:global(html.anim) .q-par .w { opacity: .15; }
	:global(html.anim) .q-ends { position: absolute; inset-inline: max(28px, calc(50% - 480px)); top: 73%; max-width: none; margin: 0; animation: q-fade 1.1s ease .45s both; }
	:global(html.anim) .q-wire > i { transform: scaleX(0); will-change: transform; }
	:global(html.anim) .q-mark { opacity: 0; }
	:global(html.anim) .q-cue { position: absolute; left: 50%; bottom: 26px; display: grid; justify-items: center; gap: 8px; font-size: .92rem; color: var(--soft); translate: -50% 0; animation: q-fade 1.1s ease 1s backwards; }
	.q-cue i { position: relative; display: block; width: 1px; height: 34px; overflow: hidden; background: rgba(18, 40, 44, .14); }
	.q-cue i::after { content: ''; position: absolute; inset: 0; background: var(--c-main-dark); animation: q-drop 2.2s cubic-bezier(.6, 0, .3, 1) infinite; }
	@keyframes q-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
	@keyframes q-fade { from { opacity: 0; } to { opacity: 1; } }
	@keyframes q-drop { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }

	.dev { padding: clamp(36px, 6vw, 80px) 20px clamp(72px, 10vw, 136px); overflow: hidden; text-align: center; color: #5E6E71; background: #F8F9F6; }
	.dev img { --w: min(1040px, 116vw); display: block; width: var(--w); max-width: none; height: auto; margin-inline: calc((100% - var(--w)) / 2); }
	.dev p { margin: clamp(14px, 2.4vw, 28px) 0 0; font-size: 1.06rem; line-height: 1.7; color: #5E6E71; }

	.bel h2 { margin: 0 0 8px; font-size: clamp(2rem, 4.4vw, 3.5rem); font-weight: 800; line-height: 1.2; }
	.bel { padding: clamp(64px, 9vw, 120px) 22px; color: #fff; background: #06262B; }
	.bel h2 { margin-bottom: clamp(26px, 4vw, 48px); text-align: center; color: #fff; }
	.bel-list { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; max-width: 1100px; margin: 0 auto; }
	.bel article { grid-column: span 2; padding: 26px 24px; background: rgba(255, 255, 255, .055); border: 1px solid rgba(255, 255, 255, .13); border-radius: 22px; }
	.bel article:nth-child(n + 4) { grid-column: span 3; }
	.bel h3 { margin: 0 0 8px; font-size: clamp(1.4rem, 2.3vw, 1.85rem); font-weight: 800; color: #A9EADF; }
	.bel p { margin: 0; font-size: 1.06rem; line-height: 1.75; color: #E4F6F4; }

	.vis { padding: clamp(80px, 12vw, 150px) 22px clamp(64px, 9vw, 110px); text-align: center; color: #fff; background: radial-gradient(90% 60% at 50% 104%, rgba(255, 214, 170, .32), rgba(66, 190, 178, .3) 44%, transparent 74%), linear-gradient(180deg, #06262B, #0A4148 66%, #0E5C60); }
	.vis blockquote { max-width: 980px; margin: 0 auto 16px; font-size: clamp(2rem, 5vw, 4.1rem); font-weight: 800; line-height: 1.3; text-wrap: balance; }
	.vis > p { margin: 0 0 clamp(36px, 5vw, 60px); font-size: clamp(1.08rem, 1.8vw, 1.36rem); color: #BDEDE5; }
	.doors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 920px; margin: 0 auto; }
	.door { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 14px; padding: 28px 22px; background: rgba(255, 255, 255, .09); border: 1px solid rgba(255, 255, 255, .2); border-radius: 22px; }
	.door h3 { margin: 0; font-size: clamp(1.3rem, 2.2vw, 1.6rem); font-weight: 800; color: #fff; }
	.door p { margin: 0; font-size: 1.04rem; color: #E4F6F4; }
	.door-pro a { padding: 12px 24px; font-weight: 800; color: var(--c-main-dark); text-decoration: none; background: #fff; border-radius: 14px; }

	[data-r]:global(.wait) { opacity: 0; transform: translateY(22px); transition: opacity .6s ease, transform .6s ease; }
	[data-r]:global(.in) { opacity: 1; transform: none; }

	@media (max-width: 760px) {
		.bel-list, .doors { grid-template-columns: minmax(0, 1fr); }
		.bel article, .bel article:nth-child(n + 4) { grid-column: auto; }
	}
	@media (prefers-reduced-motion: reduce) {
		.q-cue i::after { animation: none; }
	}
</style>
