---
// «من نحن»: one idea told by scrolling. Two banks with the everyday problems falling
// into the gap, then a bridge. Without JS or with reduced motion it is a plain column
// with the bridge already built.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import StoreBadges from '../components/StoreBadges.astro';

const PROBLEMS = [
	['الانتظار الطويل', 25, 6, -7], ['صور وتحاليل ضائعة', 51, 0, 5],
	['صعوبة إيجاد الطبيب', 21, 35, 4], ['فوضى المواعيد', 53, 31, -5],
] as const;

// The suspension bridge: towers at x 320 and 680.
const deckY = (x: number) => { const s = (x - 215) / 570; return 270 - 2 * s * (1 - s) * 30; };
const cableY = (x: number) => { const t = (x - 320) / 360; return 112 + 2 * t * (1 - t) * 128; };
const HANGERS = Array.from({ length: 11 }, (_, i) => 350 + i * 30).map((x) => `M${x} ${cableY(x).toFixed(1)}V${deckY(x).toFixed(1)}`).join('');

const VALUES = [
	{ title: 'بياناتك أمانة', text: 'بياناتك الطبية محفوظة على خوادمنا داخل سوريا، ومشفّرة.',
		icon: '<path d="M12 3 5 6v5.5c0 4.4 2.9 7.8 7 9.5 4.1-1.7 7-5.1 7-9.5V6z"/><path d="m9 12 2.2 2.2L15.2 10"/>' },
	{ title: 'مصمَّم لواقعنا', text: 'عربي أولاً، خفيف على الإنترنت الضعيف، ويذكّرك بأدويتك حتى دون اتصال.',
		icon: '<path d="M3 9.5a14 14 0 0 1 18 0M6.5 13a9 9 0 0 1 11 0M10 16.5a4 4 0 0 1 4 0"/><circle cx="12" cy="19.5" r=".8"/>' },
	{ title: 'نتطوّر معكم', text: 'نسمع من المرضى والأطباء، ونحسّن التطبيق بناءً على ما يحتاجونه فعلاً.',
		icon: '<path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20.5 3.5V8H16"/>' },
];
---

<Layout
	title="من نحن — DocSera"
	description="قصة دوكسيرا: منصة سورية تصل المريض بطبيبه، وتجمع المواعيد والملف الطبي في مكان واحد."
	path="/about"
	appBar={false}
>
	<script is:inline>
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim');
	</script>
	<SiteHeader current="about" />
	<main>
		<section class="b" data-bridge>
			<div class="b-stick" data-b-stick>
				<img class="silk" src="/images/home/3d/silk-860.webp" srcset="/images/home/3d/silk-860.webp 860w, /images/home/3d/silk-1600.webp 1600w" sizes="max(100vw, 160vh)" alt="" width="1600" height="1000" decoding="async" />
				<div class="b-lines">
					<div class="b-line" data-l><h1>بدأنا من مشكلة يعرفها كل سوري.</h1></div>
					<div class="b-line" data-l><h2>لم تكن المشكلة في الأطباء.<br />كان ينقص ما يصلهم بالمرضى.</h2></div>
					<div class="b-line" data-l><h2>فبنينا الجسر.</h2><p>منصة واحدة تنظّم رعايتك الصحية، وتعيد إليها سهولتها وإنسانيتها.</p></div>
				</div>
				<div class="b-scene" aria-hidden="true">
					{PROBLEMS.map(([label, x, y, r]) => <span class="b-p" data-p style={`left:${x}%;top:${y}%;--r:${r}deg`}>{label}</span>)}
					<svg viewBox="0 0 1000 420">
						<defs>
							<linearGradient id="bank" gradientUnits="userSpaceOnUse" x1="0" y1="258" x2="0" y2="660"><stop offset="0" stop-color="#2C8F8D" /><stop offset="1" stop-color="#0A3B41" stop-opacity="0" /></linearGradient>
						</defs>
						<path class="bank" d="M-1400 262H0C90 258 170 262 214 272C232 300 244 356 250 700H-1400Z" />
						<path class="bank" d="M2400 262H1000C910 258 830 262 786 272C768 300 756 356 750 700H2400Z" />
						<path class="tw" data-draw d="M320 300V100" pathLength="1" />
						<path class="tw" data-draw d="M680 300V100" pathLength="1" />
						<path class="cable" data-draw d="M205 270L320 112Q500 240 680 112L795 270" pathLength="1" />
						<path class="hang" data-hang d={HANGERS} />
						<path class="deck" data-draw d="M215 270Q500 240 785 270" pathLength="1" />
					</svg>
					<span class="b-who b-who-r">المريض</span>
					<span class="b-who b-who-l">الطبيب</span>
					<span class="b-mark" data-mark><img src="/images/DocSera-shape-main.svg" alt="" width="34" height="34" /></span>
				</div>
			</div>
		</section>

		<section class="vals">
			<h2>ما يقودنا</h2>
			<div class="vals-list">
				{VALUES.map((v) => (
					<article>
						<i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.icon} /></i>
						<h3>{v.title}</h3>
						<p>{v.text}</p>
					</article>
				))}
			</div>
		</section>

		<section class="doors">
			<h2>مكانك معنا</h2>
			<div class="doors-grid">
				<div class="door">
					<h3>أنا مريض</h3>
					<p>مواعيدك وأدويتك وملفك الطبي في تطبيق واحد.</p>
					<StoreBadges adaptive size="md" />
				</div>
				<div class="door door-pro">
					<h3>أنا طبيب، مختص، أو صاحب مركز</h3>
					<p>أدر عيادتك أو مركزك بأدوات صُممت لك.</p>
					<a href="/pro">اكتشف DocSera Pro</a>
				</div>
			</div>
		</section>
	</main>
	<Footer seamless />
</Layout>

<script>
	const root = document.querySelector<HTMLElement>('[data-bridge]');
	const stick = root?.querySelector<HTMLElement>('[data-b-stick]');
	if (root && stick && document.documentElement.classList.contains('anim')) {
		const clamp = (v: number) => Math.min(1, Math.max(0, v));
		const seg = (p: number, a: number, b: number) => { const t = clamp((p - a) / (b - a)); return t * t * (3 - 2 * t); };
		const lines = Array.from(root.querySelectorAll<HTMLElement>('[data-l]'));
		const probs = Array.from(root.querySelectorAll<HTMLElement>('[data-p]'));
		const draws = Array.from(root.querySelectorAll<SVGPathElement>('[data-draw]'));
		const hang = root.querySelector<SVGPathElement>('[data-hang]');
		const mark = root.querySelector<HTMLElement>('[data-mark]');
		const WIN: [number, number][] = [[-1, 0.27], [0.3, 0.57], [0.66, 2]];
		const DRAW: [number, number][] = [[0.46, 0.58], [0.5, 0.62], [0.58, 0.76], [0.54, 0.68]];
		let ticking = false;
		const paint = () => {
			ticking = false;
			const r = root.getBoundingClientRect();
			const p = clamp(-r.top / Math.max(1, r.height - stick.offsetHeight));
			lines.forEach((l, i) => {
				const [a, b] = WIN[i];
				const v = seg(p, a, a + 0.07) * (1 - seg(p, b, b + 0.06));
				l.style.opacity = String(v);
				l.style.transform = `translateY(${(1 - seg(p, a, a + 0.07)) * 22 - seg(p, b, b + 0.06) * 22}px)`;
			});
			probs.forEach((e, i) => {
				const f = seg(p, 0.27 + i * 0.035, 0.48 + i * 0.035);
				e.style.opacity = String(1 - seg(p, 0.36 + i * 0.035, 0.5 + i * 0.035));
				e.style.transform = `translateY(${f * f * 260}px) rotate(calc(var(--r) * ${1 + f * 3}))`;
			});
			draws.forEach((d, i) => { d.style.strokeDashoffset = String(1 - seg(p, DRAW[i][0], DRAW[i][1])); });
			if (hang) hang.style.opacity = String(seg(p, 0.72, 0.82));
			if (mark) {
				const m = seg(p, 0.8, 0.9);
				mark.style.opacity = String(m);
				mark.style.transform = `translate(-50%, -50%) scale(${0.6 + m * 0.4})`;
			}
		};
		const ask = () => { if (!ticking) { ticking = true; requestAnimationFrame(paint); } };
		addEventListener('scroll', ask, { passive: true });
		addEventListener('resize', ask);
		paint();
	}
</script>

<style>
	.silk { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.b { position: relative; color: #fff; background: #06262B; }
	.b-stick { position: relative; display: flex; flex-direction: column; gap: 26px; padding: 104px 22px 40px; overflow: hidden; }
	.b-lines { position: relative; display: grid; gap: 22px; max-width: 900px; margin: 0 auto; text-align: center; }
	.b-line h1, .b-line h2 { margin: 0; font-size: clamp(2.1rem, 5.2vw, 4.2rem); font-weight: 800; line-height: 1.22; color: #fff; text-wrap: balance; }
	.b-line p { margin: 12px 0 0; font-size: clamp(1.06rem, 1.8vw, 1.34rem); color: #DDF3F1; }
	.b-scene { --sw: min(1000px, 118vw); --who: 10%; position: relative; flex: none; width: var(--sw); margin-inline: calc((100% - var(--sw)) / 2); aspect-ratio: 1000 / 420; }
	.b-scene svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
	.bank { fill: url(#bank); }
	.tw, .cable, .deck, .hang { fill: none; stroke-linecap: round; }
	.tw { stroke: #F2FBFA; stroke-width: 9; }
	.cable { stroke: #8FE3D9; stroke-width: 3.5; stroke-linejoin: round; }
	.deck { stroke: #fff; stroke-width: 9; }
	.hang { stroke: #8FE3D9; stroke-width: 1.6; opacity: .85; }
	.b-p { display: none; }
	.b-who-r { right: var(--who); }
	.b-who-l { left: var(--who); }
	.b-who { position: absolute; top: 72%; padding: 4px 12px; font-size: clamp(.8rem, 1.5vw, 1.04rem); font-weight: 800; color: #06343A; background: #fff; border-radius: 999px; }
	.b-mark { position: absolute; left: 50%; top: 42%; display: grid; place-items: center; width: clamp(46px, 7vw, 70px); aspect-ratio: 1; background: #fff; border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 0 7px rgba(255, 255, 255, .14), 0 0 44px 10px rgba(143, 227, 217, .5); }
	.b-mark img { width: 58%; height: auto; }

	:global(html.anim) .b { height: 340vh; }
	:global(html.anim) .b-stick { position: sticky; top: 0; height: 100vh; height: 100lvh; box-sizing: border-box; justify-content: center; gap: clamp(14px, 5vh, 54px); padding: 84px 16px 24px; }
	:global(html.anim) .b-lines { display: block; width: 100%; min-height: clamp(150px, 26vh, 240px); }
	:global(html.anim) .b-line { position: absolute; inset: 0 0 auto; opacity: 0; will-change: transform, opacity; }
	:global(html.anim) .b-p { position: absolute; z-index: 2; display: block; padding: 6px 13px; font-size: clamp(.78rem, 1.5vw, 1.02rem); font-weight: 800; white-space: nowrap; color: #5C2D12; background: #FFE9D6; border-radius: 12px; box-shadow: 0 12px 24px -12px rgba(0, 0, 0, .6); will-change: transform, opacity; }
	:global(html.anim) .tw, :global(html.anim) .cable, :global(html.anim) .deck { stroke-dasharray: 1; stroke-dashoffset: 1; }
	:global(html.anim) .hang, :global(html.anim) .b-mark { opacity: 0; }

	.vals { padding: clamp(60px, 9vw, 110px) 24px; background: #F6FBFB; }
	.vals h2 { margin: 0 0 clamp(26px, 4vw, 46px); text-align: center; font-size: clamp(1.9rem, 4vw, 3.1rem); font-weight: 800; color: #0F1A22; }
	.vals-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 52px); max-width: 1060px; margin: 0 auto; }
	.vals i { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 14px; color: #fff; background: var(--c-main-dark); border-radius: 16px; }
	.vals svg { width: 27px; height: 27px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.vals h3 { margin: 0 0 6px; font-size: 1.4rem; font-weight: 800; color: #0F1A22; }
	.vals p { margin: 0; font-size: 1.06rem; color: #46565D; }

	.doors { padding: clamp(60px, 9vw, 110px) 22px; text-align: center; color: #fff; background: radial-gradient(90% 80% at 50% 118%, rgba(255, 214, 170, .3), rgba(66, 190, 178, .28) 42%, transparent 72%), linear-gradient(180deg, #06262B, #0A4148 72%, #0E5C60); }
	.doors h2 { margin: 0 0 30px; font-size: clamp(2rem, 4.6vw, 3.6rem); font-weight: 800; color: #fff; }
	.doors-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 920px; margin: 0 auto; }
	.door { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 14px; padding: 28px 22px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .18); border-radius: 22px; }
	.door h3 { margin: 0; font-size: clamp(1.3rem, 2.2vw, 1.6rem); font-weight: 800; color: #fff; }
	.door p { margin: 0; font-size: 1.04rem; color: #E4F6F4; }
	.door-pro a { padding: 12px 24px; font-weight: 800; color: var(--c-main-dark); text-decoration: none; background: #fff; border-radius: 14px; }

	@media (max-width: 760px) {
		.b-scene { --sw: 150vw; --who: 18%; }
		.vals-list, .doors-grid { grid-template-columns: minmax(0, 1fr); }
		.vals article { text-align: center; }
		.vals i { margin-inline: auto; }
	}
</style>
