---
// The page for a link that leads nowhere, in the home page's light, warm language: «4 0 4»
// where the zero is the site's 3D mark (the original shape), and the message arrives as a
// DocSera notification, with the two actions people need, like the app's own reminders.
// Below: a search of the help guide. Light: one 12 KB image (the same still /download uses).
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import HelpSearch from '../components/help/HelpSearch.astro';
import '../components/help/help.css';
---

<Layout title="الصفحة غير موجودة — DocSera" description="الرابط الذي فتحته غير موجود. عد إلى الصفحة الرئيسية، أو ابحث في دليل المساعدة." path="/404.html">
	<SiteHeader />
	<main class="nf">
		<span class="sun" aria-hidden="true"></span>
		<div class="nf-in">
			<div class="code" aria-hidden="true" data-code>
				<span class="digit">4</span>
				<span class="zero">
					<img class="gem" src="/images/app110/gem.webp" width="480" height="480" alt="" fetchpriority="high" decoding="async" />
					<span class="gem-shadow"></span>
				</span>
				<span class="digit">4</span>
			</div>

			<article class="push">
				<header class="push-head">
					<img class="push-icon" src="/images/links/app-icon.webp" width="60" height="60" alt="" />
					<span class="push-app">DocSera</span>
					<span class="push-time">الآن</span>
				</header>
				<h1>لم نجد هذه الصفحة</h1>
				<p>ربما تغيّر الرابط، أو فيه خطأ صغير في الكتابة.</p>
				<div class="push-acts">
					<a class="act act-main" href="/">الصفحة الرئيسية</a>
					<a class="act" href="/help">دليل المساعدة</a>
				</div>
			</article>

			<div class="nf-search">
				<p class="nf-label">أو ابحث عن سؤالك</p>
				<!-- .hp carries the help centre's colours (ink text, white results) -->
				<div class="hp nf-hp"><HelpSearch /></div>
			</div>

			<nav class="more" aria-label="روابط أخرى">
				<a href="/download">حمّل التطبيق</a>
				<a href="/pro">DocSera Pro</a>
			</nav>
		</div>
	</main>
	<Footer />
</Layout>

<script>
	import { startHelpSearch } from '../scripts/help/search';
	startHelpSearch();
	// A tap on the zero spins it once.
	const code = document.querySelector<HTMLElement>('[data-code]');
	code?.addEventListener('click', () => {
		code.classList.remove('spin');
		void code.offsetWidth;
		code.classList.add('spin');
	});
</script>

<style>
	.nf {
		position: relative;
		overflow: hidden;
		min-height: calc(100svh - 64px);
		display: grid;
		place-items: center;
		padding: clamp(96px, 12vh, 128px) 16px clamp(48px, 8vh, 80px);
		color: #0E2B2C;
		background:
			radial-gradient(70% 45% at 50% 20%, rgba(255, 205, 170, 0.55), transparent 70%),
			linear-gradient(180deg, #FFF4EB 0%, #FDF0E6 38%, #F4FAF9 100%);
	}
	/* the warm sphere of the home page, behind the zero */
	.sun {
		position: absolute;
		left: 50%; top: clamp(120px, 17vh, 170px);
		width: clamp(220px, 46vw, 340px); aspect-ratio: 1;
		transform: translateX(-50%);
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #FFD9C0, #FFAF86 60%, #F59A70);
		opacity: 0.38;
		filter: blur(2px);
	}
	.nf-in { position: relative; width: min(560px, 100%); text-align: center; }

	/* ── 4 [mark] 4 ── */
	.code {
		direction: ltr;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(2px, 1vw, 10px);
		font: 800 clamp(120px, 34vw, 210px)/1 'Cairo', sans-serif;
		letter-spacing: -0.02em;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.digit {
		background: linear-gradient(180deg, #13A7A6 0%, #007678 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 14px 18px rgba(0, 90, 92, 0.22));
	}
	.zero { position: relative; display: block; width: 1em; height: 1em; margin: 0.08em -0.04em 0; }
	.gem { position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 16px 20px rgba(0, 70, 72, 0.32)); }
	.gem-shadow {
		position: absolute; left: 50%; bottom: -0.02em;
		width: 0.56em; height: 0.08em; margin-left: -0.28em;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgba(0, 60, 62, 0.35), transparent);
	}

	/* ── the message, as a DocSera notification ── */
	.push {
		margin: clamp(8px, 2vh, 18px) auto 0;
		max-width: 440px;
		padding: 14px 16px 16px;
		text-align: start;
		background: #fff;
		border-radius: 24px;
		box-shadow: 0 30px 60px -30px rgba(0, 60, 62, 0.45), 0 2px 6px rgba(0, 60, 62, 0.06);
	}
	.push-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
	.push-icon { width: 24px; height: 24px; border-radius: 7px; }
	.push-app { font: 700 13px 'Montserrat', 'Cairo', sans-serif; color: #0E2B2C; }
	.push-time { margin-inline-start: auto; font-size: 12.5px; font-weight: 600; color: #6A7F80; }
	.push h1 { margin: 0 0 4px; font-size: clamp(1.25rem, 5vw, 1.5rem); font-weight: 800; line-height: 1.35; }
	.push p { margin: 0; font-size: 1rem; line-height: 1.7; color: #566B6C; }
	.push-acts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }
	.act {
		display: grid; place-items: center;
		min-height: 46px;
		padding: 0 10px;
		border-radius: 14px;
		font-size: 0.98rem; font-weight: 800;
		text-decoration: none;
		color: #0E2B2C;
		background: #EEF3F3;
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.2s;
	}
	.act-main { color: #006F71; background: #E1F4F3; }
	.act:hover { background: #E4ECEC; }
	.act-main:hover { background: #CFEDEB; }
	.act:active { transform: scale(0.96); }
	.act:focus-visible, .more a:focus-visible { outline: 2px solid #007474; outline-offset: 2px; }

	/* ── search + the other two places ── */
	.nf-search { margin: 26px auto 0; max-width: 440px; text-align: start; }
	.nf-label { margin: 0 0 8px; font-size: 0.95rem; font-weight: 700; color: #3F5657; }
	.nf-hp { background: none; }
	.nf-hp :global(.hp-search) { z-index: 5; }
	.more { display: flex; justify-content: center; gap: 10px; margin-top: 18px; }
	.more a {
		display: inline-flex; align-items: center;
		min-height: 38px; padding: 0 16px;
		border-radius: 999px;
		font-size: 0.92rem; font-weight: 700;
		text-decoration: none;
		color: #006F71;
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(0, 144, 146, 0.18);
	}
	.more a:hover { background: #fff; }

	@media (prefers-reduced-motion: no-preference) {
		.digit { animation: digit-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; }
		.digit:last-child { animation-delay: 0.12s; }
		@keyframes digit-in { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
		.gem { animation: gem-in 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s backwards, float 5.5s ease-in-out 1.1s infinite; }
		.gem-shadow { animation: shadow 5.5s ease-in-out 1.1s infinite; }
		@keyframes gem-in { from { transform: translateY(-40px) scale(0.5) rotate(-60deg); opacity: 0; } to { transform: none; opacity: 1; } }
		@keyframes float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-9px) rotate(8deg); } }
		@keyframes shadow { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(0.8); opacity: 0.6; } }
		.code:global(.spin) .gem { animation: spin 0.9s cubic-bezier(0.34, 1.56, 0.64, 1), float 5.5s ease-in-out 0.9s infinite; }
		@keyframes spin { from { transform: rotate(0deg) scale(0.9); } to { transform: rotate(360deg) scale(1); } }
		/* the notification drops in from the top, like a push */
		.push { animation: push-in 0.8s cubic-bezier(0.34, 1.4, 0.64, 1) 0.7s backwards; }
		@keyframes push-in { from { transform: translateY(-34px) scale(0.94); opacity: 0; } to { transform: none; opacity: 1; } }
	}
</style>
