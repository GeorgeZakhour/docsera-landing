---
// «عن التطبيق»: the app explored by what the visitor needs, on its real screens
// (full-length renders with fake data). Without JS the first screen and every need
// stay readable.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteCta from '../components/site/SiteCta.astro';
import AppPhone from '../components/site/AppPhone.astro';
import { APP_PAGES, pageIndex } from '../data/appPages';

const NEEDS = [
	{ title: 'أحجز موعداً', text: 'ابحث باسم الطبيب أو الاختصاص، واختر الوقت المناسب، وتابع موعدك.', pages: ['home', 'search', 'doctor', 'booking', 'appointments'],
		icon: '<rect x="4" y="5" width="16" height="15" rx="3"/><path d="M4 10h16M9 3v4M15 3v4"/>' },
	{ title: 'أتذكّر أدويتي', text: 'تذكير بكل جرعة في وقتها، حتى دون إنترنت.', pages: ['routine', 'medications'],
		icon: '<path d="M10.5 20.5a5 5 0 0 1-7-7l10-10a5 5 0 0 1 7 7z"/><path d="m8.5 8.5 7 7"/>' },
	{ title: 'أحفظ ملفي الطبي', text: 'تقاريرك وقياساتك في مكان واحد، ولا يطّلع طبيب على ملفك إلا برمز تعطيه له.', pages: ['health', 'reports', 'vitals'],
		icon: '<path d="M7 3h7l4 4v14H7z"/><path d="M10 12h5M10 16h5"/>' },
	{ title: 'أهتم بعائلتي', text: 'أضف أطفالك ووالديك، واحجز لهم، وتابع ملف كل واحد منهم من حسابك.', pages: ['family', 'routine'],
		icon: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.6 2.7-5.5 5.5-5.5s4.9 1.9 5.5 5.5"/><path d="M16 5.2a3 3 0 0 1 0 5.6M17.5 14.8c1.7.7 2.7 2.4 3 5.2"/>' },
	{ title: 'أراسل عيادتي', text: 'راسل عيادتك لتنظيم مواعيدك ومتابعتها، وأرسل الصور والملفات.', pages: ['chat'],
		icon: '<path d="M20 12a8 8 0 0 1-11.8 7L4 20l1-4.2A8 8 0 1 1 20 12z"/>' },
];

// Never a closed list: it ends in «وأكثر».
const MORE = ['الوصفات', 'التحاليل', 'صور الأشعة', 'اللقاحات', 'الحساسيات', 'العمليات', 'الأمراض المزمنة', 'التاريخ العائلي', 'نمط الحياة', 'تذكير الفحوصات', 'أداة الشاشة الرئيسية', 'الأطباء المفضلون', 'تأجيل المواعيد', 'إضافة إلى التقويم', 'العروض والقسائم', 'النقاط والمكافآت', 'الدخول بالبصمة', 'الآيباد والويب', 'العربية والإنجليزية'];
const silk = '/images/home/3d/silk-860.webp 860w, /images/home/3d/silk-1600.webp 1600w';
---

<Layout
	title="عن التطبيق — DocSera"
	description="تعرّف على ما يقدّمه دوكسيرا: حجز المواعيد، وتذكير الأدوية، والملف الطبي لك ولعائلتك، والتواصل مع عيادتك، على شاشات التطبيق الحقيقية."
	path="/features"
	appBar={false}
>
	<SiteHeader current="features" />
	<main>
		<section class="ex" data-ex>
			<img class="silk" src="/images/home/3d/silk-860.webp" srcset={silk} sizes="max(100vw, 160vh)" alt="" width="1600" height="1000" decoding="async" />
			<div class="ex-in">
				<div class="ex-copy">
					<h1>ماذا تحتاج اليوم؟</h1>
					<p class="ex-sub">اختر ما يهمّك، وشاهده على شاشات التطبيق الحقيقية.</p>
					<div class="needs" role="group" aria-label="ما تحتاجه">
						{NEEDS.map((n, i) => (
							<button type="button" class:list={['need', { on: i === 0 }]} data-need={i} aria-pressed={i === 0 ? 'true' : 'false'}>
								<i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={n.icon} /></i>
								<span class="need-t"><b>{n.title}</b><span class="need-d"><small>{n.text}</small></span></span>
							</button>
						))}
					</div>
				</div>
				<div class="ex-stage">
					<p class="ex-cap" data-cap aria-live="polite">{NEEDS[0].text}</p>
					<AppPhone eager />
					<div class="steps-wrap">
						{NEEDS.map((n, i) => (
							<div class="steps" data-steps hidden={i !== 0} role="group" aria-label={`شاشات ${n.title}`}>
								{n.pages.length > 1 && n.pages.map((id, k) => (
									<button type="button" class:list={[{ on: k === 0 }]} data-step={pageIndex(id)} aria-pressed={k === 0 ? 'true' : 'false'}>{APP_PAGES[pageIndex(id)].label}</button>
								))}
							</div>
						))}
					</div>
				</div>
			</div>
			<script type="application/json" data-need-pages set:html={JSON.stringify(NEEDS.map((n) => ({ text: n.text, first: pageIndex(n.pages[0]) })))} />
		</section>

		<section class="more">
			<h2>وهذا جزء مما فيه</h2>
			<ul class="more-list">
				{MORE.map((m) => <li>{m}</li>)}
				<li class="more-last">وأكثر</li>
			</ul>
		</section>

		<section class="safe">
			<img class="silk" src="/images/home/3d/silk-860.webp" srcset={silk} sizes="max(100vw, 160vh)" alt="" width="1600" height="1000" loading="lazy" decoding="async" />
			<div class="safe-in">
				<div class="safe-v" aria-hidden="true">
					<img src="/images/home/3d/vault-base-420.webp" srcset="/images/home/3d/vault-base-420.webp 420w, /images/home/3d/vault-base-760.webp 760w" sizes="(max-width: 899px) 190px, 300px" alt="" width="760" height="760" loading="lazy" decoding="async" />
					<img src="/images/home/3d/vault-dial-420.webp" srcset="/images/home/3d/vault-dial-420.webp 420w, /images/home/3d/vault-dial-760.webp 760w" sizes="(max-width: 899px) 190px, 300px" alt="" width="760" height="760" loading="lazy" decoding="async" />
				</div>
				<div>
					<h2>ملفك بإذنك</h2>
					<p>بياناتك الطبية محفوظة على خوادمنا داخل سوريا، ومشفّرة.</p>
					<p>لا يطّلع طبيب على ملفك إلا برمز تعطيه له، وتسحبه متى شئت.</p>
				</div>
			</div>
		</section>

		<SiteCta />
	</main>
	<Footer seamless />
</Layout>

<script>
	import { mountAppPhone } from '../scripts/site/app-phone';

	const root = document.querySelector<HTMLElement>('[data-ex]');
	const el = root?.querySelector<HTMLElement>('[data-try-phone]');
	if (root && el) {
		const phone = mountAppPhone(el);
		phone.activate();
		new IntersectionObserver(([e]) => phone.setInView(e.isIntersecting)).observe(el);
		const info: { text: string; first: number }[] = JSON.parse(root.querySelector('[data-need-pages]')?.textContent || '[]');
		const needs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-need]'));
		const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-steps]'));
		const cap = root.querySelector<HTMLElement>('[data-cap]');
		const press = (b: HTMLButtonElement, on: boolean) => {
			b.classList.toggle('on', on);
			b.setAttribute('aria-pressed', String(on));
		};
		needs.forEach((b, i) => b.addEventListener('click', () => {
			needs.forEach((x) => press(x, x === b));
			groups.forEach((g, k) => {
				g.hidden = k !== i;
				g.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((s, n) => press(s, n === 0));
			});
			if (cap) cap.textContent = info[i].text;
			b.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
			phone.engage(false);
			phone.show(info[i].first);
		}));
		groups.forEach((g) => g.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((s) => s.addEventListener('click', () => {
			g.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((x) => press(x, x === s));
			phone.engage(false);
			phone.show(Number(s.dataset.step));
		})));
	}
</script>

<style>
	.silk { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.ex { position: relative; display: flex; align-items: center; min-height: 100svh; padding: 88px 0 28px; box-sizing: border-box; overflow: hidden; color: #fff; background: #06262B; }
	.ex-in { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: clamp(40px, 7vw, 96px); width: min(1120px, 100%); margin: 0 auto; padding: 0 28px; box-sizing: border-box;
		--phone-w: auto; --phone-h: min(calc(100svh - 196px), 650px); --phone-m: 0 auto; }
	.ex h1 { margin: 0 0 8px; font-size: clamp(2.5rem, 5vw, 4.2rem); font-weight: 800; line-height: 1.15; color: #fff; }
	.ex-sub { margin: 0 0 24px; font-size: clamp(1.04rem, 1.6vw, 1.24rem); color: #DDF3F1; }
	.needs { display: grid; gap: 8px; max-width: 520px; }
	.need { display: flex; align-items: flex-start; gap: 12px; width: 100%; padding: 11px 13px; font: inherit; text-align: start; color: #fff; cursor: pointer; background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .16); border-radius: 16px; transition: background .2s ease, color .2s ease, border-color .2s ease; }
	.need:hover { background: rgba(255, 255, 255, .13); }
	.need:focus-visible, .steps button:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
	.need i { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: rgba(255, 255, 255, .13); }
	.need svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.need-t { flex: 1; min-width: 0; }
	.need b { display: block; font-size: 1.1rem; font-weight: 800; line-height: 38px; }
	.need-d { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .25s ease; }
	.need-d small { overflow: hidden; font-size: .94rem; font-weight: 600; line-height: 1.65; color: #46565D; }
	.need:global(.on) { color: #0F1A22; background: #fff; border-color: #fff; }
	.need:global(.on) i { color: var(--c-main-dark); background: #E0F2F2; }
	.need:global(.on) .need-d { grid-template-rows: 1fr; }
	.ex-cap { display: none; }
	.steps-wrap { display: flex; justify-content: center; min-height: 38px; margin-top: 14px; }
	.steps { display: flex; justify-content: center; gap: 6px; max-width: 100%; }
	.steps[hidden] { display: none; }
	.steps button { flex: none; padding: 5px 13px; font: 700 .88rem Cairo, sans-serif; color: #DDF3F3; cursor: pointer; background: rgba(255, 255, 255, .09); border: 1px solid rgba(255, 255, 255, .2); border-radius: 999px; }
	.steps button:global(.on) { color: var(--c-main-dark); background: #fff; border-color: #fff; }

	.more { padding: clamp(60px, 9vw, 104px) 22px; text-align: center; background: #F6FBFB; }
	.more h2 { margin: 0 0 26px; font-size: clamp(1.8rem, 3.8vw, 3rem); font-weight: 800; color: #0F1A22; }
	.more-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 9px; max-width: 900px; margin: 0 auto; padding: 0; list-style: none; }
	.more-list li { padding: 7px 15px; font-size: .98rem; font-weight: 700; color: #1F4A4E; background: #fff; border: 1px solid #D9EBEB; border-radius: 999px; }
	.more-list .more-last { color: #fff; background: var(--c-main-dark); border-color: var(--c-main-dark); }

	.safe { position: relative; overflow: hidden; color: #fff; background: #06262B; }
	.safe-in { position: relative; display: flex; align-items: center; justify-content: center; gap: clamp(30px, 6vw, 80px); max-width: 1000px; margin: 0 auto; padding: clamp(60px, 8vw, 96px) 28px; }
	.safe-v { position: relative; flex: none; width: 300px; height: 300px; }
	.safe-v img { position: absolute; inset: 0; width: 100%; height: 100%; }
	.safe h2 { margin: 0 0 12px; font-size: clamp(2rem, 4.4vw, 3.4rem); font-weight: 800; color: #fff; }
	.safe p { margin: 0 0 6px; font-size: clamp(1.04rem, 1.6vw, 1.24rem); color: #E4F6F4; }

	@media (max-width: 899px) {
		.ex { align-items: flex-start; padding: 84px 0 22px; text-align: center; }
		.ex-in { grid-template-columns: minmax(0, 1fr); gap: 10px; padding: 0 20px; --phone-w: clamp(196px, calc((100svh - 372px) * .4614), 270px); --phone-h: auto; }
		.ex h1 { font-size: clamp(2.1rem, 9vw, 3rem); }
		.ex-sub { margin-bottom: 14px; font-size: 1.02rem; }
		.needs { display: flex; gap: 7px; max-width: none; margin-inline: -20px; padding: 2px 20px; overflow-x: auto; scrollbar-width: none; }
		.needs::-webkit-scrollbar { display: none; }
		.need { flex: none; width: auto; align-items: center; gap: 7px; padding: 6px 12px 6px 8px; border-radius: 13px; }
		.need i { width: 30px; height: 30px; border-radius: 9px; }
		.need svg { width: 18px; height: 18px; }
		.need b { font-size: .98rem; line-height: 1.4; white-space: nowrap; }
		.need-d { display: none; }
		.ex-cap { display: block; min-height: 3.2em; margin: 2px auto 10px; max-width: 34em; font-size: .98rem; line-height: 1.6; color: #E4F6F4; }
		.steps-wrap { margin-top: 12px; margin-inline: -20px; }
		.steps { justify-content: safe center; padding: 2px 20px; overflow-x: auto; scrollbar-width: none; }
		.steps::-webkit-scrollbar { display: none; }
		.safe-in { flex-direction: column; text-align: center; }
		.safe-v { width: 190px; height: 190px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.need, .need-d { transition: none; }
	}
</style>
