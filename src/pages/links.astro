---
// /links — the one page behind the Instagram bio (docsera.app/ig 302s here
// with ?s=instagram). Every button carries that source onward, so a visit
// that starts in the bio is still counted as Instagram on /pro, on the Pro
// request form and in Google Play's install referrer.
//
// Own <html> like the /pro pages: the look is its own (deep teal, glass),
// and it must stay light — most visitors open it inside Instagram's
// in-app browser on a slow line.
//
// Never link the web apps (my.docsera.app / pro.docsera.app) from here.
import { APP_STORE_URL, playUrl, proWhatsAppUrl, INSTAGRAM_URL } from '../config/links';
import whiteLogo from '../../public/images/docsera_white.svg?raw';

// docsera_white.svg = the mark (first path) followed by the letters.
const paths = [...whiteLogo.matchAll(/\sd="([^"]+)"/g)].map((m) => m[1].replace(/\s+/g, ' ').trim());
const markPath = paths[0];
const letterPaths = paths.slice(1);

// The mark's own box inside the logo, and its centre: the four petals are
// cut apart along the diagonals and drawn together from there.
const MARK_BOX = { x: 4, y: 11, w: 256, h: 246 };
const C = { x: 132, y: 133.5 };
const corners = {
	tl: `${MARK_BOX.x},${MARK_BOX.y}`,
	tr: `${MARK_BOX.x + MARK_BOX.w},${MARK_BOX.y}`,
	br: `${MARK_BOX.x + MARK_BOX.w},${MARK_BOX.y + MARK_BOX.h}`,
	bl: `${MARK_BOX.x},${MARK_BOX.y + MARK_BOX.h}`,
};
const centre = `${C.x},${C.y}`;
const petals = [
	{ id: 'top', pts: `${corners.tl} ${corners.tr} ${centre}`, dx: 0, dy: -46 },
	{ id: 'right', pts: `${corners.tr} ${corners.br} ${centre}`, dx: 46, dy: 0 },
	{ id: 'bottom', pts: `${corners.br} ${corners.bl} ${centre}`, dx: 0, dy: 46 },
	{ id: 'left', pts: `${corners.bl} ${corners.tl} ${centre}`, dx: -46, dy: 0 },
];

const WA_TEXT = 'مرحباً، عندي سؤال عن DocSera';
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
	<title>DocSera — Your health, connected.</title>
	<meta name="description" content="حمّل تطبيق دوكسيرا، تعرّف على DocSera Pro للعيادات والمراكز، وتواصل معنا — كل روابط دوكسيرا في مكان واحد." />
	<link rel="canonical" href="https://docsera.app/links" />
	<meta name="theme-color" content="#03292C" />
	<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content="DocSera" />
	<meta property="og:title" content="DocSera — Your health, connected." />
	<meta property="og:description" content="كل روابط دوكسيرا في مكان واحد." />
	<meta property="og:url" content="https://docsera.app/links" />
	<meta property="og:image" content="https://docsera.app/og-image.png" />
	<meta name="twitter:card" content="summary_large_image" />
	<link rel="preload" href="/fonts/Cairo-700.woff2" as="font" type="font/woff2" crossorigin />

	<script is:inline>
		(function () {
			var d = document.documentElement, u = navigator.userAgent || '';
			var ios = /iPad|iPhone|iPod/.test(u);
			if (!ios && /Macintosh/.test(u) && navigator.maxTouchPoints > 1) ios = true;
			d.setAttribute('data-os', ios ? 'ios' : /Android/i.test(u) ? 'android' : 'desktop');
			d.classList.add('js');
			try { if (localStorage.getItem('ds_links_lang') === 'en') d.classList.add('pre-en'); } catch (e) {}
		})();
	</script>

	<style is:global>
		@font-face { font-family: 'Cairo'; font-weight: 400; font-display: swap; src: url('/fonts/Cairo-400.woff2') format('woff2'); }
		@font-face { font-family: 'Cairo'; font-weight: 600; font-display: swap; src: url('/fonts/Cairo-600.woff2') format('woff2'); }
		@font-face { font-family: 'Cairo'; font-weight: 700; font-display: swap; src: url('/fonts/Cairo-700.woff2') format('woff2'); }
		@font-face { font-family: 'Cairo'; font-weight: 800; font-display: swap; src: url('/fonts/Cairo-800.woff2') format('woff2'); }
		@font-face { font-family: 'Montserrat'; font-weight: 500; font-display: swap; src: url('/fonts/Montserrat-500.woff2') format('woff2'); }
		@font-face { font-family: 'Montserrat'; font-weight: 600; font-display: swap; src: url('/fonts/Montserrat-600.woff2') format('woff2'); }
		@font-face { font-family: 'Montserrat'; font-weight: 700; font-display: swap; src: url('/fonts/Montserrat-700.woff2') format('woff2'); }

		:root {
			--abyss: #021C1F;
			--deep: #03292C;
			--teal: #009092;
			--aqua: #3FD0C9;
			--mint: #BDF4EC;
			--ivory: #F3FBFA;
			--slate: #0C1A20;
			--text-soft: rgba(225, 246, 243, 0.74);
			--ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
			--ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
			color-scheme: dark;
		}

		*, *::before, *::after { box-sizing: border-box; }
		html { -webkit-text-size-adjust: 100%; background: var(--abyss); }
		body {
			margin: 0;
			min-height: 100vh;
			min-height: 100dvh;
			background: var(--abyss);
			color: var(--ivory);
			font-family: 'Cairo', 'Montserrat', system-ui, sans-serif;
			-webkit-font-smoothing: antialiased;
			-webkit-tap-highlight-color: transparent;
			overflow-x: hidden;
		}
		html[lang='en'] body { font-family: 'Montserrat', 'Cairo', system-ui, sans-serif; }
		a { color: inherit; text-decoration: none; }
		img { display: block; }
		:focus-visible { outline: 2px solid var(--mint); outline-offset: 3px; }
	</style>
</head>

<body>
	<!-- The mark, once, for the background blooms. -->
	<svg width="0" height="0" style="position:absolute" aria-hidden="true">
		<defs>
			<path id="ds-mark" d={markPath} />
			<linearGradient id="markFill" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#FFFFFF" />
				<stop offset="1" stop-color="#BDF4EC" />
			</linearGradient>
			{petals.map((p) => (
				<clipPath id={`cut-${p.id}`}><polygon points={p.pts} /></clipPath>
			))}
		</defs>
	</svg>

	<!-- Backdrop: the brand mark itself, enlarged and blurred into light, for
	     the glass to refract. It drifts on its own and leans toward the
	     pointer / finger. -->
	<div class="sky" aria-hidden="true">
		<svg class="bloom bloom-a" viewBox={`${MARK_BOX.x} ${MARK_BOX.y} ${MARK_BOX.w} ${MARK_BOX.h}`}><use href="#ds-mark" /></svg>
		<svg class="bloom bloom-b" viewBox={`${MARK_BOX.x} ${MARK_BOX.y} ${MARK_BOX.w} ${MARK_BOX.h}`}><use href="#ds-mark" /></svg>
		<svg class="bloom bloom-c" viewBox={`${MARK_BOX.x} ${MARK_BOX.y} ${MARK_BOX.w} ${MARK_BOX.h}`}><use href="#ds-mark" /></svg>
		<div class="vignette"></div>
		<div class="grain"></div>
	</div>

	<div class="shell">
		<header class="topbar">
			<button class="icon-btn" type="button" data-share data-t-aria="share" aria-label="مشاركة الصفحة">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7" /><path d="m16 6-4-4-4 4" /><path d="M12 2v13" /></svg>
			</button>
			<button class="lang-btn" type="button" data-lang lang="en" aria-label="Switch to English">EN</button>
		</header>

		<section class="hero">
			<div class="orb">
				<span class="orb-ring" aria-hidden="true"></span>
				<svg class="mark" viewBox={`${MARK_BOX.x} ${MARK_BOX.y} ${MARK_BOX.w} ${MARK_BOX.h}`} aria-hidden="true">
					{petals.map((p, i) => (
						<g class="petal" style={`--dx:${p.dx}px;--dy:${p.dy}px;--i:${i}`}>
							<use href="#ds-mark" clip-path={`url(#cut-${p.id})`} fill="url(#markFill)" />
						</g>
					))}
					<use class="mark-whole" href="#ds-mark" fill="url(#markFill)" />
				</svg>
			</div>
			<h1 class="wordmark">
				<svg viewBox="300 40 1236 200" role="img" aria-label="DocSera">
					<g fill="currentColor">{letterPaths.map((d) => <path d={d} />)}</g>
				</svg>
			</h1>
			<p class="slogan" lang="en" dir="ltr">Your health, connected.</p>
		</section>

		<main class="links">
			<!-- 1. The patient app. On a phone it goes straight to that phone's store. -->
			<a class="card card-app" href="/download/" data-app-link data-track="app" style="--i:0">
				<span class="sheen" aria-hidden="true"></span>
				<img class="app-icon" src="/images/links/app-icon.webp" width="60" height="60" alt="" />
				<span class="card-text">
					<span class="card-title" data-t="appTitle">حمّل التطبيق</span>
					<span class="card-sub" data-t="appSub">احجز موعدك وتابع ملفك الطبي</span>
					<span class="store-line">
						<span class="os-ios" data-t="appIos">مجاني على App Store</span>
						<span class="os-android" data-t="appAndroid">مجاني على Google Play</span>
						<span class="os-desktop" data-t="appDesktop">مجاني على App Store و Google Play</span>
					</span>
				</span>
				<span class="get" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M12 4v12" /><path d="m6 11 6 6 6-6" /><path d="M5 20h14" /></svg>
				</span>
			</a>

			<!-- 2. DocSera Pro — the doctors' side. Two destinations: the page, and the request form. -->
			<div class="card card-pro" style="--i:1">
				<a class="pro-main" href="/pro/" data-carry-source data-track="pro">
					<img class="pro-icon" src="/images/links/pro-icon.webp" width="60" height="60" alt="" />
					<span class="card-text">
						<img class="pro-logo" src="/images/links/pro-logo.webp" width="640" height="144" alt="DocSera Pro" />
						<span class="card-sub" data-t="proSub">لإدارة العيادات والمراكز الطبية</span>
					</span>
					<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
				</a>
				<div class="pro-foot">
					<span class="pro-for" data-t="proFor">للأطباء والمراكز</span>
					<a class="chip" href="/pro/join/" data-carry-source data-track="pro_join" data-t="proJoin">ابدأ تجربتك المجانية</a>
				</div>
			</div>

			<!-- 3. The website. -->
			<a class="card card-row" href="/" data-carry-source data-track="site" style="--i:2">
				<span class="row-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" /><path d="M12 2.5a14 14 0 0 0 0 19 14 14 0 0 0 0-19" /><path d="M2.5 12h19" /></svg>
				</span>
				<span class="card-text">
					<span class="row-title" data-t="siteTitle">الموقع الرسمي</span>
					<span class="row-sub" lang="en">docsera.app</span>
				</span>
				<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
			</a>

			<!-- 4 + 5. Contact and help, side by side. -->
			<div class="pair" style="--i:3">
				<a class="card card-tile" href={proWhatsAppUrl(WA_TEXT)} target="_blank" rel="noopener" data-track="whatsapp">
					<span class="tile-icon tile-wa" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41z" /></svg>
					</span>
					<span class="tile-title" data-t="waTitle">تواصل معنا</span>
					<span class="tile-sub" data-t="waSub">على واتساب</span>
				</a>
				<a class="card card-tile" href="/help/" data-carry-source data-track="help">
					<span class="tile-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" class="stroke"><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><path d="M12 17h.01" /></svg>
					</span>
					<span class="tile-title" data-t="helpTitle">المساعدة</span>
					<span class="tile-sub" data-t="helpSub">الأسئلة الشائعة</span>
				</a>
			</div>
		</main>

		<footer class="foot">
			<a class="icon-btn" href={INSTAGRAM_URL} target="_blank" rel="noopener" data-track="instagram" aria-label="Instagram @docsera.app">
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" /><circle cx="12" cy="12" r="4.2" /><path d="M17.5 6.5h.01" /></svg>
			</a>
			<p class="legal">
				<a href="/privacy-policy/" data-t="privacy">سياسة الخصوصية</a>
				<span lang="en" dir="ltr">© 2026 DocSera</span>
			</p>
		</footer>
	</div>

	<div class="toast" role="status" aria-live="polite" data-toast></div>
</body>
</html>

<script>
	import { APP_STORE_URL, playUrl } from '../config/links';
	import { attributionSource, fireBeacon } from '../scripts/reach';

	const root = document.documentElement;
	const os = root.getAttribute('data-os') || 'desktop';
	const source = attributionSource();
	const tagged = source !== 'direct';

	// ------------------------------------------------------------ language
	const T: Record<'ar' | 'en', Record<string, string>> = {
		ar: {
			appTitle: 'حمّل التطبيق',
			appSub: 'احجز موعدك وتابع ملفك الطبي',
			appIos: 'مجاني على App Store',
			appAndroid: 'مجاني على Google Play',
			appDesktop: 'مجاني على App Store و Google Play',
			proSub: 'لإدارة العيادات والمراكز الطبية',
			proFor: 'للأطباء والمراكز',
			proJoin: 'ابدأ تجربتك المجانية',
			siteTitle: 'الموقع الرسمي',
			waTitle: 'تواصل معنا',
			waSub: 'على واتساب',
			helpTitle: 'المساعدة',
			helpSub: 'الأسئلة الشائعة',
			privacy: 'سياسة الخصوصية',
			share: 'مشاركة الصفحة',
			copied: 'تم نسخ الرابط',
		},
		en: {
			appTitle: 'Get the app',
			appSub: 'Book visits and keep your medical file',
			appIos: 'Free on the App Store',
			appAndroid: 'Free on Google Play',
			appDesktop: 'Free on the App Store and Google Play',
			proSub: 'Practice management for clinics and medical centres',
			proFor: 'For doctors and centres',
			proJoin: 'Start your free trial',
			siteTitle: 'Official website',
			waTitle: 'Contact us',
			waSub: 'On WhatsApp',
			helpTitle: 'Help',
			helpSub: 'Frequently asked questions',
			privacy: 'Privacy policy',
			share: 'Share this page',
			copied: 'Link copied',
		},
	};
	let lang: 'ar' | 'en' = root.classList.contains('pre-en') ? 'en' : 'ar';
	const langBtn = document.querySelector<HTMLButtonElement>('[data-lang]')!;

	function applyLang(next: 'ar' | 'en') {
		lang = next;
		root.lang = next;
		root.dir = next === 'ar' ? 'rtl' : 'ltr';
		root.classList.remove('pre-en');
		document.querySelectorAll<HTMLElement>('[data-t]').forEach((el) => {
			const v = T[next][el.dataset.t!];
			if (v) el.textContent = v;
		});
		document.querySelectorAll<HTMLElement>('[data-t-aria]').forEach((el) => {
			const v = T[next][el.dataset.tAria!];
			if (v) el.setAttribute('aria-label', v);
		});
		langBtn.textContent = next === 'ar' ? 'EN' : 'ع';
		langBtn.lang = next === 'ar' ? 'en' : 'ar';
		langBtn.setAttribute('aria-label', next === 'ar' ? 'Switch to English' : 'التبديل إلى العربية');
	}
	if (lang === 'en') applyLang('en');
	langBtn.addEventListener('click', () => {
		const next = lang === 'ar' ? 'en' : 'ar';
		document.body.classList.add('swapping');
		setTimeout(() => {
			applyLang(next);
			document.body.classList.remove('swapping');
		}, 160);
		try { localStorage.setItem('ds_links_lang', next); } catch { /* per-visit only */ }
	});

	// ------------------------------------------------------------ links
	// The app button: straight to this phone's store; desktop → /download.
	const app = document.querySelector<HTMLAnchorElement>('[data-app-link]')!;
	if (os === 'ios') app.href = APP_STORE_URL;
	else if (os === 'android') app.href = playUrl(tagged ? source : 'site');
	else if (tagged) app.href = '/download/?s=' + source;

	// Our own pages keep the visitor's source.
	if (tagged) {
		document.querySelectorAll<HTMLAnchorElement>('a[data-carry-source]').forEach((a) => {
			a.href += (a.href.includes('?') ? '&' : '?') + 's=' + source;
		});
	}

	// ------------------------------------------------------------ counting
	fireBeacon('links_page_viewed', 'acquisition', 'ds_beacon_links', { source, os });
	document.querySelectorAll<HTMLAnchorElement>('a[data-track]').forEach((a) => {
		a.addEventListener('click', () => {
			const link = a.dataset.track!;
			fireBeacon('links_link_clicked', 'acquisition', null, { link, source, os });
			if (link === 'app' && os !== 'desktop') {
				fireBeacon('store_link_clicked', 'acquisition', null, {
					store: os, surface: 'links', source,
				});
			}
		});
	});

	// ------------------------------------------------------------ share
	const toast = document.querySelector<HTMLElement>('[data-toast]')!;
	let toastTimer = 0;
	function say(msg: string) {
		toast.textContent = msg;
		toast.classList.add('on');
		clearTimeout(toastTimer);
		toastTimer = window.setTimeout(() => toast.classList.remove('on'), 2200);
	}
	document.querySelector('[data-share]')!.addEventListener('click', async () => {
		const url = 'https://docsera.app/links';
		try {
			if (navigator.share) {
				await navigator.share({ title: 'DocSera', text: 'Your health, connected.', url });
				return;
			}
		} catch (e) {
			if ((e as DOMException)?.name === 'AbortError') return;
		}
		try {
			await navigator.clipboard.writeText(url);
			say(T[lang].copied);
		} catch {
			window.prompt('', url);
		}
	});

	// ------------------------------------------------------------ light
	// Glass catches the light where the finger or pointer is; a press leaves
	// a ripple. The backdrop leans gently toward the pointer.
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
		const place = (e: PointerEvent) => {
			const r = card.getBoundingClientRect();
			card.style.setProperty('--mx', `${e.clientX - r.left}px`);
			card.style.setProperty('--my', `${e.clientY - r.top}px`);
		};
		card.addEventListener('pointermove', place);
		card.addEventListener('pointerenter', (e) => { place(e); card.classList.add('lit'); });
		card.addEventListener('pointerleave', () => card.classList.remove('lit'));
		card.addEventListener('pointerdown', (e) => {
			place(e);
			card.classList.add('lit');
			if (reduce) return;
			const r = card.getBoundingClientRect();
			const dot = document.createElement('span');
			dot.className = 'ripple';
			dot.style.left = `${e.clientX - r.left}px`;
			dot.style.top = `${e.clientY - r.top}px`;
			card.appendChild(dot);
			dot.addEventListener('animationend', () => dot.remove());
		});
		card.addEventListener('pointerup', (e) => {
			if (e.pointerType !== 'mouse') setTimeout(() => card.classList.remove('lit'), 380);
		});
		card.addEventListener('pointercancel', () => card.classList.remove('lit'));
	});

	if (!reduce) {
		let raf = 0;
		let tx = 0, ty = 0;
		window.addEventListener('pointermove', (e) => {
			tx = e.clientX / window.innerWidth - 0.5;
			ty = e.clientY / window.innerHeight - 0.5;
			if (raf) return;
			raf = requestAnimationFrame(() => {
				raf = 0;
				root.style.setProperty('--px', tx.toFixed(3));
				root.style.setProperty('--py', ty.toFixed(3));
			});
		}, { passive: true });
	}
</script>

<style>
	/* ---------------------------------------------------------- backdrop */
	.sky {
		position: fixed;
