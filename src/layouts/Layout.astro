---
import AppBar from '../components/AppBar.astro';
import { APP_STORE_ID } from '../config/links';

interface Props {
	title: string;
	description?: string;
	image?: string;
	path?: string;
	// iOS Smart App Banner. 'site' = plain banner; 'entity' = the doctor /
	// center shells, where the banner's Open button carries the current
	// profile URL into the app; 'none' = no banner.
	appBanner?: 'site' | 'entity' | 'none';
	// Our own "get the app" bar for phones where Apple's banner never shows
	// (Android, and in-app browsers on iPhone). Pages that are themselves a
	// download surface turn it off.
	appBar?: boolean;
}

const {
	title,
	description = 'دوكسيرا — منصة الرعاية الصحية الرقمية في سوريا. احجز مواعيدك، تواصل مع طبيبك، واحفظ ملفك الطبي في مكان واحد.',
	image = '/og-image.png',
	path = '',
	appBanner = 'site',
	appBar = true,
} = Astro.props;

const SITE = 'https://docsera.app';
const canonical = SITE + path;
const ogImage = image.startsWith('http') ? image : SITE + image;
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!-- Marker for scroll-reveal animations: without JS the sections must stay
		     visible (flaky connections in Syria drop scripts more often than HTML),
		     so the hidden state only applies when this class is present. -->
		<script is:inline>document.documentElement.classList.add('js');</script>

		<!-- Which phone is this? Decided before first paint so the store
		     badges and the app bar never flash the wrong state. Without JS
		     the page simply shows both stores. -->
		<script is:inline define:vars={{ appBar }}>
			(function () {
				var d = document.documentElement, u = navigator.userAgent || '';
				var ios = /iPad|iPhone|iPod/.test(u) && !window.MSStream;
				// iPadOS 13+ presents itself as a Mac.
				if (!ios && /Macintosh/.test(u) && navigator.maxTouchPoints > 1) ios = true;
				var android = /Android/i.test(u);
				d.setAttribute('data-os', ios ? 'ios' : android ? 'android' : 'desktop');
				if (!appBar || (!ios && !android)) return;
				// Real Safari shows Apple's own Smart App Banner — don't stack ours
				// on top of it. In-app browsers (Instagram, Facebook…) and other
				// iOS browsers never show Apple's, so they get ours.
				var realSafari = ios && /Version\//.test(u) && /Safari\//.test(u) &&
					!/CriOS|FxiOS|EdgiOS|OPiOS|Instagram|FBAN|FBAV|FB_IAB/.test(u);
				if (realSafari) return;
				try {
					var t = +localStorage.getItem('ds_appbar_x') || 0;
					if (t && Date.now() - t < 14 * 864e5) return; // dismissed in the last 14 days
				} catch (e) { /* storage blocked → show */ }
				d.classList.add('has-appbar');
			})();
		</script>

		{appBanner === 'site' && (
			<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
		)}
		{appBanner === 'entity' && (
			<Fragment>
				<!-- /doctor/<token> and /center/<id> are one static shell each, so
				     the profile URL is only known in the browser. Written while the
				     head is still parsing, which is when Safari reads this tag. Both
				     interpolated values are matched against strict patterns first. -->
				<script is:inline define:vars={{ appId: APP_STORE_ID }}>
					(function () {
						var c = 'app-id=' + appId;
						var m = location.pathname.match(/^\/(doctor|center)\/([A-Za-z0-9_-]{1,64})\/?$/);
						if (m) {
							var s = new URLSearchParams(location.search).get('s') || '';
							c += ', app-argument=https://docsera.app/' + m[1] + '/' + m[2] +
								(/^[a-z_]{1,24}$/.test(s) ? '?s=' + s : '');
						}
						document.write('<meta name="apple-itunes-app" content="' + c + '">');
					})();
				</script>
				<noscript><meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} /></noscript>
			</Fragment>
		)}

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="DocSera" />
		<meta property="og:locale" content="ar_SY" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Self-hosted fonts (no Google Fonts dependency — fast & reliable in Syria).
		     Preload the two most-used Cairo weights for first paint; the rest load
		     on demand via the @font-face rules in the global stylesheet below. -->
		<link rel="preload" href="/fonts/Cairo-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Cairo-700.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		{appBar && <AppBar />}
		<slot />
	</body>
</html>

<script>
	import { APP_STORE_URL, playUrl } from '../config/links';

	// Every link below already works without this script (/download, or a
	// plain store URL). This only sharpens them for the visitor's phone.
	const os = document.documentElement.getAttribute('data-os');
	const s = new URLSearchParams(window.location.search).get('s') || '';
	const medium = /^[a-z_]{1,24}$/.test(s) ? s : 'site';

	// Keep the visitor's source (?s=instagram, ?s=qr…) on the Play links so
	// it reaches Play Console and, through the install referrer, the app.
	// Pages that build a richer link themselves mark it data-play-fixed.
	if (medium !== 'site') {
		document.querySelectorAll<HTMLAnchorElement>('a[data-play-link]:not([data-play-fixed])')
			.forEach((a) => { a.href = playUrl(medium); });
	}

	// "حمّل التطبيق" buttons: straight to the right store on a phone, the
	// download page everywhere else.
	document.querySelectorAll<HTMLAnchorElement>('a[data-store-smart]').forEach((a) => {
		if (os === 'ios') a.href = APP_STORE_URL;
		else if (os === 'android') a.href = playUrl(medium);
	});
</script>

<style is:global>
	/* ---- Self-hosted fonts (Cairo = Arabic, Montserrat = Latin) ----
	   font-display: swap keeps text instantly readable; because the files
	   are same-origin woff2 the swap is near-instant (no Google round-trip). */
	@font-face { font-family: 'Cairo'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/Cairo-400.woff2') format('woff2'); }
	@font-face { font-family: 'Cairo'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/Cairo-600.woff2') format('woff2'); }
	@font-face { font-family: 'Cairo'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/Cairo-700.woff2') format('woff2'); }
	@font-face { font-family: 'Cairo'; font-style: normal; font-weight: 800; font-display: swap; src: url('/fonts/Cairo-800.woff2') format('woff2'); }
	@font-face { font-family: 'Montserrat'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/Montserrat-400.woff2') format('woff2'); }
	@font-face { font-family: 'Montserrat'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/Montserrat-500.woff2') format('woff2'); }
	@font-face { font-family: 'Montserrat'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/Montserrat-600.woff2') format('woff2'); }
	@font-face { font-family: 'Montserrat'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/Montserrat-700.woff2') format('woff2'); }

	:root {
		/* Palette */
		--c-main: #009092;
		--c-main-dark: #007474;
		--c-main-light: #E0F2F2;
		--c-orange: #FFA070;
		--c-sand: #EAE0D5;
		--c-sand-light: #F7F5F2;
		--c-text: #2D3436;
		--c-text-muted: #636E72;
		--c-white: #FFFFFF;

		/* Fonts */
		--font-ar: 'Cairo', sans-serif;
		--font-en: 'Montserrat', sans-serif;
	}

	/* Optimized Typography */
	html {
		font-family: var(--font-ar);
		background: #FAFAFA;
		color: var(--c-text);
		scroll-behavior: smooth;
        /* Base Fluid Font Size */
        font-size: 16px; 
	}
    
    @media (max-width: 768px) {
        html { font-size: 14px; }
    }

	body {
		margin: 0;
		padding: 0;
		overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
	}

	h1, h2, h3, h4 { font-family: var(--font-ar); margin: 0; }
    
    /* Global Heading Classes */
    .text-huge {
        font-size: clamp(2.5rem, 5vw, 4rem); /* Responsive Headline */
        line-height: 1.1;
        letter-spacing: -1px;
    }
    
    .text-title {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        line-height: 1.2;
    }
    
    p {
        font-size: 1.1rem;
        line-height: 1.7;
    }
	
	.font-en { font-family: var(--font-en); }

	/* Utility: Container */
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px; /* More breathing room on mobile */
	}

	/* Animation Classes — hidden state only when JS is running (html.js is set
	   by the inline script in <head>). Without JS everything stays visible. */
	html.js .fade-up {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}

	html.js .fade-up.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Same no-JS guard for the scroll-revealed feature rows (FeaturesList.astro
	   defines their hidden state in a scoped style; this override wins when JS
	   is absent). Also disable reveal motion for reduced-motion users. */
	html:not(.js) .feature-item {
		opacity: 1 !important;
		transform: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.fade-up, .feature-item {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
	}

	.float {
		animation: float 6s ease-in-out infinite;
	}

	@keyframes float {
		0% { transform: translateY(0px); }
		50% { transform: translateY(-15px); }
		100% { transform: translateY(0px); }
	}
</style>
