---
// The header of every DocSera Pro page: dark glass, the Pro logo, and its own links.
const { current = '', cta = { href: '/pro/join', label: 'ابدأ التجربة' } } = Astro.props as { current?: string; cta?: { href: string; label: string } };
const LINKS = [
	['features', '/pro#features', 'الميزات'],
	['day', '/pro/day', 'يوم في العيادة'],
	['centers', '/pro#centers', 'للمراكز'],
];
---
<header class="ph">
	<a href="/pro" class="ph-logo" aria-label="DocSera Pro"><img src="/images/pro/logo-full-teal.png" alt="DocSera Pro" width="108" height="24" /></a>
	<nav class="ph-nav" aria-label="أقسام DocSera Pro">
		{LINKS.map(([key, href, label]) => <a href={href} aria-current={key === current ? 'page' : undefined}>{label}</a>)}
	</nav>
	<div class="ph-end">
		<a href="/" class="ph-site">موقع DocSera</a>
		<a href={cta.href} class="ph-cta">{cta.label}</a>
		<details class="ph-menu" data-ph-menu>
			<summary aria-label="القائمة" title="القائمة"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></summary>
			<nav class="ph-drop" aria-label="القائمة">
				<a href="/pro">DocSera Pro</a>
				{LINKS.map(([key, href, label]) => <a href={href} aria-current={key === current ? 'page' : undefined}>{label}</a>)}
				<a href="/" class="ph-out">موقع DocSera للمرضى</a>
			</nav>
		</details>
	</div>
</header>

<script is:inline>
	(function () {
		var m = document.querySelector('[data-ph-menu]');
		if (!m) return;
		document.addEventListener('click', function (e) { if (m.open && !m.contains(e.target)) m.open = false; });
		document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && m.open) { m.open = false; m.querySelector('summary').focus(); } });
	})();
</script>

<style>
	.ph { position: fixed; z-index: 50; top: 10px; left: 50%; translate: -50% 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; width: min(1180px, calc(100% - 20px)); height: 56px; box-sizing: border-box; padding-inline: 18px 8px; background: rgba(16, 27, 34, .82); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border: 1px solid rgba(255, 255, 255, .11); border-radius: 18px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08), 0 16px 34px -22px #000; }
	.ph-logo img { display: block; width: auto; height: 22px; }
	.ph-nav { display: flex; gap: 26px; }
	.ph-nav a { color: #C9D8DB; font-size: .96rem; font-weight: 700; text-decoration: none; }
	.ph-nav a:hover, .ph-nav a[aria-current] { color: #7DD3D4; }
	.ph-end { display: flex; align-items: center; gap: 10px; }
	.ph-site { color: #9FB4B8; font-size: .88rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
	.ph-site:hover { color: #fff; }
	.ph-cta { padding: 9px 16px; color: #04181C; font-size: .92rem; font-weight: 800; text-decoration: none; white-space: nowrap; background: linear-gradient(180deg, #7DD3D4, #00B5B7); border-radius: 12px; }
	.ph a:focus-visible, .ph-menu summary:focus-visible { outline: 2px solid #7DD3D4; outline-offset: 2px; border-radius: 8px; }
	.ph-menu { display: none; position: static; }
	.ph-menu summary { display: grid; place-items: center; width: 40px; height: 40px; color: #E8EEF0; cursor: pointer; border-radius: 12px; list-style: none; }
	.ph-menu summary::-webkit-details-marker { display: none; }
	.ph-menu[open] summary { color: #7DD3D4; background: rgba(0, 181, 183, .16); }
	.ph-menu svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
	.ph-drop { position: absolute; top: calc(100% + 8px); inset-inline: 0; display: grid; padding: 8px; background: #15222A; border: 1px solid rgba(255, 255, 255, .12); border-radius: 18px; box-shadow: 0 24px 46px -18px #000; }
	.ph-drop a { padding: 12px 14px; color: #E8EEF0; font-size: 1.04rem; font-weight: 700; text-decoration: none; border-radius: 12px; }
	.ph-drop a:hover, .ph-drop a[aria-current] { color: #7DD3D4; background: rgba(0, 181, 183, .13); }
	.ph-drop .ph-out { margin-top: 4px; color: #9FB4B8; border-top: 1px solid rgba(255, 255, 255, .09); border-radius: 0 0 12px 12px; }
	@media (max-width: 1040px) { .ph-site { display: none; } }
	@media (max-width: 899px) {
		.ph-nav { display: none; }
		.ph-menu { display: block; }
		.ph-cta { padding: 9px 13px; font-size: .88rem; }
		.ph-end { gap: 6px; }
	}
</style>
