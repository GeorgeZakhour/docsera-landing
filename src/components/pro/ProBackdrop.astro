---
// The identity of every DocSera Pro page: the working desk at night. The patient site has
// the teal silk; Pro has graphite and the lines of a doctor's schedule, with a few
// appointments lit on them. No images, so it costs nothing on a weak connection.
// `fixed` keeps it behind a whole page; without it, it fills its positioned parent.
const { fixed = true } = Astro.props as { fixed?: boolean };
const SLOTS = [
	[0, 1, 2], [0, 5, 1], [1, 3, 2], [1, 8, 2], [2, 0, 1], [2, 6, 2],
	[4, 2, 1], [4, 7, 2], [5, 0, 2], [5, 4, 1], [6, 2, 2], [6, 6, 1], [6, 9, 2],
];
---
<div class:list={['pbg', { fixed }]} aria-hidden="true">
	<div class="grid">
		{SLOTS.map(([c, r, h], i) => <i style={`--c:${c};--r:${r};--h:${h};--a:${0.45 + (i % 4) * 0.18}`}></i>)}
	</div>
	<b class="light"></b>
</div>

<style>
	.pbg { --col: calc(100vw / 7); --row: 68px; position: absolute; inset: 0; overflow: hidden; pointer-events: none; background: linear-gradient(180deg, #0D171E 0%, #0A1218 58%, #070D12 100%); }
	.pbg.fixed { position: fixed; z-index: 0; }
	.grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(125, 211, 212, .075) 1px, transparent 1px), linear-gradient(90deg, rgba(125, 211, 212, .06) 1px, transparent 1px); background-size: var(--col) var(--row); -webkit-mask-image: radial-gradient(95% 82% at 50% 20%, #000 22%, rgba(0, 0, 0, .34) 62%, transparent 92%); mask-image: radial-gradient(95% 82% at 50% 20%, #000 22%, rgba(0, 0, 0, .34) 62%, transparent 92%); }
	.grid i { position: absolute; left: calc(var(--col) * var(--c) + 4px); top: calc(var(--row) * var(--r) + 4px); width: calc(var(--col) - 8px); height: calc(var(--row) * var(--h) - 8px); box-sizing: border-box; background: linear-gradient(160deg, rgba(0, 181, 183, .17), rgba(0, 181, 183, .05)); border: 1px solid rgba(125, 211, 212, .12); border-left: 2px solid rgba(125, 211, 212, .5); border-radius: 7px; opacity: var(--a); }
	.light { position: absolute; top: -34vh; left: 50%; width: 130vw; height: 76vh; background: radial-gradient(closest-side, rgba(0, 181, 183, .17), rgba(0, 181, 183, 0)); transform: translateX(-50%); }
	@media (max-width: 899px) { .pbg { --col: calc(100vw / 4); --row: 60px; } }
</style>
