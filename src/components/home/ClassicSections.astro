---
// The four closing sections of the previous home page, kept as the founder likes
// them (2026-11-23): the comparison, DocSera Pro with its floating cards, the help
// card, and the teal download wave. Same markup and styles; three lines of copy
// were corrected to what the app really does.
import StoreBadges from '../StoreBadges.astro';
import { WEB_APP_URL } from '../../config/links';
---

<div class="classic">
        <!-- High-Impact Comparison: Chaos vs Clarity (Light Version) -->
        <section class="chaos-vs-clarity">
            <div class="c-container">
                <!-- The Old Way (Chaos) -->
                <div class="side-old">
                    <div class="pattern-grid"></div>
                    <div class="content-box fade-up">
                        <div class="label-badge chaos">الطريقة التقليدية</div>
                        <h3 class="chaos-title">فوضى، انتظار،<br>وتفاصيل ضائعة.</h3>
                        <div class="chaos-list">
                            <div class="c-item">
                                <svg class="c-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/><line x1="23" y1="1" x2="17" y2="7"/><line x1="17" y1="1" x2="23" y2="7"/></svg>
                                <span>خط مشغول واتصالات لا تنتهي</span>
                            </div>
                            <div class="c-item">
                                <svg class="c-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                <span>وصفات طبية ورقية تضيع بسهولة</span>
                            </div>
                            <div class="c-item">
                                <svg class="c-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span>ساعات انتظار طويلة في العيادة</span>
                            </div>
                            <div class="c-item">
                                <svg class="c-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                <span>تاريخ طبي مفقود وتشخيص ناقص</span>
                            </div>
                             <div class="c-item">
                                <svg class="c-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                <span>مواعيد غير دقيقة وعشوائية</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- The DocSera Way (Clarity) -->
                <div class="side-new">
                    <div class="glass-portal fade-up delay-1">
                        <!-- <div class="glow-underlay"></div> -->
                        <div class="portal-content">
                            <div class="label-badge clarity">طريقة DocSera</div>
                            <h3 class="clarity-title">تحكم كامل،<br>ورعاية ذكية.</h3>
                            <div class="clarity-features">
                                <div class="f-item">
                                    <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
                                    <div class="f-text">
                                        <strong>سجلك الطبي بأمان</strong>
                                        <small>كل تفاصيلك الصحية محمية ومشفرة</small>
                                    </div>
                                </div>
                                <div class="f-item">
                                    <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="8" y1="14" x2="16" y2="14"/></svg></div>
                                    <div class="f-text">
                                        <strong>احجز في أي وقت</strong>
                                        <small>اختر الوقت المناسب لك بضغطة زر</small>
                                    </div>
                                </div>
                                <div class="f-item">
                                    <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
                                    <div class="f-text">
                                        <strong>رعاية لكل العائلة</strong>
                                        <small>ملفات مستقلة لأطفالك وأحبائك</small>
                                    </div>
                                </div>
                                 <div class="f-item">
                                    <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
                                    <div class="f-text">
                                        <strong>تواصل مباشر</strong>
                                        <small>راسل عيادتك لتنظيم مواعيدك ومتابعتها</small>
                                    </div>
                                </div>
                                <div class="f-item">
                                    <div class="icon-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
                                    <div class="f-text">
                                        <strong>تحديثات فورية</strong>
                                        <small>تنبيهات بمواعيدك وتقاريرك ووثائقك</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- DocSera Pro Section (Dark Glassmorphism) -->
        <section class="docsera-pro-section">
            <div class="container">
                <div class="pro-glass-card fade-up">
                    <div class="pro-content">
                        <div class="pro-badge">للأطباء والمختصين</div>
                        <h2 class="pro-title">هل أنت طبيب أو مختص؟</h2>
                        <p class="pro-desc">انضم إلى <strong>DocSera Pro</strong>. المنصة المتكاملة لإدارة عيادتك، تنظيم مواعيدك، والتواصل مع مرضاك بكفاءة عالية وبأدوات احترافية صممت خصيصاً لك.</p>
                    </div>
                    
                    <div class="pro-action">
                        <a href="/pro" class="btn-pro">
                            <span>اكتشف DocSera Pro</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        </a>
                    </div>
                    
                    <div class="pro-visual">
                         <!-- Abstract Pro UI Elements -->
                         <div class="pro-ui-card card-1">
                            <div class="ui-header">
                                <div class="ui-dot red"></div><div class="ui-dot yellow"></div><div class="ui-dot green"></div>
                            </div>
                            <div class="ui-body">
                                <div class="ui-line w-70"></div>
                                <div class="ui-line w-50"></div>
                                <div class="ui-row">
                                    <div class="ui-box"></div>
                                    <div class="ui-box"></div>
                                </div>
                            </div>
                         </div>
                         <div class="pro-ui-card card-2">
                            <div class="ui-icon-circle">
                                 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            </div>
                            <div class="ui-line w-100"></div>
                         </div>
                         
                         <!-- App Icon -->
                         <div class="pro-app-icon">
                             <img src="/images/docsera-pro-icon.webp" alt="DocSera Pro" loading="lazy" decoding="async" />
                         </div>

                         <!-- Glow Effect -->
                         <div class="pro-glow"></div>
                    </div>
                </div>
            </div>
        </section>
        <section class="faq-bridge">
            <div class="container fade-up">
                <div class="help-card">
                    <div class="help-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                           <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                        </svg>
                    </div>
                    <div class="help-content">
                        <h3 class="help-title">هل لديك استفسارات؟</h3>
                        <p class="help-text">لقد جمعنا لك إجابات مفصلة عن كل ما يخص DocSera في مكان واحد.</p>
                    </div>
                    <div class="help-action">
                        <a href="/help" class="btn-help">
                            تصفح الأسئلة الشائعة
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Wave + Download Hub -->
        <section class="final-cta" id="download">
            <div class="wave-top">
                <svg viewBox="0 0 1440 180" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#ffffff" fill-opacity="1" d="M0,0 L1440,0 L1440,180 Q720,60 0,180 Z"></path>
                </svg>
            </div>

            <div class="container cta-content">
                <h2 class="text-huge" style="color:white">ابدأ رحلتك الصحية اليوم</h2>
                <p>مستقبل الطب الرقمي، يبدأ في سوريا</p>

                <StoreBadges size="lg" adaptive />

                <div class="cta-more">
                    <a href={WEB_APP_URL}>أو استخدمه من المتصفح دون تثبيت</a>
                    <a href="/download">كل طرق التحميل</a>
                </div>
            </div>
        </section>
</div>

<script>
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) entry.target.classList.add('visible');
		});
	});
	document.querySelectorAll('.classic .fade-up').forEach((el) => observer.observe(el));
</script>

<style>
    .classic { background: #fff; overflow-x: clip; }
    /* Final CTA */
    .final-cta {
        background: var(--c-main);
        color: white;
        /* padding-bottom: 100px; */
    }
    .cta-content { padding: 60px 0 100px; text-align: center; }
    .cta-content p { color: rgba(255,255,255,0.9); margin-bottom: 40px; font-size: 1.2rem; }
    /* Download block: the official store badges, then two quiet links. */
    .cta-more {
        display: flex;
        gap: 12px 28px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
    }
    .cta-more a {
        color: rgba(255,255,255,0.92);
        font-weight: 700;
        font-size: 1rem;
        text-decoration: underline;
        text-decoration-color: rgba(255,255,255,0.4);
        text-underline-offset: 5px;
        transition: text-decoration-color 0.2s;
    }
    .cta-more a:hover { text-decoration-color: #fff; }
    .cta-more a:focus-visible { outline: 3px solid #fff; outline-offset: 4px; border-radius: 4px; }

    /* High-Impact Comparison (Light Theme) */
    .chaos-vs-clarity {
        padding: 100px 0;
        display: flex;
        align-items: center;
        background: #FFFFFF;
        position: relative;
        overflow: hidden;
    }
    
    .c-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        gap: 60px;
        align-items: center;
        padding: 0 40px;
    }

    /* OLD SIDE (CHAOS) - Light/Messy */
    .side-old {
        position: relative;
        background: #F9F9F9;
        border-radius: 40px;
        padding: 60px 40px;
        border: 1px dashed #E0E0E0;
    }
    .pattern-grid {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background-image: radial-gradient(#E0E0E0 1px, transparent 1px);
        background-size: 20px 20px;
        opacity: 0.5;
        border-radius: 40px;
    }
    
    .label-badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 24px;
        text-transform: uppercase;
    }
    .label-badge.chaos { background: #EAEAEA; color: #888; }
    
    .chaos-title {
        font-size: 2.8rem;
        color: #B0B0B0;
        line-height: 1.1;
        font-weight: 800;
        margin-bottom: 40px;
        letter-spacing: -1px;
    }
    
    .chaos-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .c-item {
        display: flex;
        align-items: center;
        gap: 16px;
        opacity: 0.7;
    }
    .c-icon {
        width: 24px;
        height: 24px;
        stroke: #999;
        flex-shrink: 0;
    }
    .c-item span {
        color: #888;
        font-size: 1.1rem;
        font-weight: 500;
        text-decoration: line-through; /* Crossed out effect for emphasis */
        text-decoration-color: rgba(0,0,0,0.1);
    }

    /* NEW SIDE (CLARITY) - Light/Glass */
    .side-new {
        position: relative;
        /* No background container, just the card */
    }
    
    .glass-portal {
        position: relative;
        width: 100%;
        background: linear-gradient(135deg, #FFFFFF, #F0FFFF);
        border: 1px solid rgba(0, 144, 146, 0.15);
        border-radius: 40px;
        padding: 60px 50px;
        box-shadow: 
            0 30px 60px -12px rgba(0, 144, 146, 0.12),
            0 18px 36px -18px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .glass-portal:hover { 
        transform: translateY(-8px);
        box-shadow: 
            0 40px 70px -12px rgba(0, 144, 146, 0.2),
            0 22px 42px -18px rgba(0, 0, 0, 0.08);
    }

    .portal-content { position: relative; z-index: 2; }
    
    .label-badge.clarity { 
        background: rgba(0, 144, 146, 0.1); 
        color: var(--c-main); 
    }
    
    .clarity-title {
        font-size: 3rem;
        color: #1a1a1a;
        line-height: 1.1;
        font-weight: 900;
        margin-bottom: 50px;
        letter-spacing: -1px;
    }
    
    .clarity-features {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }
    .f-item {
        display: flex;
        align-items: flex-start; /* Align top for subtitle */
        gap: 20px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(0, 144, 146, 0.08);
    }
    .f-item:last-child { border-bottom: none; padding-bottom: 0; }
    
    .icon-box {
        width: 48px;
        height: 48px;
        background: rgba(0, 144, 146, 0.1);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--c-main);
        flex-shrink: 0;
    }
    .icon-box svg { width: 24px; height: 24px; }
    
    .f-text { display: flex; flex-direction: column; }
    .f-text strong {
        font-size: 1.25rem;
        color: #1a1a1a;
        font-weight: 700;
        margin-bottom: 4px;
    }
    .f-text small {
        font-size: 0.95rem;
        color: #666;
        line-height: 1.4;
    }

    @media (max-width: 900px) {
        .c-container { grid-template-columns: 1fr; gap: 30px; padding: 0 16px; }
        .chaos-vs-clarity { padding: 40px 0; }

        .side-old, .side-new { 
            width: 100%; 
            margin: 0; 
            order: initial; 
            box-sizing: border-box; 
        }
        .side-old { order: 2; padding: 40px 24px; }
        .side-new { order: 1; margin-bottom: 20px; padding: 0; }

        .glass-portal { 
            width: 100%; max-width: 100%; 
            padding: 30px 20px; 
            border-radius: 24px; 
            box-sizing: border-box; 
        }
        .portal-content { width: 100%; }
        .clarity-features { width: 100%; }
        .f-item { width: 100%; }
        .clarity-title { font-size: 2rem; margin-bottom: 20px; word-wrap: break-word;}
        .chaos-title { font-size: 1.8rem; margin-bottom: 20px; }
        .f-item { gap: 12px; }
        .icon-box { width: 36px; height: 36px; min-width: 36px; }
        .icon-box svg { width: 18px; height: 18px; }
        .f-text strong { font-size: 1rem; }
        .f-text small { font-size: 0.8rem; }
        
        .mockup-scaler {
            transform: scale(0.45);
            height: 600px;
        }
    }
    /* DocSera Pro Section (Dark Theme) */
    .docsera-pro-section { padding: 80px 0; }
    
    .pro-glass-card {
        background: #0f1515; /* Very Dark Teal/Black */
        background-image: radial-gradient(circle at top right, #1a2a2a, #0f1515);
        border-radius: 30px;
        padding: 60px;
        position: relative;
        overflow: hidden;
        color: white;
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.1);
        
        /* Desktop Grid Layout */
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-areas: 
            "content visual"
            "action visual";
        gap: 40px;
        align-items: center;
    }
    
    /* Grid Areas */
    .pro-content { grid-area: content; z-index: 2; position: relative; }
    .pro-action { grid-area: action; z-index: 2; position: relative; align-self: start; }
    .pro-visual { 
        grid-area: visual; 
        height: 100%; 
        min-height: 300px; 
        position: relative; 
        display: flex; 
        align-items: center; 
        justify-content: center;
    }
    
    .pro-badge {
        display: inline-block;
        background: rgba(0, 144, 146, 0.2);
        color: #00E0E3;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 20px;
        border: 1px solid rgba(0, 144, 146, 0.3);
    }
    
    .pro-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 20px;
        line-height: 1.2;
        background: linear-gradient(to right, #fff, #bcecec);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .pro-desc {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.7);
        margin: 0;
        line-height: 1.7;
        max-width: 500px;
    }
    .pro-desc strong { color: white; }
    
    .btn-pro {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(0, 144, 146, 0.8); /* Glassy Main Color */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        padding: 16px 32px;
        border-radius: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px -5px rgba(0, 144, 146, 0.4);
    }
    .btn-pro:hover {
        background: rgba(0, 144, 146, 0.95);
        border-color: rgba(255, 255, 255, 0.4);
        box-shadow: 0 0 30px rgba(0, 224, 227, 0.4);
        transform: translateY(-2px);
    }
    .btn-pro svg { width: 20px; height: 20px; }
    
    /* Visual Cards (Abstract) */
    .pro-ui-card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        position: absolute;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .card-1 {
        width: 260px; height: 180px;
        z-index: 2;
        padding: 15px;
        top: 40px; right: 40px;
        transform: rotate(-5deg);
        animation: floatPro 6s ease-in-out infinite;
    }
    .card-2 {
        width: 180px; height: 120px;
        z-index: 3;
        bottom: 30px; left: 40px;
        background: rgba(30,30,30,0.6);
        padding: 15px;
        transform: rotate(5deg);
        animation: floatPro 6s ease-in-out infinite 1s; /* delay */
    }
    
    /* UI Internal Deco */
    .ui-header { display: flex; gap: 6px; margin-bottom: 15px; }
    .ui-dot { width: 8px; height: 8px; border-radius: 50%; opacity: 0.5; }
    .ui-dot.red { background: #ff5f56; }
    .ui-dot.yellow { background: #ffbd2e; }
    .ui-dot.green { background: #27c93f; }
