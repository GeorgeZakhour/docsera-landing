---
// The end of the home page, one continuous scene: a cluttered desk → the scan of
// light turns each paper into its tidy card → night → the clinic side → sunrise.
// No images beyond what the page already loaded, except the small Pro icon.
// Without JS or with reduced motion the same content is a plain column.
import StoreBadges from '../StoreBadges.astro';
import { WEB_APP_URL } from '../../config/links';

const I = {
	phone: '<path d="M10.7 13.3a13 13 0 0 1-2.2-3l1.4-1.4a1.5 1.5 0 0 0 .3-1.7L9 4.6a1.5 1.5 0 0 0-1.6-.8L5 4.4a2 2 0 0 0-1.5 2.1 17 17 0 0 0 14 14 2 2 0 0 0 2.1-1.5l.6-2.4a1.5 1.5 0 0 0-.8-1.6l-2.6-1.2a1.5 1.5 0 0 0-1.7.3l-1.4 1.4a13 13 0 0 1-3-2.2"/><path d="M16 3l5 5M21 3l-5 5"/>',
	paper: '<path d="M7 3h7l4 4v14H7z"/><path d="M10 12h5M10 16h5"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M12 11v3M12 17h.01"/>',
	cal: '<rect x="4" y="5" width="16" height="15" rx="3"/><path d="M4 10h16M9 3v4M15 3v4"/>',
	shield: '<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
	bell: '<path d="M6 16V11a6 6 0 1 1 12 0v5l2 2H4z"/><path d="M10 21h4"/>',
	family: '<circle cx="9" cy="8" r="3.5"/><path d="M3 20c.5-4 3-6 6-6s5.500 2 6 6"/><path d="M16 5a3.300 3.300 0 0 1 0 6.400M18 14.500c1.700.8 2.700 2.800 3 5.500"/>',
	chat: '<path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 4z"/>',
};

// Each pain sits exactly where its answer will land.
const PAIRS = [
	{ old: 'خط مشغول واتصالات لا تنتهي', kind: 'sticky', oi: I.phone, t: 'احجز في أي وقت', s: 'اختر الوقت المناسب لك بضغطة زر', ni: I.cal },
	{ old: 'وصفات طبية ورقية تضيع بسهولة', kind: 'rx', oi: I.paper, t: 'سجلك الطبي بأمان', s: 'كل تفاصيلك الصحية محمية ومشفرة', ni: I.shield },
	{ old: 'ساعات انتظار طويلة في العيادة', kind: 'ticket', oi: I.clock, t: 'تحديثات فورية', s: 'تنبيهات بمواعيدك وتقاريرك ووثائقك', ni: I.bell },
	{ old: 'تاريخ طبي مفقود وتشخيص ناقص', kind: 'folder', oi: I.folder, t: 'رعاية لكل العائلة', s: 'ملفات مستقلة لأطفالك وأحبائك', ni: I.family },
	{ old: 'مواعيد غير دقيقة وعشوائية', kind: 'index', oi: I.cal, t: 'تواصل مباشر', s: 'راسل عيادتك لتنظيم مواعيدك ومتابعتها', ni: I.chat },
];
---
<section class="cmp" data-cmp aria-label="الفرق بين الطريقة التقليدية وطريقة DocSera">
	<div class="cmp-stage" data-cmp-stage>
		<div class="cmp-desk" aria-hidden="true">
			<i class="cmp-junk j1"></i><i class="cmp-junk j2"></i><i class="cmp-junk j3"></i><i class="cmp-junk j4"></i><i class="cmp-junk j5"></i>
		</div>
		<div class="cmp-head cmp-head-old">
			<span class="cmp-tag">الطريقة التقليدية</span>
			<p class="cmp-ttl">فوضى، انتظار،<br />وتفاصيل ضائعة.</p>
		</div>
		<div class="cmp-night" data-cmp-night>
			<div class="cmp-night-in" data-cmp-night-in>
				<i class="cmp-au"></i>
				<div class="cmp-head cmp-head-new">
					<span class="cmp-tag">طريقة DocSera</span>
					<h2 class="cmp-ttl">تحكم كامل،<br />ورعاية ذكية.</h2>
				</div>
			</div>
		</div>
		<ul class="cmp-list">
			{PAIRS.map((p) => (
				<li class="cmp-pair" data-pair>
					<div class="cmp-card" data-pair-in>
						<div class={`cmp-face cmp-old k-${p.kind}`}>
							<svg viewBox="0 0 24 24" aria-hidden="true" set:html={p.oi} />
							<span>{p.old}</span>
							{p.kind === 'ticket' && <em aria-hidden="true">47</em>}
						</div>
						<div class="cmp-face cmp-new">
							<i><svg viewBox="0 0 24 24" aria-hidden="true" set:html={p.ni} /></i>
							<span><b>{p.t}</b><small>{p.s}</small></span>
						</div>
					</div>
				</li>
			))}
		</ul>
		<div class="cmp-line" data-cmp-line>
			<button class="cmp-grip" type="button" data-cmp-grip role="slider" aria-label="قارن بين الطريقتين" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
				<img src="/images/DocSera-shape-main.svg" alt="" width="24" height="24" />
			</button>
			<span class="cmp-hint" data-cmp-hint aria-hidden="true">اسحب للأسفل</span>
		</div>
	</div>
</section>

<section class="pv" data-pro>
	<div class="pv-wrap">
                <div class="pro-glass-card">
                    <div class="pro-content">
                        <div class="pro-badge">للأطباء والمختصين والمراكز الطبية</div>
                        <h2 class="pro-title">هل أنت طبيب، مختص، أو صاحب مركز طبي؟</h2>
                        <p class="pro-desc">انضم إلى <strong>DocSera Pro</strong>. المنصة المتكاملة لإدارة عيادتك أو مركزك، تنظيم مواعيدك، والتواصل مع مرضاك بكفاءة عالية وبأدوات احترافية صممت خصيصاً لك.</p>
                    </div>
                    
                    <div class="pro-action">
                        <a href="/pro" class="btn-pro">
                            <span>اكتشف DocSera Pro</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        </a>
                    </div>
                    
                    <div class="pro-visual">
                         <!-- Abstract Pro UI Elements -->
                         <div class="pro-ui-card card-1">
                            <div class="ui-header">
                                <div class="ui-dot red"></div><div class="ui-dot yellow"></div><div class="ui-dot green"></div>
                            </div>
                            <div class="ui-body">
                                <div class="ui-line w-70"></div>
                                <div class="ui-line w-50"></div>
                                <div class="ui-row">
                                    <div class="ui-box"></div>
                                    <div class="ui-box"></div>
                                </div>
                            </div>
                         </div>
                         <div class="pro-ui-card card-2">
                            <div class="ui-icon-circle">
                                 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            </div>
                            <div class="ui-line w-100"></div>
                         </div>
                         
                         <!-- App Icon -->
                         <div class="pro-app-icon">
                             <img src="/images/docsera-pro-icon.webp" alt="DocSera Pro" loading="lazy" decoding="async" />
                         </div>

                         <!-- Glow Effect -->
                         <div class="pro-glow"></div>
                    </div>
                </div>
	</div>
	<div class="pv-help">
		<p><b>هل لديك استفسارات؟</b> لقد جمعنا لك إجابات مفصلة عن كل ما يخص DocSera في مكان واحد.</p>
		<a href="/help">تصفح الأسئلة الشائعة</a>
	</div>
</section>

<section class="fin" id="download" data-fin>
	<div class="fin-dawn" data-fin-dawn aria-hidden="true"></div>
	<div class="fin-sun" data-fin-sun aria-hidden="true"></div>
	<div class="fin-copy">
		<h2>ابدأ رحلتك الصحية اليوم</h2>
		<p>مستقبل الطب الرقمي، يبدأ في سوريا</p>
		<StoreBadges size="lg" adaptive />
		<div class="fin-more">
			<a href={WEB_APP_URL}>أو استخدمه من المتصفح دون تثبيت</a>
			<a href="/download">كل طرق التحميل</a>
		</div>
	</div>
	<div class="fin-rise" aria-hidden="true">
		<div class="fin-phone" data-fin-phone>
			<div class="fin-screen"><img src="/images/app110/guest-head-480.webp" srcset="/images/app110/guest-head-480.webp 480w, /images/app110/guest-head-640.webp 640w" sizes="(max-width: 899px) 62vw, 300px" alt="" width="640" height="422" loading="lazy" decoding="async" /></div>
		</div>
	</div>
	<svg class="fin-hill" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true"><path d="M0 130Q720 -70 1440 130V200H0z" /></svg>
</section>

<style>
	/* ── the desk and the scan of light ── */
	.cmp { position: relative; background: #062A30; color: #fff; }
	.cmp-stage { position: relative; padding: 64px 20px; }
	.cmp-desk, .cmp-line, .cmp-au { display: none; }
	.cmp-head { margin-bottom: 18px; }
	.cmp-head-old { opacity: .78; }
	.cmp-tag { display: inline-block; padding: 5px 14px; border-radius: 999px; font-size: .84rem; font-weight: 700; background: rgba(255, 255, 255, .12); color: #BFF2EE; }
	.cmp-ttl { margin: 10px 0 0; font-size: clamp(1.9rem, 4.2vw, 3.4rem); line-height: 1.22; font-weight: 800; color: inherit; }
	.cmp-list { list-style: none; margin: 0 auto; padding: 0; max-width: 620px; }
	.cmp-pair { margin-bottom: 10px; }
	.cmp-face { display: flex; align-items: center; gap: 12px; }
	.cmp-face svg { width: 22px; height: 22px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
	.cmp-old { padding: 6px 2px; color: #A9C3C4; font-size: .9rem; text-decoration: line-through; }
	.cmp-old em { display: none; }
	.cmp-new { padding: 10px 12px; border-radius: 16px; background: rgba(255, 255, 255, .08); }
	.cmp-new i { width: 40px; height: 40px; flex: none; display: grid; place-items: center; border-radius: 12px; background: rgba(127, 243, 230, .16); color: #7FF3E6; }
	.cmp-new b { display: block; font-size: 1.08rem; font-weight: 800; line-height: 1.35; }
	.cmp-new small { display: block; font-size: .88rem; line-height: 1.4; color: #BFD9D9; }

	:global(html.story) .cmp { height: 250vh; height: 250svh; background: #fff; }
	:global(html.story) .cmp-stage { position: sticky; top: 0; height: 100vh; height: 100lvh; padding: 0; overflow: hidden; background: #CBD3D0; color: #1D2A2B; }
	:global(html.story) .cmp-desk { display: block; position: absolute; inset: 0; background: repeating-linear-gradient(97deg, rgba(255, 255, 255, .09) 0 2px, transparent 2px 9px), radial-gradient(90% 70% at 60% 40%, #D9DFDC, #BAC4C1); }
	.cmp-junk { position: absolute; display: block; background: #F6F5F0; box-shadow: 0 10px 22px -10px rgba(30, 40, 40, .55); background-image: repeating-linear-gradient(0deg, transparent 0 13px, rgba(60, 80, 90, .16) 13px 14px); }
	.j1 { width: 230px; height: 300px; top: 8%; left: -40px; rotate: -14deg; }
	.j2 { width: 210px; height: 280px; bottom: -40px; left: 16%; rotate: 11deg; }
	.j3 { width: 180px; height: 240px; top: -30px; left: 38%; rotate: 8deg; }
	.j4 { width: 240px; height: 320px; bottom: -70px; right: -30px; rotate: -9deg; background-color: #E9E3D6; }
	.j5 { width: 150px; height: 190px; top: 18%; right: 34%; rotate: -21deg; background-color: #20292E; background-image: radial-gradient(45% 55% at 50% 45%, rgba(255, 255, 255, .55), transparent 75%); }

	:global(html.story) .cmp-night { position: absolute; inset: 0; overflow: hidden; z-index: 1; will-change: transform; color: #fff; }
	:global(html.story) .cmp-night-in { position: absolute; inset: 0; will-change: transform; background: radial-gradient(70% 55% at 22% 18%, #0E7C7E 0%, rgba(14, 124, 126, 0) 70%), radial-gradient(60% 50% at 88% 90%, #0B5D62 0%, rgba(11, 93, 98, 0) 72%), #062A30; }
	:global(html.story) .cmp-au { display: block; position: absolute; width: 70vmax; height: 70vmax; top: -30vmax; right: -18vmax; border-radius: 50%; background: radial-gradient(closest-side, rgba(0, 196, 190, .2), rgba(0, 196, 190, 0)); }
	:global(html.story) .cmp-head { position: absolute; z-index: 1; margin: 0; inset-inline-start: max(5vw, calc(50vw - 590px)); top: 50%; translate: 0 -50%; width: min(38vw, 470px); }
	:global(html.story) .cmp-head-old { opacity: 1; }
	:global(html.story) .cmp-head-old .cmp-tag { background: rgba(29, 42, 43, .12); color: #33413F; }
	:global(html.story) .cmp-list { position: absolute; z-index: 2; margin: 0; max-width: none; inset-inline-end: max(5vw, calc(50vw - 590px)); top: 50%; translate: 0 -50%; width: min(47vw, 580px); }
	:global(html.story) .cmp-pair { height: clamp(58px, 9.4vh, 84px); margin-bottom: clamp(7px, 1.3vh, 12px); }
	:global(html.story) .cmp-pair:last-child { margin-bottom: 0; }
	:global(html.story) .cmp-card { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; -webkit-transform-style: preserve-3d; will-change: transform; }
	:global(html.story) .cmp-face { position: absolute; inset: 0; padding: 0 16px; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
	:global(html.story) .cmp-old { color: #2A2C28; font-size: clamp(.9rem, 1.25vw, 1.06rem); font-weight: 700; text-decoration: none; box-shadow: 0 12px 20px -10px rgba(25, 35, 35, .6); }
	:global(html.story) .cmp-old em { display: block; margin-inline-start: auto; font-style: normal; font-size: 1.5rem; font-weight: 800; color: #B5412F; }
	:global(html.story) .k-sticky { background: linear-gradient(135deg, #F8E784 0 86%, #E4CF62 86.2%); }
	:global(html.story) .k-rx { background: #FFFEFA; border-top: 5px solid #D55B50; }
	:global(html.story) .k-ticket { background: #F6D9CF; border-inline-end: 2px dashed rgba(150, 60, 40, .45); }
	:global(html.story) .k-folder { background: #D8BD91; border-radius: 3px 10px 3px 3px; }
	:global(html.story) .k-index { background: #DDE9F3; background-image: repeating-linear-gradient(0deg, transparent 0 15px, rgba(70, 110, 150, .22) 15px 16px); }
	:global(html.story) .cmp-new { transform: rotateX(180deg); padding: 0 14px; background: #0D4148; border: 1px solid rgba(127, 243, 230, .24); color: #fff; box-shadow: 0 14px 26px -16px rgba(0, 0, 0, .8); }

	:global(html.story) .cmp-line { display: block; position: absolute; z-index: 4; inset-inline: 0; top: 0; height: 2px; will-change: transform;
		background: linear-gradient(90deg, rgba(127, 243, 230, 0), #7FF3E6 14%, #fff 50%, #7FF3E6 86%, rgba(127, 243, 230, 0)); box-shadow: 0 0 26px 6px rgba(64, 224, 208, .6); }
	.cmp-grip { position: absolute; inset-inline-end: max(14px, calc(50vw - 640px)); top: -23px; width: 46px; height: 46px; padding: 0; display: grid; place-items: center; border: 0; border-radius: 50%; background: #fff; cursor: grab; touch-action: none; box-shadow: 0 6px 20px rgba(0, 60, 62, .45), 0 0 0 5px rgba(127, 243, 230, .3); }
	.cmp-grip:active { cursor: grabbing; }
	.cmp-grip:focus-visible { outline: 3px solid #0F1A22; outline-offset: 3px; }
	.cmp-grip img { display: block; width: 24px; height: 24px; }
	.cmp-hint { position: absolute; inset-inline-end: calc(max(14px, calc(50vw - 640px)) + 56px); top: -13px; padding: 3px 11px; border-radius: 999px; font-size: .78rem; font-weight: 700; white-space: nowrap; background: #0F1A22; color: #fff; }

	/* ── the clinic side ── */
	.pv { position: relative; overflow: hidden; background: #062A30; color: #fff; padding: clamp(70px, 11vh, 120px) 20px 0; }
	.pv::before { content: ''; position: absolute; width: 62vmax; height: 62vmax; top: -8vmax; left: -14vmax; border-radius: 50%; background: radial-gradient(closest-side, rgba(0, 196, 190, .17), rgba(0, 196, 190, 0)); pointer-events: none; }
	.pv-wrap { position: relative; max-width: 1180px; margin: 0 auto; }
    .pro-glass-card {
        background: #0f1515; /* Very Dark Teal/Black */
        background-image: radial-gradient(circle at top right, #1a2a2a, #0f1515);
        border-radius: 30px;
        padding: 60px;
        position: relative;
        overflow: hidden;
        color: white;
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.1);
        
        /* Desktop Grid Layout */
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-areas: 
            "content visual"
            "action visual";
        gap: 40px;
        align-items: center;
    }
    
    /* Grid Areas */
    .pro-content { grid-area: content; z-index: 2; position: relative; }
    .pro-action { grid-area: action; z-index: 2; position: relative; align-self: start; }
    .pro-visual { 
        grid-area: visual; 
        height: 100%; 
        min-height: 300px; 
        position: relative; 
        display: flex; 
        align-items: center; 
        justify-content: center;
    }
    
    .pro-badge {
        display: inline-block;
        background: rgba(0, 144, 146, 0.2);
        color: #00E0E3;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 20px;
        border: 1px solid rgba(0, 144, 146, 0.3);
    }
    
    .pro-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 20px;
        line-height: 1.2;
        background: linear-gradient(to right, #fff, #bcecec);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .pro-desc {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.7);
        margin: 0;
        line-height: 1.7;
        max-width: 500px;
    }
    .pro-desc strong { color: white; }
    
    .btn-pro {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(0, 144, 146, 0.8); /* Glassy Main Color */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        padding: 16px 32px;
        border-radius: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px -5px rgba(0, 144, 146, 0.4);
    }
    .btn-pro:hover {
        background: rgba(0, 144, 146, 0.95);
        border-color: rgba(255, 255, 255, 0.4);
        box-shadow: 0 0 30px rgba(0, 224, 227, 0.4);
        transform: translateY(-2px);
    }
    .btn-pro svg { width: 20px; height: 20px; }
    
    /* Visual Cards (Abstract) */
    .pro-ui-card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        position: absolute;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .card-1 {
        width: 260px; height: 180px;
        z-index: 2;
        padding: 15px;
        top: 40px; right: 40px;
        transform: rotate(-5deg);
        animation: floatPro 6s ease-in-out infinite;
    }
    .card-2 {
        width: 180px; height: 120px;
        z-index: 3;
        bottom: 30px; left: 40px;
        background: rgba(30,30,30,0.6);
        padding: 15px;
        transform: rotate(5deg);
        animation: floatPro 6s ease-in-out infinite 1s; /* delay */
    }
    
    /* UI Internal Deco */
    .ui-header { display: flex; gap: 6px; margin-bottom: 15px; }
    .ui-dot { width: 8px; height: 8px; border-radius: 50%; opacity: 0.5; }
    .ui-dot.red { background: #ff5f56; }
    .ui-dot.yellow { background: #ffbd2e; }
    .ui-dot.green { background: #27c93f; }
    .ui-body { display: flex; flex-direction: column; gap: 10px; }
    .ui-line { height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; }
    .w-70 { width: 70%; } .w-50 { width: 50%; } .w-100 { width: 100%; }
    .ui-row { display: flex; gap: 10px; margin-top: 10px; }
    .ui-box { width: 40px; height: 40px; background: rgba(255,255,255,0.05); border-radius: 8px; }
    .ui-icon-circle { 
        width: 40px; height: 40px; 
        background: rgba(0, 144, 146, 0.2); 
        border-radius: 50%; 
        display: flex; align-items: center; justify-content: center;
        color: #00E0E3;
        margin-bottom: 15px;
    }
    .ui-icon-circle svg { width: 20px; height: 20px; }

    .pro-app-icon {
        position: absolute;
        width: 70px; height: 70px;
        z-index: 10;
        bottom: 40px; right: 40px; /* Moved to Bottom Right to balance Card 2 (BL) and Card 1 (TR) */
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
        animation: floatIcon 6s ease-in-out infinite;
        border: 1px solid rgba(255,255,255,0.1);
        overflow: hidden;
    }
    .pro-app-icon img { width: 100%; height: 100%; object-fit: cover; }

    .pro-glow {
        position: absolute;
